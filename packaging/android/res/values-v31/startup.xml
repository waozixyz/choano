<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 always shows a splash; keep it Choano's colour, without
         the launcher icon. -->
    <style name="ChoanoTheme" parent="android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/startup_background</item>
        <item name="android:windowSplashScreenBackground">@color/startup_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
