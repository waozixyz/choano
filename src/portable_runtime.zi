host_api :: #system_library "host_api";
AppServiceHost :: (name: string, request: string) -> string #foreign host_api;
AppKeyHost :: () -> s32 #foreign host_api;
frame_now: float64;
frame_key: s32;
Milliseconds :: () -> s64 { return cast(s64)(frame_now * 1000.0) }
Service :: (name: string, request: string) -> string { return AppServiceHost(name, request) }

CaptureKey :: () { frame_key = AppKeyHost() }
PressedKey :: () -> s32 { return frame_key }
