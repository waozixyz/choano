// Standalone owner; hosted Apps instances supply their own owner and reader.
#import "kryon/media_audio_host"
#import "kryon/session"
#import "kryon/app_asset"
#if #defined(PLATFORM_WEB) {
    #import "kryon/media_audio_web"
} else {
    #import "kryon/media_audio_desktop"
    Sink :: #import "std/audio_sink";
}
Paths :: #import "sound_paths";
#import "std/format"
owner: MediaAudioOwner;
AudioAsset :: (path: string) -> bool {
    if path == Paths.SHARK_MUSIC { return true }
    for event: cast(s32)1..6 {
        text: Vec(u8)
        BuilderPrint(*text, "assets/choano/audio/%.wav", Paths.SoundPath(event))
        if path == BuilderFinish(text) { return true }
    }
    return false
}
asset_bytes: string;
AudioRead :: (context: *void, path: string) -> string {
    unused context
    FreeAppAsset(asset_bytes)
    asset_bytes = ReadAppAsset(path)
    return asset_bytes
}
AudioBegin :: (session: Session) { MediaAudioBegin(*owner, session, AudioAsset, AudioRead, null) }
AudioEnd :: () {
    MediaAudioEnd()
    FreeAppAsset(asset_bytes)
    asset_bytes = ""
}
audio_opened: bool;
AudioOpen :: () {
    if audio_opened { return }
    #if #defined(PLATFORM_WEB) {
        MediaAudioUseWeb()
    } else {
        MediaAudioUseDesktop()
    }
    audio_opened = true
}
AudioClose :: () {
    MediaAudioOwnerClose(*owner)
    #if !#defined(PLATFORM_WEB) {
        Sink.AudioSinkClose()
    }
    audio_opened = false
}
