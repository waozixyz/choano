#import "std/text_buffer"
#if #defined(CHOANO_PORTABLE) {
    host_api :: #system_library "host_api";
    AppRecordHost :: (name: string) -> string #foreign host_api;
    SaveAppRecordHost :: (name: string, text: string) -> bool #foreign host_api;
    Read :: () -> string { return AppRecordHost("choano.preferences") }
    Write :: (value: string) -> bool { return SaveAppRecordHost("choano.preferences", value) }
} else #if #defined(ANDROID_BUILD) {
    // The APK's assets are read-only; settings live in the app's private
    // files folder, which Android creates.
    #import "std/file"
    #import "std/format"
    #import "kryon/android_jni"
    private_directory: [4096]u8;
    Path :: () -> string {
        out: Vec(u8)
        BuilderPrint(*out, "%/preferences.v1", AndroidPrivateDataPath(private_directory[:]))
        return BuilderFinish(out)
    }
    Read :: () -> string { text, found := ReadEntireFile(Path()); return ifx found then text else "" }
    Write :: (value: string) -> bool { return WriteEntireFile(Path(), value) }
} else #if #defined(_WIN32) {
    // The installed program folder is read-only to the game; settings live in
    // the player's Local AppData, with forward slashes as std/file takes them.
    #import "std/file"
    #import "std/environment_linux"
    #import "std/format"
    Root :: () -> string {
        value := EnvironmentText("CHOANO_DATA")
        if value != "" { return value }
        base := EnvironmentText("LOCALAPPDATA")
        if base == "" { base = EnvironmentText("APPDATA") }
        out: Vec(u8)
        for byte: base {
            unused VecPush(out, ifx byte == cast(u8)92 then cast(u8)47 else byte)
        }
        BuilderPrint(*out, "%", "/Choano")
        return BuilderFinish(out)
    }
    Path :: () -> string {
        out: Vec(u8)
        BuilderPrint(*out, "%/preferences.v1", Root())
        return BuilderFinish(out)
    }
    Read :: () -> string { text, found := ReadEntireFile(Path()); return ifx found then text else "" }
    Write :: (value: string) -> bool { return CreateDirectory(Root()) && WriteEntireFile(Path(), value) }
} else {
    #import "std/file"
    #import "std/file_tree_linux"
    #import "std/environment_linux"
    #import "std/format"
    Root :: () -> string {
        #if #defined(PLATFORM_WEB) {
            return "/kryon-apps/choano"
        }
        value := EnvironmentText("CHOANO_DATA")
        if value != "" { return value }
        base := EnvironmentText("XDG_DATA_HOME")
        if base == "" {
            out: Vec(u8)
            BuilderPrint(*out, "%/.local/share", EnvironmentText("HOME"))
            base = BuilderFinish(out)
        }
        out: Vec(u8)
        BuilderPrint(*out, "%/choano", base)
        return BuilderFinish(out)
    }
    Path :: () -> string {
        out: Vec(u8)
        BuilderPrint(*out, "%/preferences.v1", Root())
        return BuilderFinish(out)
    }
    Read :: () -> string { text, found := ReadEntireFile(Path()); return ifx found then text else "" }
    Write :: (value: string) -> bool { return CreateDirectories(Root()) && WriteEntireFile(Path(), value) }
}
Preferences :: struct {
    chosen: bool
    pad: bool
    muted: bool
    // Reaching full size unlocks Fish mode; fish is the mode last picked.
    fish_unlocked: bool
    fish: bool
}
// "1", the controls (s, p or u for unchosen), sound muted, then Fish mode
// unlocked and picked; three-character files predate Fish mode.
Load :: () -> Preferences {
    text := Read()
    value: Preferences
    if (text.count != 3 && text.count != 5) || text[0] != #char "1" ||
        (text[1] != #char "s" && text[1] != #char "p" && text[1] != #char "u") { return value }
    for index: 2..text.count - 1 {
        if text[index] != #char "0" && text[index] != #char "1" { return value }
    }
    value.chosen = text[1] != #char "u"
    value.pad = text[1] == #char "p"
    value.muted = text[2] == #char "1"
    if text.count == 5 {
        value.fish_unlocked = text[3] == #char "1"
        value.fish = value.fish_unlocked && text[4] == #char "1"
    }
    return value
}
Save :: (value: Preferences) -> bool {
    text: [6]u8 = .[#char "1", #char "u", #char "0", #char "0", #char "0", cast(u8)0]
    if value.chosen { text[1] = ifx value.pad then #char "p" else #char "s" }
    if value.muted { text[2] = #char "1" }
    if value.fish_unlocked { text[3] = #char "1" }
    if value.fish_unlocked && value.fish { text[4] = #char "1" }
    return Write(TextUntilNul(text[:]))
}
