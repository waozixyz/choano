#import "std/web"
Paths :: #import "sound_paths";
#import "std/format"
SoundPlayEvent :: (event: s32) -> bool {
    if sound_muted { return false }
    name := Paths.SoundPath(event)
    if name == "" { return false }
    path: Vec(u8)
    BuilderPrint(*path, "assets/choano/audio/%.wav", name)
    unused WebCall1(WebModule, WebName("playSound"), WebText(BuilderFinish(path)))
    return true
}

music_on: bool;
SoundMusic :: (on: bool) {
    if on == music_on { return }
    music_on = on
    unused WebCall1(WebModule, WebName("music"), WebBool(on))
}

sound_muted: bool;
SoundSetMuted :: (value: bool) { sound_muted = value; unused WebCall1(WebModule, WebName("setMuted"), WebBool(value)) }
