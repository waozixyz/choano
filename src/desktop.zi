Audio :: #import "audio_host";
DesktopLoop :: #import "kryon/desktop_loop";
Timer :: #import "std/timer_linux";
#import "app"
#import "kryon/geometry"
#import "kryon/input_protocol"
#import "kryon/session"
#import "kryon/tree"
#import "kryon/tree_input"
#import "kryon/Frame"
#import "kryon/frame_snapshot"
#import "kryon/tree_frame"

#program_export
ClockMillisecondsHost :: () -> s64 { return Timer.MonotonicMilliseconds() }

DrawGameFrame :: (session: Session, viewport: Rectangle) -> s32 {
    Audio.AudioBegin(session)
    defer { Audio.AudioEnd() }
    return Frame(session, viewport)
}

#program_export
main :: () -> s32 {
    if !DesktopLoop.DesktopStartBeside("assets/choano/background-inside.avif") { return 1 }
    unused TreeFrameUse()
    Audio.AudioOpen()
    defer { Audio.AudioClose() }
    defer { CloseAccount() }
    return DesktopLoop.RunTitled(DrawGameFrame, 900, 680, "Choano")
}
