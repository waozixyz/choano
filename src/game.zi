Math :: #import "std/math";

FIELD_WIDTH :: 500.0;
FIELD_HEIGHT :: 420.0;
DISH_CENTER_X :: 245.0;
DISH_CENTER_Y :: 209.0;
DISH_RADIUS :: 208.0;
STAGE_FIRST :: 1;
STAGE_LAST :: 10;
PLAYER_STAGE_LAST :: 9;
ENEMY_LIMIT :: 64;
INITIAL_ENEMIES :: 6;
// The amoeba dish and, once a player reaches full size there, the open sea.
MODE_AMOEBA :: 0;
MODE_FISH :: 1;
// Fish mode: open water above the sand, swifter and floatier fish, a dash
// with a cooldown, a moment's safety after a bite, stinging jellyfish and
// drifting golden pearls.
SEA_TOP :: 24.0;
SEA_BOTTOM :: 372.0;
FISH_SPEED :: 125.0;
FISH_EASE :: 5.0;
DASH_BOOST :: 2.2;
DASH_SECONDS :: .35;
DASH_COOLDOWN :: 1.2;
SAFE_SECONDS :: 2.0;
FISH_START :: 5;
FISH_MOST :: 14;
JELLY_STAGE :: 3;
JELLY_MOST :: 2;
PEARL_SCORE :: 25;
KIND_FISH :: 0;
KIND_JELLY :: 1;
KIND_PEARL :: 2;
KIND_SHARK :: 3;
KIND_SARDINE :: 4;
// Seahorses bob through the water, lobsters crawl over the sand and
// starfish drift just above it; like fish, smaller ones are food and bigger
// ones bite. One arrives soon after the start, then one every few seconds.
KIND_SEAHORSE :: 5;
KIND_LOBSTER :: 6;
KIND_STARFISH :: 7;
ANIMAL_FIRST :: 2.5;
ANIMAL_MOST :: 3;
// Seahorses are never small: they come at stage five or above and stand
// upright, taller than their stage's square and narrower.
SEAHORSE_STAGE :: 5;
SEAHORSE_HEIGHT :: 1.3;
SEAHORSE_WIDTH :: .8;
// Now and then a big gentle sea turtle swims slowly across. It neither bites
// nor can be eaten, and leaves a short trail of golden pearls.
KIND_TURTLE :: 8;
TURTLE_FIRST :: 35.0;
TURTLE_WIDTH :: 110.0;
TURTLE_HEIGHT :: 61.0;
TURTLE_SPEED :: 26.0;
TURTLE_PEARLS :: 5;
TURTLE_DROP :: 1.5;
// Regular fish wear one of eight looks, whatever their size.
FISH_SPECIES :: 8;
// Now and then a shark hunts: tense music starts first, then it sweeps
// across, swallowing fish in its way.
SHARK_FIRST :: 18.0;
SHARK_WARNING :: 2.5;
SHARK_LENGTH :: 150.0;
SHARK_SPEED :: 165.0;
SHARK_TURN :: 38.0;
SHARK_SCORE :: 50;
// A school of sardines darts past; eating quickly builds a frenzy.
SCHOOL_SIZE :: 7;
SARDINE_SIZE :: 9.0;
SARDINE_SCORE :: 5;
FRENZY_SECONDS :: 1.5;
FRENZY_MOST :: 8;
PLAYER_SPEED :: 100.0;
TOUCH_COAST_TIME :: 0.35;
// How quickly the player's velocity eases towards its heading, per second.
PLAYER_EASE :: 8.0;
ENEMY_SPEED_SCALE :: 90.0;
COLLISION_INSET :: 3.0;

SOUND_NONE :: 0;
SOUND_START :: 1;
SOUND_EAT :: 2;
SOUND_GROW :: 3;
SOUND_EXTRA_LIFE :: 4;
SOUND_LOSE_LIFE :: 5;
SOUND_GAME_OVER :: 6;

Enemy :: struct {
    x: float32
    y: float32
    stage: s32
    velocity_x: float32
    velocity_y: float32
    active: bool
    warning_timer: float64
    animation: float64
    kind: s32
    phase: float32
    species: s32
}

GameInput :: struct {
    left: bool
    right: bool
    up: bool
    down: bool
    // Fish mode: a dash starts this frame, if it is ready.
    dash: bool
    // A touch heading in any direction, up to unit length; keys win.
    steer_x: float32
    steer_y: float32
}

Game :: struct {
    mode: s32
    started: bool
    over: bool
    player_x: float32
    player_y: float32
    player_stage: s32
    player_facing: s32
    player_animation: float64
    player_moving: bool
    player_velocity_x: float32
    player_velocity_y: float32
    coast_deceleration: float32
    // Set once a run reaches full size; the app takes it to award it.
    full_size: bool
    dash_timer: float64
    dash_cooldown: float64
    safe_timer: float64
    jelly_timer: float64
    pearl_timer: float64
    shark_timer: float64
    shark_warning: float64
    shark_y: float32
    shark_leftward: bool
    shark_bit: bool
    school_timer: float64
    animal_timer: float64
    animal_next: s32
    turtle_timer: float64
    turtle_drop: float64
    turtle_pearls: s32
    fish_species: s32
    frenzy: s32
    frenzy_timer: float64
    growth_progress: s32
    next_growth_threshold: s32
    growth_stages: s32
    score: s32
    lives: s32
    next_spawn_timer: float64
    elapsed: float64
    enemy_count: s32
    enemies: [ENEMY_LIMIT]Enemy
    random: u32
    event_count: s32
    events: [8]s32
}

// StartGame initializes every run, including the portable VM instance.
game: Game;

StageSize :: (index: s32) -> s32 { return index * 4 + 7 }

GrowthThreshold :: (stage: s32) -> s32 {
    thresholds: [10]s32 = .[0, 14, 44, 96, 168, 256, 416, 661, 981, 1386]
    if stage < STAGE_FIRST { return thresholds[STAGE_FIRST] }
    if stage > PLAYER_STAGE_LAST { return thresholds[PLAYER_STAGE_LAST] }
    return thresholds[stage]
}

RandomNext :: (limit: s32) -> u32 {
    game.random = game.random ^ (game.random << 13)
    game.random = game.random ^ (game.random >> 17)
    game.random = game.random ^ (game.random << 5)
    if limit <= 0 { return 0 }
    return game.random % cast(u32)limit
}

QueueSound :: (event: s32) {
    if event == SOUND_NONE || game.event_count >= cast(s32)8 { return }
    game.events[game.event_count] = event
    game.event_count += 1
}

DirectionX :: (direction: s32) -> float32 {
    if direction == 0 { return -1.0 }
    if direction == 2 { return 1.0 }
    return 0.0
}

DirectionY :: (direction: s32) -> float32 {
    if direction == 1 { return -1.0 }
    if direction == 3 { return 1.0 }
    return 0.0
}

DistanceSquared :: (first_x: float32, first_y: float32, second_x: float32, second_y: float32) -> float32 {
    delta_x := first_x - second_x
    delta_y := first_y - second_y
    return delta_x * delta_x + delta_y * delta_y
}

ClampPoint :: (x: *float32, y: *float32, size: float32) -> bool {
    delta_x := <<x - cast(float32)DISH_CENTER_X
    delta_y := <<y - cast(float32)DISH_CENTER_Y
    distance_squared := delta_x * delta_x + delta_y * delta_y
    maximum := DISH_RADIUS - size * .5
    if maximum <= 0.0 || distance_squared <= maximum * maximum { return false }
    distance := cast(float32)Math.Sqrt(cast(float64)distance_squared)
    if distance <= 0.0 { return true }
    <<x = cast(float32)DISH_CENTER_X + delta_x * maximum / distance
    <<y = cast(float32)DISH_CENTER_Y + delta_y * maximum / distance
    return true
}

RandomSpeed :: () -> float32 {
    speed := cast(float32)RandomNext(50) * .01
    if RandomNext(2) == 0 { speed = -speed }
    return speed
}

EdibleCount :: () -> s32 {
    count: s32 = 0
    for index: cast(s32)0..game.enemy_count - 1 {
        if game.enemies[index].kind == KIND_FISH && game.enemies[index].stage <= game.player_stage { count += 1 }
    }
    return count
}

StageForPopulation :: (edible_count: s32, enemy_count: s32) -> s32 {
    minimum := (game.player_stage * 2 + 4) / 4
    if edible_count < minimum || edible_count < enemy_count * 3 / 4 {
        return cast(s32)RandomNext(game.player_stage) + 1
    }
    dangerous := game.player_stage + 1
    if dangerous > STAGE_LAST { dangerous = STAGE_LAST }
    return dangerous
}

CanPlaceEnemy :: (x: float32, y: float32, size: float32) -> bool {
    player_size := cast(float32)StageSize(game.player_stage)
    clear := size * .5 + player_size * .5 + 4.0
    if DistanceSquared(x, y, game.player_x, game.player_y) < clear * clear { return false }
    for index: cast(s32)0..game.enemy_count - 1 {
        other_size := cast(float32)StageSize(game.enemies[index].stage)
        other_clear := size * .5 + other_size * .5 + 2.0
        if DistanceSquared(x, y, game.enemies[index].x, game.enemies[index].y) < other_clear * other_clear { return false }
    }
    return true
}

SpawnEnemy :: (forced_stage: s32) -> bool {
    if game.enemy_count >= ENEMY_LIMIT { return false }
    stage := forced_stage
    if stage < STAGE_FIRST { stage = StageForPopulation(EdibleCount(), game.enemy_count) }
    if stage > STAGE_LAST { stage = STAGE_LAST }
    size := cast(float32)StageSize(stage)
    maximum := cast(float32)DISH_RADIUS - size * .5
    attempt: s32 = 0
    x := cast(float32)DISH_CENTER_X
    y := cast(float32)DISH_CENTER_Y
    placed := false
    while attempt < 64 && !placed {
        x = cast(float32)DISH_CENTER_X + cast(float32)RandomNext(cast(s32)(maximum * 2.0)) - maximum
        y = cast(float32)DISH_CENTER_Y + cast(float32)RandomNext(cast(s32)(maximum * 2.0)) - maximum
        placed = DistanceSquared(x, y, cast(float32)DISH_CENTER_X, cast(float32)DISH_CENTER_Y) <= maximum * maximum && CanPlaceEnemy(x, y, size)
        attempt += 1
    }
    if !placed { return false }
    game.enemies[game.enemy_count] = .{
        .x = x,
        .y = y,
        .stage = stage,
        .velocity_x = RandomSpeed(),
        .velocity_y = RandomSpeed(),
        .active = false,
        .warning_timer = 3.0 + cast(float64)RandomNext(4000) / 1000.0,
        .animation = cast(float64)RandomNext(100) / 100.0
    }
    game.enemy_count += 1
    return true
}

StartGame :: (seed: u32, mode: s32 = MODE_AMOEBA) {
    game = .{
        .mode = mode,
        .player_x = DISH_CENTER_X,
        .player_y = DISH_CENTER_Y,
        .player_stage = STAGE_FIRST,
        .next_growth_threshold = 14,
        .lives = 2,
        .next_spawn_timer = 5.0,
        .random = seed
    }
    game.started = true
    if game.random == 0 { game.random = 1 }
    game.next_spawn_timer = 5.0 + cast(float64)RandomNext(4000) / 1000.0
    if mode == MODE_FISH {
        game.jelly_timer = 14.0
        game.pearl_timer = 8.0
        game.shark_timer = SHARK_FIRST
        game.school_timer = 10.0
        game.animal_timer = ANIMAL_FIRST
        game.animal_next = KIND_SEAHORSE
        game.turtle_timer = TURTLE_FIRST
        game.fish_species = cast(s32)RandomNext(FISH_SPECIES)
        while game.enemy_count < FISH_START { unused SpawnFish(STAGE_FIRST, true) }
    } else {
        while game.enemy_count < INITIAL_ENEMIES { unused SpawnEnemy(STAGE_FIRST) }
    }
    game.event_count = 0
    QueueSound(SOUND_START)
}

RemoveEnemy :: (index: s32) {
    if index < 0 || index >= game.enemy_count { return }
    for move: index..game.enemy_count - 2 {
        game.enemies[move] = game.enemies[move + 1]
    }
    game.enemy_count -= 1
}

GrowPlayer :: () {
    if game.growth_progress < game.next_growth_threshold { return }
    if game.player_stage < PLAYER_STAGE_LAST {
        game.player_stage += 1
        game.next_growth_threshold = GrowthThreshold(game.player_stage)
        if game.player_stage == PLAYER_STAGE_LAST { game.full_size = true }
    } else {
        game.next_growth_threshold = game.next_growth_threshold * 3 / 2
    }
    game.growth_stages += 1
    QueueSound(SOUND_GROW)
    if game.growth_stages % 3 == 0 {
        game.lives += 1
        QueueSound(SOUND_EXTRA_LIFE)
    }
}

MovePlayer :: (input: GameInput, delta: float64) {
    target_x := DirectionX(ifx input.left then 0 else ifx input.right then 2 else -1)
    target_y := DirectionY(ifx input.up then 1 else ifx input.down then 3 else -1)
    if target_x != 0.0 && target_y != 0.0 { target_x *= .70710678; target_y *= .70710678 }
    if target_x == 0.0 && target_y == 0.0 {
        target_x = input.steer_x
        target_y = input.steer_y
        length := cast(float32)Math.Sqrt(cast(float64)(target_x * target_x + target_y * target_y))
        if length > 1.0 { target_x /= length; target_y /= length }
    }
    keyed := input.left || input.right || input.up || input.down
    // Keys ease the velocity towards their heading, so the amoeba glides.
    fish := game.mode == MODE_FISH
    speed: float32 = ifx fish then FISH_SPEED else PLAYER_SPEED
    if fish && input.dash && game.dash_cooldown <= 0.0 {
        game.dash_timer = DASH_SECONDS
        game.dash_cooldown = DASH_COOLDOWN
        if target_x == 0.0 && target_y == 0.0 {
            // A dash from rest darts the way the fish faces.
            target_x = ifx game.player_facing == 0 then -1.0 else 1.0
        }
        game.player_velocity_x = target_x * speed * DASH_BOOST
        game.player_velocity_y = target_y * speed * DASH_BOOST
    }
    if game.dash_timer > 0.0 { speed *= DASH_BOOST }
    ease := cast(float32)delta * (ifx fish then FISH_EASE else PLAYER_EASE)
    if ease > 1.0 { ease = 1.0 }
    heading := cast(float32)Math.Sqrt(cast(float64)(target_x * target_x + target_y * target_y))
    if !keyed && heading > 0.0 {
        // A held touch turns at once and eases only its speed, so the
        // player goes where the finger points instead of drifting sideways.
        game.coast_deceleration = 0.0
        current := cast(float32)Math.Sqrt(cast(float64)(game.player_velocity_x * game.player_velocity_x +
            game.player_velocity_y * game.player_velocity_y))
        current += (heading * speed - current) * ease
        game.player_velocity_x = target_x / heading * current
        game.player_velocity_y = target_y / heading * current
    } else if !keyed {
        current := cast(float32)Math.Sqrt(cast(float64)(game.player_velocity_x * game.player_velocity_x +
            game.player_velocity_y * game.player_velocity_y))
        if current > 0.0 && game.coast_deceleration == 0.0 {
            game.coast_deceleration = current / cast(float32)TOUCH_COAST_TIME
        }
        if game.coast_deceleration > 0.0 {
            slowed := current - game.coast_deceleration * cast(float32)delta
            if slowed <= 0.0 {
                game.player_velocity_x = 0.0
                game.player_velocity_y = 0.0
                game.coast_deceleration = 0.0
            } else {
                game.player_velocity_x *= slowed / current
                game.player_velocity_y *= slowed / current
            }
        }
    } else {
        game.coast_deceleration = 0.0
        game.player_velocity_x += (target_x * speed - game.player_velocity_x) * ease
        game.player_velocity_y += (target_y * speed - game.player_velocity_y) * ease
    }
    game.player_x += game.player_velocity_x * cast(float32)delta
    game.player_y += game.player_velocity_y * cast(float32)delta
    if game.player_velocity_x < -8.0 { game.player_facing = 0 }
    if game.player_velocity_x > 8.0 { game.player_facing = 1 }
    size := cast(float32)StageSize(game.player_stage)
    if fish { unused SeaClamp(*game.player_x, *game.player_y, size) }
    else { unused ClampPoint(*game.player_x, *game.player_y, size) }
    game.player_moving = game.player_velocity_x * game.player_velocity_x +
        game.player_velocity_y * game.player_velocity_y > 25.0
    game.player_animation += delta
}

MoveEnemy :: (index: s32, delta: float64) {
    enemy := *game.enemies[index]
    enemy.animation += delta
    if !enemy.active {
        enemy.warning_timer -= delta
        if enemy.warning_timer <= 0.0 {
            enemy.active = true
        }
        return
    }
    if RandomNext(100) == 0 {
        enemy.velocity_x = RandomSpeed()
        enemy.velocity_y = RandomSpeed()
    }
    enemy.x += enemy.velocity_x * ENEMY_SPEED_SCALE * cast(float32)delta
    enemy.y += enemy.velocity_y * ENEMY_SPEED_SCALE * cast(float32)delta
    size := cast(float32)StageSize(enemy.stage)
    if ClampPoint(*enemy.x, *enemy.y, size) {
        enemy.velocity_x = -enemy.velocity_x
        enemy.velocity_y = -enemy.velocity_y
    }
}

RectanglesOverlap :: (first_left: float32, first_right: float32, first_top: float32, first_bottom: float32,
    second_left: float32, second_right: float32, second_top: float32, second_bottom: float32) -> bool {
    return first_left <= second_right && second_left <= first_right &&
        first_top <= second_bottom && second_top <= first_bottom
}

ResolveCollisions :: () {
    player_size := cast(float32)StageSize(game.player_stage)
    player_left := game.player_x - player_size * .5
    player_right := game.player_x + player_size * .5
    player_top := game.player_y - player_size * .5
    player_bottom := game.player_y + player_size * .5
    index: s32 = 0
    while index < game.enemy_count {
        enemy := game.enemies[index]
        if !enemy.active { index += 1; continue }
        enemy_size := cast(float32)StageSize(enemy.stage)
        inset := enemy_size * .5 - COLLISION_INSET
        if inset < 0.0 { inset = 0.0 }
        overlap := RectanglesOverlap(player_left, player_right, player_top, player_bottom,
            enemy.x - inset, enemy.x + inset, enemy.y - inset, enemy.y + inset)
        if !overlap { index += 1; continue }
        if enemy.stage <= game.player_stage {
            edible_before := EdibleCount()
            enemy_count_before := game.enemy_count
            game.score += enemy.stage * 10
            game.growth_progress += enemy.stage
            QueueSound(SOUND_EAT)
            RemoveEnemy(index)
            GrowPlayer()
            unused SpawnEnemy(StageForPopulation(edible_before, enemy_count_before - 1))
            player_size = cast(float32)StageSize(game.player_stage)
            player_left = game.player_x - player_size * .5
            player_right = game.player_x + player_size * .5
            player_top = game.player_y - player_size * .5
            player_bottom = game.player_y + player_size * .5
            continue
        }
        game.lives -= 1
        QueueSound(SOUND_LOSE_LIFE)
        if game.lives < 0 {
            game.over = true
            QueueSound(SOUND_GAME_OVER)
        }
        return
    }
}

UpdateGame :: (input: GameInput, delta: float64) {
    if !game.started || game.over { return }
    if delta > .1 { delta = .1 }
    game.elapsed += delta
    if game.mode == MODE_FISH { UpdateSea(input, delta); return }
    MovePlayer(input, delta)
    for index: cast(s32)0..game.enemy_count - 1 { MoveEnemy(index, delta) }
    ResolveCollisions()
    if game.over { return }
    game.next_spawn_timer -= delta
    if game.next_spawn_timer <= 0.0 {
        unused SpawnEnemy(-1)
        game.next_spawn_timer = 5.0 + cast(float64)RandomNext(4000) / 1000.0
    }
}

// Keeps a point of SIZE in the water between the surface and the sand.
SeaClamp :: (x: *float32, y: *float32, size: float32) -> bool {
    half := size * .5
    clamped := false
    if <<x < half { <<x = half; clamped = true }
    if <<x > cast(float32)FIELD_WIDTH - half { <<x = cast(float32)FIELD_WIDTH - half; clamped = true }
    if <<y < cast(float32)SEA_TOP + half { <<y = cast(float32)SEA_TOP + half; clamped = true }
    if <<y > cast(float32)SEA_BOTTOM - half { <<y = cast(float32)SEA_BOTTOM - half; clamped = true }
    return clamped
}

SeaY :: (size: float32) -> float32 {
    room := cast(s32)(cast(float32)SEA_BOTTOM - cast(float32)SEA_TOP - size)
    return cast(float32)SEA_TOP + size * .5 + cast(float32)RandomNext(room)
}

// A fish swims in from the left or right edge, or, at the start, already
// somewhere in the water away from the player.
SpawnFish :: (forced_stage: s32, inside: bool) -> bool {
    if game.enemy_count >= ENEMY_LIMIT { return false }
    stage := forced_stage
    if stage < STAGE_FIRST { stage = StageForPopulation(EdibleCount(), FishCount()) }
    if stage > STAGE_LAST { stage = STAGE_LAST }
    size := cast(float32)StageSize(stage)
    leftward := RandomNext(2) == 0
    x: float32 = ifx leftward then cast(float32)FIELD_WIDTH + size else -size
    y := SeaY(size)
    if inside {
        x = cast(float32)RandomNext(cast(s32)FIELD_WIDTH)
        attempt: s32 = 0
        while attempt < 32 && DistanceSquared(x, y, game.player_x, game.player_y) < 90.0 * 90.0 {
            x = cast(float32)RandomNext(cast(s32)FIELD_WIDTH)
            y = SeaY(size)
            attempt += 1
        }
    }
    speed := 28.0 + cast(float32)RandomNext(30) + cast(float32)(STAGE_LAST - stage) * 2.0
    // Each new fish looks different from the one before it.
    game.fish_species = (game.fish_species + 1 + cast(s32)RandomNext(FISH_SPECIES - 1)) % FISH_SPECIES
    game.enemies[game.enemy_count] = .{.x = x, .y = y, .stage = stage,
        .velocity_x = ifx leftward then -speed else speed, .active = true, .kind = KIND_FISH,
        .phase = cast(float32)RandomNext(628) * .01, .animation = cast(float64)RandomNext(100) / 100.0,
        .species = game.fish_species}
    game.enemy_count += 1
    return true
}

// Jellyfish rise from below and pearls sink from the surface.
SpawnDrifter :: (kind: s32) -> bool {
    if game.enemy_count >= ENEMY_LIMIT { return false }
    x := 40.0 + cast(float32)RandomNext(cast(s32)FIELD_WIDTH - 80)
    jelly := kind == KIND_JELLY
    game.enemies[game.enemy_count] = .{.x = x,
        .y = ifx jelly then cast(float32)SEA_BOTTOM + 20.0 else cast(float32)SEA_TOP - 8.0,
        .stage = ifx jelly then STAGE_LAST else 0, .velocity_y = ifx jelly then -14.0 else 20.0,
        .active = true, .kind = kind, .phase = cast(float32)RandomNext(628) * .01}
    game.enemy_count += 1
    return true
}

// The shark enters at the depth chosen during its musical lead-in.
SpawnShark :: () -> bool {
    if game.enemy_count >= ENEMY_LIMIT { return false }
    length := cast(float32)SHARK_LENGTH
    game.enemies[game.enemy_count] = .{
        .x = ifx game.shark_leftward then cast(float32)FIELD_WIDTH + length * .5 else -length * .5,
        .y = game.shark_y, .stage = STAGE_LAST,
        .velocity_x = ifx game.shark_leftward then -cast(float32)SHARK_SPEED else cast(float32)SHARK_SPEED,
        .active = true, .kind = KIND_SHARK}
    game.enemy_count += 1
    game.shark_bit = false
    return true
}

// Sardines swim in from one side as a tight school sharing one wave.
SpawnSchool :: () {
    leftward := RandomNext(2) == 0
    y := SeaY(60.0)
    phase := cast(float32)RandomNext(628) * .01
    for member: cast(s32)0..SCHOOL_SIZE - 1 {
        if game.enemy_count >= ENEMY_LIMIT { return }
        behind := cast(float32)(member % 3) * 16.0 + cast(float32)RandomNext(6)
        x: float32 = ifx leftward then cast(float32)FIELD_WIDTH + 10.0 + behind else -10.0 - behind
        game.enemies[game.enemy_count] = .{.x = x, .y = y + cast(float32)(member / 3 * 14 - 14) + cast(float32)RandomNext(6),
            .stage = 0, .velocity_x = ifx leftward then -78.0 else 78.0, .active = true, .kind = KIND_SARDINE,
            .phase = phase, .animation = cast(float64)member * .07}
        game.enemy_count += 1
    }
}

SeaAnimal :: (kind: s32) -> bool { return kind == KIND_SEAHORSE || kind == KIND_LOBSTER || kind == KIND_STARFISH }

// Half the width and height of a sea animal's body.
BodyHalf :: (kind: s32, stage: s32, half_width: *float32, half_height: *float32) {
    size := cast(float32)StageSize(stage)
    <<half_width = size * .5
    <<half_height = size * .5
    if kind == KIND_SEAHORSE {
        <<half_width = size * SEAHORSE_WIDTH * .5
        <<half_height = size * SEAHORSE_HEIGHT * .5
    }
}

// Where a sea animal of SIZE keeps to: lobsters on the sand, starfish just
// above it.
SandY :: (kind: s32, size: float32) -> float32 {
    if kind == KIND_LOBSTER { return cast(float32)SEA_BOTTOM - size * .5 }
    return cast(float32)SEA_BOTTOM - size * .5 - 10.0
}

// A seahorse, lobster or starfish enters from one side, smaller than the
// player or a size or two bigger; a seahorse is at least SEAHORSE_STAGE.
SpawnSeaAnimal :: (kind: s32) -> bool {
    if game.mode != MODE_FISH || !SeaAnimal(kind) || game.enemy_count >= ENEMY_LIMIT { return false }
    lowest: s32 = ifx kind == KIND_SEAHORSE then SEAHORSE_STAGE else STAGE_FIRST
    highest := game.player_stage + 2
    if highest < lowest { highest = lowest }
    stage := lowest + cast(s32)RandomNext(highest - lowest + 1)
    if stage > STAGE_LAST { stage = STAGE_LAST }
    size := cast(float32)StageSize(stage)
    half_width: float32
    half_height: float32
    BodyHalf(kind, stage, *half_width, *half_height)
    leftward := RandomNext(2) == 0
    speed: float32 = ifx kind == KIND_LOBSTER then 34.0 else ifx kind == KIND_SEAHORSE then 22.0 else 15.0
    y := ifx kind == KIND_SEAHORSE then SeaY(half_height * 2.0) else SandY(kind, size)
    game.enemies[game.enemy_count] = .{.x = ifx leftward then cast(float32)FIELD_WIDTH + size else -size,
        .y = y, .stage = stage, .velocity_x = ifx leftward then -speed else speed, .active = true, .kind = kind,
        .phase = cast(float32)RandomNext(628) * .01}
    game.enemy_count += 1
    return true
}

// The turtle swims in from either edge at a depth in open water.
SpawnTurtle :: () -> bool {
    if game.mode != MODE_FISH || game.enemy_count >= ENEMY_LIMIT || KindCount(KIND_TURTLE) > 0 { return false }
    leftward := RandomNext(2) == 0
    half := cast(float32)TURTLE_WIDTH * .5
    game.enemies[game.enemy_count] = .{.x = ifx leftward then cast(float32)FIELD_WIDTH + half else -half,
        .y = SeaY(cast(float32)TURTLE_HEIGHT + 40.0),
        .velocity_x = ifx leftward then -cast(float32)TURTLE_SPEED else cast(float32)TURTLE_SPEED,
        .active = true, .kind = KIND_TURTLE, .phase = cast(float32)RandomNext(628) * .01}
    game.enemy_count += 1
    game.turtle_pearls = 0
    game.turtle_drop = TURTLE_DROP
    return true
}

// A golden pearl sinks from X, Y.
DropPearl :: (x: float32, y: float32) -> bool {
    if game.enemy_count >= ENEMY_LIMIT { return false }
    game.enemies[game.enemy_count] = .{.x = x, .y = y, .velocity_y = 20.0, .active = true, .kind = KIND_PEARL,
        .phase = cast(float32)RandomNext(628) * .01}
    game.enemy_count += 1
    return true
}

// While in the water, the turtle leaves a pearl behind it every so often,
// up to TURTLE_PEARLS a visit.
TurtleTrail :: (delta: float64) {
    for index: cast(s32)0..game.enemy_count - 1 {
        turtle := game.enemies[index]
        if turtle.kind != KIND_TURTLE || game.turtle_pearls >= TURTLE_PEARLS { continue }
        behind: float32 = ifx turtle.velocity_x < 0.0 then cast(float32)TURTLE_WIDTH * .3 else -cast(float32)TURTLE_WIDTH * .3
        x := turtle.x + behind
        if x < 12.0 || x > cast(float32)FIELD_WIDTH - 12.0 { continue }
        game.turtle_drop -= delta
        if game.turtle_drop <= 0.0 && DropPearl(x, turtle.y + 10.0) {
            game.turtle_pearls += 1
            game.turtle_drop = TURTLE_DROP
        }
    }
}

SeaAnimalCount :: () -> s32 {
    return KindCount(KIND_SEAHORSE) + KindCount(KIND_LOBSTER) + KindCount(KIND_STARFISH)
}

// The music can precede the shark itself.
SharkAlert :: () -> bool { return game.mode == MODE_FISH && !game.over && (game.shark_warning > 0.0 || KindCount(KIND_SHARK) > 0) }

// The shark's body, a long low box.
SharkReach :: (shark: Enemy, left: *float32, right: *float32, top: *float32, bottom: *float32) {
    <<left = shark.x - cast(float32)SHARK_LENGTH * .4
    <<right = shark.x + cast(float32)SHARK_LENGTH * .4
    <<top = shark.y - cast(float32)SHARK_LENGTH * .12
    <<bottom = shark.y + cast(float32)SHARK_LENGTH * .12
}

FishCount :: () -> s32 {
    count: s32 = 0
    for index: cast(s32)0..game.enemy_count - 1 {
        if game.enemies[index].kind == KIND_FISH { count += 1 }
    }
    return count
}

KindCount :: (kind: s32) -> s32 {
    count: s32 = 0
    for index: cast(s32)0..game.enemy_count - 1 {
        if game.enemies[index].kind == kind { count += 1 }
    }
    return count
}

// Fish cross with a gentle wave; a hungry bigger fish nearby drifts towards
// the player's depth. False once it has left the water.
MoveSeaCreature :: (index: s32, delta: float64) -> bool {
    enemy := *game.enemies[index]
    enemy.animation += delta
    wave := cast(float32)Math.Sin(enemy.animation * 1.6 + cast(float64)enemy.phase)
    step := cast(float32)delta
    if enemy.kind == KIND_FISH {
        size := cast(float32)StageSize(enemy.stage)
        enemy.velocity_y = wave * 10.0
        across := enemy.x - game.player_x
        if enemy.stage > game.player_stage && across * across < 150.0 * 150.0 {
            enemy.velocity_y += ifx game.player_y > enemy.y then 22.0 else -22.0
        }
        enemy.x += enemy.velocity_x * step
        enemy.y += enemy.velocity_y * step
        if enemy.y < cast(float32)SEA_TOP + size * .5 { enemy.y = cast(float32)SEA_TOP + size * .5 }
        if enemy.y > cast(float32)SEA_BOTTOM - size * .5 { enemy.y = cast(float32)SEA_BOTTOM - size * .5 }
        return !(enemy.velocity_x < 0.0 && enemy.x < -size - 4.0) &&
            !(enemy.velocity_x > 0.0 && enemy.x > cast(float32)FIELD_WIDTH + size + 4.0)
    }
    if enemy.kind == KIND_SHARK {
        enemy.velocity_y = 0.0
        if game.player_y > enemy.y + 4.0 { enemy.velocity_y = cast(float32)SHARK_TURN }
        if game.player_y < enemy.y - 4.0 { enemy.velocity_y = -cast(float32)SHARK_TURN }
        enemy.x += enemy.velocity_x * step
        enemy.y += enemy.velocity_y * step
        half := cast(float32)SHARK_LENGTH * .5
        return !(enemy.velocity_x < 0.0 && enemy.x < -half - 4.0) &&
            !(enemy.velocity_x > 0.0 && enemy.x > cast(float32)FIELD_WIDTH + half + 4.0)
    }
    if enemy.kind == KIND_TURTLE {
        // Glides slowly across with a mild bob.
        half_height := cast(float32)TURTLE_HEIGHT * .5
        enemy.velocity_y = wave * 6.0
        enemy.x += enemy.velocity_x * step
        enemy.y += enemy.velocity_y * step
        if enemy.y < cast(float32)SEA_TOP + half_height { enemy.y = cast(float32)SEA_TOP + half_height }
        if enemy.y > cast(float32)SEA_BOTTOM - half_height { enemy.y = cast(float32)SEA_BOTTOM - half_height }
        half := cast(float32)TURTLE_WIDTH * .5
        return !(enemy.velocity_x < 0.0 && enemy.x < -half - 4.0) &&
            !(enemy.velocity_x > 0.0 && enemy.x > cast(float32)FIELD_WIDTH + half + 4.0)
    }
    if SeaAnimal(enemy.kind) {
        size := cast(float32)StageSize(enemy.stage)
        if enemy.kind == KIND_SEAHORSE {
            // Bobs up and down while slowly rising.
            half_width: float32
            half_height: float32
            BodyHalf(enemy.kind, enemy.stage, *half_width, *half_height)
            enemy.velocity_y = wave * 30.0 - 5.0
            enemy.x += enemy.velocity_x * step
            enemy.y += enemy.velocity_y * step
            if enemy.y < cast(float32)SEA_TOP + half_height { enemy.y = cast(float32)SEA_TOP + half_height }
            if enemy.y > cast(float32)SEA_BOTTOM - half_height { enemy.y = cast(float32)SEA_BOTTOM - half_height }
        } else if enemy.kind == KIND_LOBSTER {
            // Scuttles along the sand in stops and starts.
            enemy.velocity_y = 0.0
            enemy.x += enemy.velocity_x * (.2 + .8 * wave * wave) * step
            enemy.y = SandY(enemy.kind, size)
        } else {
            // Drifts slowly, rising and settling a little.
            enemy.velocity_y = wave * 3.0
            enemy.x += enemy.velocity_x * step
            enemy.y = SandY(enemy.kind, size) + wave * 4.0
        }
        return !(enemy.velocity_x < 0.0 && enemy.x < -size - 4.0) &&
            !(enemy.velocity_x > 0.0 && enemy.x > cast(float32)FIELD_WIDTH + size + 4.0)
    }
    if enemy.kind == KIND_SARDINE {
        enemy.velocity_y = wave * 24.0
        enemy.x += enemy.velocity_x * step
        enemy.y += enemy.velocity_y * step
        return !(enemy.velocity_x < 0.0 && enemy.x < -60.0) &&
            !(enemy.velocity_x > 0.0 && enemy.x > cast(float32)FIELD_WIDTH + 60.0)
    }
    enemy.x += wave * 8.0 * step
    enemy.y += enemy.velocity_y * step
    if enemy.kind == KIND_JELLY { return enemy.y > cast(float32)SEA_TOP - 40.0 }
    return enemy.y < cast(float32)SEA_BOTTOM - 4.0
}

LoseLife :: () {
    game.lives -= 1
    game.safe_timer = SAFE_SECONDS
    game.frenzy = 0
    if KindCount(KIND_SHARK) > 0 { game.shark_bit = true }
    QueueSound(SOUND_LOSE_LIFE)
    if game.lives < 0 {
        game.over = true
        QueueSound(SOUND_GAME_OVER)
    }
}

// Each bite soon after the last one grows the frenzy.
Feed :: () {
    game.frenzy = ifx game.frenzy_timer > 0.0 then game.frenzy + 1 else 1
    if game.frenzy > FRENZY_MOST { game.frenzy = FRENZY_MOST }
    game.frenzy_timer = FRENZY_SECONDS
}

// Fish and sardines in a shark's mouth are gone.
SharkFeeds :: () {
    shark: s32 = 0
    while shark < game.enemy_count {
        if game.enemies[shark].kind != KIND_SHARK { shark += 1; continue }
        left: float32
        right: float32
        top: float32
        bottom: float32
        SharkReach(game.enemies[shark], *left, *right, *top, *bottom)
        index: s32 = 0
        while index < game.enemy_count {
            prey := game.enemies[index]
            if (prey.kind == KIND_FISH || prey.kind == KIND_SARDINE) &&
                RectanglesOverlap(left, right, top, bottom, prey.x - 3.0, prey.x + 3.0, prey.y - 3.0, prey.y + 3.0) {
                RemoveEnemy(index)
                if index < shark { shark -= 1 }
                continue
            }
            index += 1
        }
        shark += 1
    }
}

SeaCollisions :: () {
    index: s32 = 0
    while index < game.enemy_count && !game.over {
        enemy := game.enemies[index]
        // The turtle is a gentle visitor: no bite, and too big to eat.
        if enemy.kind == KIND_TURTLE { index += 1; continue }
        player_size := cast(float32)StageSize(game.player_stage)
        reach := player_size * .5
        enemy_size: float32 = ifx enemy.kind == KIND_JELLY then 26.0 else 12.0
        eats := enemy.kind == KIND_FISH || SeaAnimal(enemy.kind)
        if eats { enemy_size = cast(float32)StageSize(enemy.stage) }
        if enemy.kind == KIND_SARDINE { enemy_size = cast(float32)SARDINE_SIZE + 4.0 }
        inset := enemy_size * .5 - COLLISION_INSET
        if inset < 2.0 { inset = 2.0 }
        inset_y := inset
        if enemy.kind == KIND_SEAHORSE {
            half_width: float32
            half_height: float32
            BodyHalf(enemy.kind, enemy.stage, *half_width, *half_height)
            inset = half_width - COLLISION_INSET
            inset_y = half_height - COLLISION_INSET
        }
        left := enemy.x - inset
        right := enemy.x + inset
        top := enemy.y - inset_y
        bottom := enemy.y + inset_y
        if enemy.kind == KIND_SHARK { SharkReach(enemy, *left, *right, *top, *bottom) }
        if !RectanglesOverlap(game.player_x - reach, game.player_x + reach, game.player_y - reach, game.player_y + reach,
            left, right, top, bottom) { index += 1; continue }
        if enemy.kind == KIND_SARDINE {
            Feed()
            game.score += SARDINE_SCORE * game.frenzy
            game.growth_progress += 1
            QueueSound(SOUND_EAT)
            RemoveEnemy(index)
            GrowPlayer()
            continue
        }
        if enemy.kind == KIND_PEARL {
            game.score += PEARL_SCORE
            game.growth_progress += 2
            QueueSound(SOUND_EAT)
            RemoveEnemy(index)
            GrowPlayer()
            continue
        }
        if eats && enemy.stage <= game.player_stage {
            Feed()
            game.score += enemy.stage * 10
            if game.frenzy > 1 { game.score += SARDINE_SCORE * game.frenzy }
            game.growth_progress += enemy.stage
            QueueSound(SOUND_EAT)
            RemoveEnemy(index)
            GrowPlayer()
            continue
        }
        if game.safe_timer <= 0.0 { LoseLife() }
        index += 1
    }
}

UpdateSea :: (input: GameInput, delta: float64) {
    if game.dash_timer > 0.0 { game.dash_timer -= delta }
    if game.dash_cooldown > 0.0 { game.dash_cooldown -= delta }
    if game.safe_timer > 0.0 { game.safe_timer -= delta }
    if game.frenzy_timer > 0.0 { game.frenzy_timer -= delta }
    if game.frenzy_timer <= 0.0 { game.frenzy = 0 }
    MovePlayer(input, delta)
    index: s32 = 0
    while index < game.enemy_count {
        if MoveSeaCreature(index, delta) { index += 1; continue }
        // Outlasting a shark's pass without a bite earns a bonus.
        if game.enemies[index].kind == KIND_SHARK && !game.shark_bit {
            game.score += SHARK_SCORE
            QueueSound(SOUND_GROW)
        }
        RemoveEnemy(index)
    }
    TurtleTrail(delta)
    SharkFeeds()
    SeaCollisions()
    if game.over { return }
    // More fish join as a run goes on.
    wanted := FISH_START + cast(s32)(game.elapsed / 15.0)
    if wanted > FISH_MOST { wanted = FISH_MOST }
    game.next_spawn_timer -= delta
    if game.next_spawn_timer <= 0.0 && FishCount() < wanted {
        unused SpawnFish(-1, false)
        game.next_spawn_timer = .6 + cast(float64)RandomNext(1000) / 1000.0
    }
    game.jelly_timer -= delta
    if game.jelly_timer <= 0.0 {
        if game.player_stage >= JELLY_STAGE && KindCount(KIND_JELLY) < JELLY_MOST { unused SpawnDrifter(KIND_JELLY) }
        game.jelly_timer = 12.0 + cast(float64)RandomNext(8000) / 1000.0
    }
    game.pearl_timer -= delta
    if game.pearl_timer <= 0.0 {
        unused SpawnDrifter(KIND_PEARL)
        game.pearl_timer = 9.0 + cast(float64)RandomNext(6000) / 1000.0
    }
    game.school_timer -= delta
    if game.school_timer <= 0.0 {
        SpawnSchool()
        game.school_timer = 14.0 + cast(float64)RandomNext(8000) / 1000.0
    }
    // Seahorse, lobster and starfish take turns, a few at most at once.
    game.animal_timer -= delta
    if game.animal_timer <= 0.0 {
        game.animal_timer = 1.0
        if SeaAnimalCount() < ANIMAL_MOST && SpawnSeaAnimal(game.animal_next) {
            game.animal_next = ifx game.animal_next == KIND_STARFISH then KIND_SEAHORSE else game.animal_next + 1
            game.animal_timer = 6.0 + cast(float64)RandomNext(3000) / 1000.0
        }
    }
    if KindCount(KIND_TURTLE) == 0 {
        game.turtle_timer -= delta
        if game.turtle_timer <= 0.0 {
            game.turtle_timer = 1.0
            if SpawnTurtle() { game.turtle_timer = 45.0 + cast(float64)RandomNext(20000) / 1000.0 }
        }
    }
    if game.shark_warning > 0.0 {
        game.shark_warning -= delta
        if game.shark_warning <= 0.0 {
            game.shark_warning = 0.0
            unused SpawnShark()
        }
    } else if KindCount(KIND_SHARK) == 0 {
        game.shark_timer -= delta
        if game.shark_timer <= 0.0 {
            game.shark_warning = SHARK_WARNING
            game.shark_leftward = RandomNext(2) == 0
            game.shark_y = SeaY(cast(float32)SHARK_LENGTH * .3)
            game.shark_timer = 25.0 + cast(float64)RandomNext(15000) / 1000.0
        }
    }
}
