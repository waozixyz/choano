#import "kryon/geometry"
Math :: #import "std/math";

// All layers of a dressed player share this transform, including the bob.
FloatPose :: struct {
    center: Vector2
    scale_x: float32
    scale_y: float32
    cosine: float32
    sine: float32
    flip: float32
}

FloatingPose :: (size: float32, animation: float64, lean: float32, bob: float32,
    x: float32, y: float32, side: string) -> FloatPose {
    breath := cast(float32)Math.Sin(animation * 4.4)
    if lean > 1.0 { lean = 1.0 }
    if lean < -1.0 { lean = -1.0 }
    flip: float32 = ifx side == "left" then -1.0 else 1.0
    angle := cast(float64)(lean * .3 * flip)
    return .{.center = .{x, y + cast(float32)Math.Sin(animation * 2.6) * size * bob},
        .scale_x = 1.0 + breath * .03, .scale_y = 1.0 - breath * .03,
        .cosine = cast(float32)Math.Cos(angle), .sine = cast(float32)Math.Sin(angle), .flip = flip}
}

PosePoint :: (pose: FloatPose, point: Vector2) -> Vector2 {
    across := point.x * pose.scale_x * pose.flip
    along := point.y * pose.scale_y
    return .{pose.center.x + across * pose.cosine - along * pose.sine,
        pose.center.y + across * pose.sine + along * pose.cosine}
}

LayerPoints :: (pose: FloatPose, width: float32, height: float32) -> [4]Vector2 {
    points: [4]Vector2
    points[0] = PosePoint(pose, .{-width * .5, -height * .5})
    points[1] = PosePoint(pose, .{width * .5, -height * .5})
    points[2] = PosePoint(pose, .{-width * .5, height * .5})
    points[3] = PosePoint(pose, .{width * .5, height * .5})
    return points
}

QuadBounds :: (points: [4]Vector2) -> Rectangle {
    left := points[0].x; right := left
    top := points[0].y; bottom := top
    for point: points {
        if point.x < left { left = point.x }
        if point.x > right { right = point.x }
        if point.y < top { top = point.y }
        if point.y > bottom { bottom = point.y }
    }
    return .{left, top, right - left, bottom - top}
}

HudLayout :: struct {
    score_label: Rectangle
    score_value: Rectangle
    growth_meter: Rectangle
}

FitHud :: (bar: Rectangle) -> HudLayout {
    // A 48-unit pause target, a wide score column and a separate danger column.
    score_width := bar.width - 184.0
    if score_width < 1.0 { score_width = 1.0 }
    return .{.score_label = .{bar.x + 68.0, bar.y + 3.0, score_width, 14.0},
        .score_value = .{bar.x + 68.0, bar.y + 19.0, score_width, 28.0},
        .growth_meter = .{bar.x + 94.0, bar.y + 58.0, bar.width - 106.0, 8.0}}
}

PauseBounds :: (bar: Rectangle) -> Rectangle {
    return .{bar.x + 8.0, bar.y + 1.0, 48.0, 48.0}
}

HaloPose :: (body: FloatPose, width: float32, height: float32) -> FloatPose {
    pose := body
    top := QuadBounds(LayerPoints(body, width, height)).y
    pose.center.y = top - width * .18
    // Light floats level above the head, rather than wrapping around the body.
    pose.cosine = 1.0; pose.sine = 0.0; pose.flip = 1.0
    return pose
}

ScoreFont :: (width: float32, digits: s32) -> s32 {
    font: s32 = 24
    if digits > 0 && width / (cast(float32)digits * .66) < cast(float32)font {
        font = cast(s32)(width / (cast(float32)digits * .66))
    }
    if font < 7 { font = 7 }
    return font
}

ShopBounds :: (area: Rectangle) -> Rectangle {
    width := area.width - 24.0
    if width > 560.0 { width = 560.0 }
    height: float32 = ifx width < 420.0 then 420.0 else 340.0
    if height > area.height - 24.0 { height = area.height - 24.0 }
    return .{area.x + (area.width - width) * .5, area.y + (area.height - height) * .5, width, height}
}

ShopCard :: (shop: Rectangle, id: s32) -> Rectangle {
    stacked := shop.width < 420.0
    if stacked {
        height := (shop.height - 80.0) / 3.0
        return .{shop.x + 12.0, shop.y + 68.0 + cast(float32)id * (height + 4.0), shop.width - 24.0, height}
    }
    width := (shop.width - 40.0) / 3.0
    return .{shop.x + 12.0 + cast(float32)id * (width + 8.0), shop.y + 68.0, width, shop.height - 80.0}
}

AccessoryLayout :: struct {
    preview: Rectangle
    button: Rectangle
    requirement: Rectangle
}

FitAccessory :: (card: Rectangle, stacked: bool) -> AccessoryLayout {
    if stacked {
        size: float32 = 64.0
        if size > card.height - 16.0 { size = card.height - 16.0 }
        left := card.x + size + 20.0
        width := card.width - size - 30.0
        return .{.preview = .{card.x + 10.0, card.y + (card.height - size) * .5, size, size},
            .button = .{left, card.y + 6.0, width, 36.0},
            .requirement = .{left, card.y + 46.0, width, card.height - 50.0}}
    }
    size: float32 = 104.0
    if size > card.width - 20.0 { size = card.width - 20.0 }
    if size > card.height - 112.0 { size = card.height - 112.0 }
    return .{.preview = .{card.x + (card.width - size) * .5, card.y + 8.0, size, size},
        .button = .{card.x + 8.0, card.y + size + 16.0, card.width - 16.0, 32.0},
        .requirement = .{card.x + 8.0, card.y + size + 54.0, card.width - 16.0, 48.0}}
}
