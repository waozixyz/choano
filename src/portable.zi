// Independent game package; Arcade and Inner Breeze supply bounded services.
#import "apps/node_types"
#import "apps/node_app"
#import "kryon/geometry"
App :: #import "app";
Game :: #import "game";
Runtime :: #import "portable_runtime";
Progress :: #import "progress";
host_api :: #system_library "host_api";
ReadAppUiHost :: () -> AppUiFrame #foreign host_api;

#program_export
Main :: () -> s32 { return RunNodeApp(ChoanoFrame, ChoanoBack) }

ChoanoFrame :: (message: AppMessage) -> bool {
    App.SetProfileAvailable(true)
    frame := ReadAppUiHost()
    Runtime.frame_now = frame.now
    area := Rectangle.{0.0, cast(float32)frame.top, cast(float32)frame.width,
        cast(float32)(frame.height - frame.top - frame.bottom)}
    Runtime.CaptureKey()
    key := Runtime.PressedKey()
    if key == 80 { Progress.Reset(); unused Runtime.Service("entity.profile", "open"); App.PauseClock() }
    if Progress.ProgressPump(frame.now, App.AmoebaStage(), message.time, !App.ProgressPlaying()) {
        Game.StartGame(cast(u32)(frame.now * 1000.0), Game.game.mode); App.PauseClock()
    }
    if !App.ProgressPlaying() { App.AccountProgress(Progress.HighestStage()) }
    ok := App.Frame(frame.session, area) == 0
    if App.TakeProfileRequest() { Progress.Reset(); unused Runtime.Service("entity.profile", "open"); App.PauseClock() }
    return ok
}

ChoanoBack :: (message: AppMessage) -> bool { unused message; return App.NavigateBack() }
