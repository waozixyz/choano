Audio :: #import "audio_host";
#import "android_run"
#import "kryon/AndroidSurface"
Timer :: #import "std/timer_linux";

// Choano: the Android entry. raylib's NativeActivity backend calls this C
// main; the canonical host loop in android_run drives the app's Frame.
#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    unused argc
    unused argv
    SetAndroidViewportPolicy(AndroidViewportPolicyFull())
    defer { Audio.AudioClose() }
    return AndroidRunMain()
}

#program_export
ClockMillisecondsHost :: () -> s64 { return Timer.MonotonicMilliseconds() }
