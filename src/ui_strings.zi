    if code == "it" { return "Impostazioni" }
    if code == "cs" { return "Nastavení" }
    if code == "id" { return "Pengaturan" }
    if code == "ru" { return "Настройки" }
    if code == "ja" { return "設定" }
    if code == "ko" { return "설정" }
    if code == "zh" { return "设置" }
    return "Settings"
}

SettingsCopy :: struct {
    controls: string
    swipe: string
    pad: string
    sound: string
    sound_on: string
    sound_off: string
    done: string
    save_error: string
}

SettingsLabels :: (language: string) -> SettingsCopy {
    code := language
    if code.count > 2 { code = code[0:2] }
    if code == "es" {
        return SettingsCopy.{
            .controls = "Controles", .swipe = "Deslizar",
            .pad = "Cruceta", .sound = "Sonido",
            .sound_on = "Activado", .sound_off = "Desactivado",
            .done = "Listo", .save_error = "No se guardaron los ajustes"
        }
    }
    if code == "pt" {
        return SettingsCopy.{
            .controls = "Controles", .swipe = "Deslizar",
            .pad = "Direcional", .sound = "Som",
            .sound_on = "Ligado", .sound_off = "Desligado",
            .done = "Pronto", .save_error = "Não foi possível salvar"
        }
    }
    if code == "fr" {
        return SettingsCopy.{
            .controls = "Commandes", .swipe = "Glisser",
            .pad = "Croix directionnelle", .sound = "Son",
            .sound_on = "Activé", .sound_off = "Désactivé",
            .done = "Terminé", .save_error = "Impossible d’enregistrer"
        }
    }
    if code == "de" {
        return SettingsCopy.{
            .controls = "Steuerung", .swipe = "Wischen",
            .pad = "Steuerkreuz", .sound = "Ton",
            .sound_on = "An", .sound_off = "Aus",
            .done = "Fertig", .save_error = "Speichern fehlgeschlagen"
        }
    }
    if code == "it" {
        return SettingsCopy.{
            .controls = "Comandi", .swipe = "Scorrimento",
            .pad = "Pad direzionale", .sound = "Audio",
            .sound_on = "Attivo", .sound_off = "Disattivo",
            .done = "Fatto", .save_error = "Salvataggio non riuscito"
        }
    }
    if code == "cs" {
        return SettingsCopy.{
            .controls = "Ovládání", .swipe = "Tažení",
            .pad = "Směrový kříž", .sound = "Zvuk",
            .sound_on = "Zapnuto", .sound_off = "Vypnuto",
            .done = "Hotovo", .save_error = "Nastavení nelze uložit"
        }
    }
    if code == "id" {
        return SettingsCopy.{
            .controls = "Kontrol", .swipe = "Geser",
            .pad = "Tombol arah", .sound = "Suara",
            .sound_on = "Aktif", .sound_off = "Nonaktif",
            .done = "Selesai", .save_error = "Pengaturan gagal disimpan"
        }
    }
    if code == "ru" {
        return SettingsCopy.{
            .controls = "Управление", .swipe = "Скольжение",
            .pad = "Крестовина", .sound = "Звук",
            .sound_on = "Вкл.", .sound_off = "Выкл.",
            .done = "Готово", .save_error = "Не удалось сохранить"
        }
    }
    if code == "ja" {
        return SettingsCopy.{
            .controls = "操作", .swipe = "スワイプ",
            .pad = "方向パッド", .sound = "サウンド",
            .sound_on = "オン", .sound_off = "オフ",
            .done = "完了", .save_error = "設定を保存できませんでした"
        }
    }
    if code == "ko" {
        return SettingsCopy.{
            .controls = "조작", .swipe = "스와이프",
            .pad = "방향 패드", .sound = "소리",
            .sound_on = "켜기", .sound_off = "끄기",
            .done = "완료", .save_error = "설정을 저장하지 못했습니다"
        }
    }
    if code == "zh" {
        return SettingsCopy.{
            .controls = "操作方式", .swipe = "滑动",
            .pad = "方向键", .sound = "声音",
            .sound_on = "开启", .sound_off = "关闭",
            .done = "完成", .save_error = "无法保存设置"
        }
    }
    return SettingsCopy.{
        .controls = "Controls", .swipe = "Swipe",
        .pad = "Direction pad", .sound = "Sound",
        .sound_on = "On", .sound_off = "Off",
        .done = "Done", .save_error = "Could not save settings"
    }
}

ShopCopy :: struct {
    halo: string
    ribbon: string
    crown: string
    halo_requirement: string
    ribbon_requirement: string
    crown_requirement: string
    close: string
}

ShopLabels :: (language: string) -> ShopCopy {
    code := language
    if code.count > 2 { code = code[0:2] }
    if code == "es" {
        return .{.halo = "Halo", .ribbon = "Lazo", .crown = "Corona", .halo_requirement = "Disponible al empezar", .ribbon_requirement = "Alcanza el tamaño 5\nen Ameba", .crown_requirement = "Alcanza el tamaño máximo (9)\nen Ameba", .close = "Cerrar"}
    }
    if code == "pt" {
        return .{.halo = "Auréola", .ribbon = "Laço", .crown = "Coroa", .halo_requirement = "Disponível desde o início", .ribbon_requirement = "Alcance o tamanho 5\nem Ameba", .crown_requirement = "Alcance o tamanho máximo (9)\nem Ameba", .close = "Fechar"}
    }
    if code == "fr" {
        return .{.halo = "Auréole", .ribbon = "Ruban", .crown = "Couronne", .halo_requirement = "Disponible dès le début", .ribbon_requirement = "Atteignez la taille 5\nen Amibe", .crown_requirement = "Atteignez la taille maximale (9)\nen Amibe", .close = "Fermer"}
    }
    if code == "de" {
        return .{.halo = "Heiligenschein", .ribbon = "Schleife", .crown = "Krone", .halo_requirement = "Von Anfang an verfügbar", .ribbon_requirement = "Erreiche Größe 5\nals Amöbe", .crown_requirement = "Erreiche volle Größe (9)\nals Amöbe", .close = "Schließen"}
    }
    if code == "it" {
        return .{.halo = "Aureola", .ribbon = "Fiocco", .crown = "Corona", .halo_requirement = "Disponibile dall’inizio", .ribbon_requirement = "Raggiungi la dimensione 5\nin Ameba", .crown_requirement = "Raggiungi la dimensione massima (9)\nin Ameba", .close = "Chiudi"}
    }
    if code == "cs" {
        return .{.halo = "Svatozář", .ribbon = "Mašle", .crown = "Koruna", .halo_requirement = "Dostupné od začátku", .ribbon_requirement = "Dosáhni velikosti 5\nv Amébě", .crown_requirement = "Dosáhni plné velikosti (9)\nv Amébě", .close = "Zavřít"}
    }
    if code == "id" {
        return .{.halo = "Halo", .ribbon = "Pita", .crown = "Mahkota", .halo_requirement = "Tersedia sejak awal", .ribbon_requirement = "Capai ukuran 5\ndi Amoeba", .crown_requirement = "Capai ukuran penuh (9)\ndi Amoeba", .close = "Tutup"}
    }
    if code == "ru" {
        return .{.halo = "Нимб", .ribbon = "Бант", .crown = "Корона", .halo_requirement = "Доступен с начала", .ribbon_requirement = "Достигните размера 5\nв режиме «Амёба»", .crown_requirement = "Достигните полного размера (9)\nв режиме «Амёба»", .close = "Закрыть"}
    }
    if code == "ja" {
        return .{.halo = "光の輪", .ribbon = "リボン", .crown = "王冠", .halo_requirement = "最初から使用可能", .ribbon_requirement = "アメーバで\nサイズ5に成長", .crown_requirement = "アメーバで\n最大サイズ（9）に成長", .close = "閉じる"}
    }
    if code == "ko" {
        return .{.halo = "후광", .ribbon = "리본", .crown = "왕관", .halo_requirement = "처음부터 사용 가능", .ribbon_requirement = "아메바에서\n크기 5 달성", .crown_requirement = "아메바에서\n최대 크기(9) 달성", .close = "닫기"}
    }
    if code == "zh" {
        return .{.halo = "光环", .ribbon = "蝴蝶结", .crown = "王冠", .halo_requirement = "初始即可使用", .ribbon_requirement = "在变形虫模式中\n达到体型5", .crown_requirement = "在变形虫模式中\n达到最大体型（9）", .close = "关闭"}
    }
    return .{.halo = "Halo", .ribbon = "Ribbon", .crown = "Crown", .halo_requirement = "Available from start", .ribbon_requirement = "Reach size 5\nin Amoeba", .crown_requirement = "Reach full size (9)\nin Amoeba", .close = "Close"}
}

FishHelpCopy :: struct { food: string; danger: string; pearls: string; }

Pause :: (language: string) -> string {
    code := language
    if code.count > 2 { code = code[0:2] }
    if code == "es" { return "Pausa" }
    if code == "pt" { return "Pausar" }
    if code == "fr" { return "Pause" }
    if code == "de" { return "Pause" }
    if code == "it" { return "Pausa" }
    if code == "cs" { return "Pauza" }
    if code == "id" { return "Jeda" }
    if code == "ru" { return "Пауза" }
    if code == "ja" { return "一時停止" }
    if code == "ko" { return "일시 정지" }
    if code == "zh" { return "暂停" }
    return "Pause"
}

FishHelp :: (language: string) -> FishHelpCopy {
    code := language
    if code.count > 2 { code = code[0:2] }
    if code == "es" { return .{.food = "Come peces y animales marinos de tu tamaño o menores.", .danger = "Medusas y tiburones siempre dañan. No ataques tortugas.", .pearls = "Las perlas doradas dan 25 puntos; las tortugas también las dejan."} }
    if code == "pt" { return .{.food = "Coma peixes e animais marinhos do seu tamanho ou menores.", .danger = "Águas-vivas e tubarões sempre ferem. Deixe as tartarugas.", .pearls = "Pérolas douradas valem 25 pontos; tartarugas também as soltam."} }
    if code == "fr" { return .{.food = "Mangez les poissons et animaux marins de votre taille ou plus petits.", .danger = "Méduses et requins blessent toujours. Épargnez les tortues.", .pearls = "Les perles dorées valent 25 points. Les tortues en laissent aussi."} }
    if code == "de" { return .{.food = "Friss Fische und Meerestiere deiner Größe oder kleiner.", .danger = "Quallen und Haie verletzen immer. Lass Schildkröten in Ruhe.", .pearls = "Goldene Perlen geben 25 Punkte. Auch Schildkröten lassen sie fallen."} }
    if code == "it" { return .{.food = "Mangia pesci e animali marini della tua taglia o più piccoli.", .danger = "Meduse e squali fanno sempre male. Lascia stare le tartarughe.", .pearls = "Le perle dorate valgono 25 punti. Anche le tartarughe le rilasciano."} }
    if code == "cs" { return .{.food = "Jez ryby a mořské živočichy své velikosti nebo menší.", .danger = "Medúzy a žraloci vždy zraňují. Želvy nech na pokoji.", .pearls = "Zlaté perly dávají 25 bodů. Zanechávají je i želvy."} }
    if code == "id" { return .{.food = "Makan ikan dan hewan laut seukuranmu atau lebih kecil.", .danger = "Ubur-ubur dan hiu selalu melukai. Biarkan penyu.", .pearls = "Mutiara emas memberi 25 poin. Penyu juga menjatuhkannya."} }
    if code == "ru" { return .{.food = "Ешьте рыб и морских животных своего размера или меньше.", .danger = "Медузы и акулы всегда ранят. Черепах не трогайте.", .pearls = "Золотые жемчужины дают 25 очков. Черепахи тоже их оставляют."} }
    if code == "ja" { return .{.food = "自分と同じ大きさ以下の魚や海の生き物を食べよう。", .danger = "クラゲとサメは常に危険。ウミガメはそっとしておこう。", .pearls = "金の真珠は25点。ウミガメも落としてくれる。"} }
    if code == "ko" { return .{.food = "자신과 크기가 같거나 작은 물고기와 바다 동물을 먹으세요.", .danger = "해파리와 상어는 항상 위험해요. 바다거북은 건드리지 마세요.", .pearls = "황금 진주는 25점이에요. 바다거북도 떨어뜨려요."} }
    if code == "zh" { return .{.food = "吃掉与自己一样大或更小的鱼和海洋动物。", .danger = "水母和鲨鱼始终危险。不要打扰海龟。", .pearls = "金色珍珠可得25分，海龟也会留下珍珠。"} }
    return .{.food = "Eat fish and sea animals your size or smaller.", .danger = "Jellyfish and sharks always hurt. Leave turtles alone.", .pearls = "Golden pearls give 25 points. Turtles drop them too."}
}
