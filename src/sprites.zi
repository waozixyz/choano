#import "kryon/geometry"

OrganismSource :: (kind: string, stage: s32, frame: s32) -> Rectangle {
    cells: [14]Rectangle = .[
        .{58.0, 95.0, 230.0, 206.0},
        .{351.0, 119.0, 276.0, 177.0},
        .{692.0, 125.0, 208.0, 176.0},
        .{962.0, 124.0, 243.0, 177.0},
        .{81.0, 407.0, 200.0, 189.0},
        .{376.0, 407.0, 237.0, 192.0},
        .{682.0, 395.0, 205.0, 206.0},
        .{978.0, 392.0, 231.0, 211.0},
        .{56.0, 642.0, 248.0, 254.0},
        .{387.0, 668.0, 202.0, 216.0},
        .{665.0, 672.0, 237.0, 220.0},
        .{980.0, 677.0, 237.0, 217.0},
        .{62.0, 979.0, 224.0, 205.0},
        .{371.0, 972.0, 248.0, 211.0}
    ]
    if kind == "player" { return cells[frame % 4] }
    index := stage - 1
    if index < 0 { index = 0 }
    if index > 9 { index = 9 }
    return cells[index + 4]
}

FISH_SHEET :: "assets/choano/fish/fish-hd.png";
FISH_JELLY :: 14;
FISH_PEARL :: 15;
// Fish mode's sheet: the player's fish, ten fish by size, a jellyfish and a
// golden pearl, each the opaque bounds of its cell.
FishSource :: (index: s32) -> Rectangle {
    cells: [16]Rectangle = .[
        .{73.0, 79.0, 129.0, 98.0},
        .{331.0, 77.0, 128.0, 99.0},
        .{578.0, 90.0, 131.0, 98.0},
        .{837.0, 74.0, 136.0, 105.0},
        .{80.0, 351.0, 109.0, 71.0},
        .{330.0, 334.0, 124.0, 102.0},
        .{577.0, 352.0, 137.0, 73.0},
        .{844.0, 337.0, 124.0, 98.0},
        .{61.0, 556.0, 132.0, 147.0},
        .{317.0, 583.0, 145.0, 105.0},
        .{577.0, 567.0, 139.0, 132.0},
        .{825.0, 584.0, 152.0, 107.0},
        .{58.0, 850.0, 160.0, 85.0},
        .{323.0, 834.0, 151.0, 123.0},
        .{584.0, 818.0, 121.0, 146.0},
        .{879.0, 862.0, 61.0, 61.0}
    ]
    if index < 0 || index > 15 { return cells[0] }
    return cells[index]
}
// A fish of STAGE, one to ten.
FishStageSource :: (stage: s32) -> Rectangle {
    index := stage - 1
    if index < 0 { index = 0 }
    if index > 9 { index = 9 }
    return FishSource(index + 4)
}
