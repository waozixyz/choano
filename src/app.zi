toast: AchievementToast;
view: Rectangle;
view_scale: float32 = 1.0;
field: Playfield;
GameBounds :: (rect: Rectangle) -> Rectangle {
    return Rectangle.{view.x + rect.x * view_scale, view.y + rect.y * view_scale,
        rect.width * view_scale, rect.height * view_scale}
}
PauseClock :: () { last_tick = -1.0; held_input = .{} }
last_tick: float64 = -1.0;
held_input: GameInput;

// Only map observations here; MovePlayer owns key priority and normalization.
FrameMovement :: (frame: FrameInputSnapshot) -> GameInput {
    if !frame.available || !frame.focused { return .{} }
    return .{
        .left = ((frame.keys[KeyLeft] | frame.keys[65]) & cast(u8)FrameKeyHeld) != 0,
        .right = ((frame.keys[KeyRight] | frame.keys[68]) & cast(u8)FrameKeyHeld) != 0,
        .up = ((frame.keys[KeyUp] | frame.keys[87]) & cast(u8)FrameKeyHeld) != 0,
        .down = ((frame.keys[KeyDown] | frame.keys[83]) & cast(u8)FrameKeyHeld) != 0}
}
score_text: [16]u8;
lives_text: [16]u8;
frenzy_text: [24]u8;
stage_text: [48]u8;
size_text: [24]u8;
path_buffers: [16][128]u8;
path_buffer_index: s32;

CopyText :: (value: string, output: []u8, at: s32) -> s32 {
    index: s32 = 0
    while index < cast(s32)value.count && at < cast(s32)output.count {
        output[at] = value[index]
        index += 1
        at += 1
    }
    return at
}

FramePath :: (kind: string, side: string, stage: s32, frame: s32) -> string {
    if path_buffer_index >= 16 { path_buffer_index = 0 }
    path_buffer := path_buffers[path_buffer_index][:]
    at := CopyText("assets/choano/", path_buffer, 0)
    at = CopyText(kind, path_buffer, at)
    at = CopyText("-", path_buffer, at)
    at = CopyText(side, path_buffer, at)
    at = CopyText("-", path_buffer, at)
    digits: [12]u8
    at = CopyText(FormatInteger(cast(s64)StageSize(stage), digits[:]), path_buffer, at)
    at = CopyText("-", path_buffer, at)
    at = CopyText(FormatInteger(cast(s64)frame, digits[:]), path_buffer, at)
    at = CopyText(".png", path_buffer, at)
    if at < cast(s32)path_buffer.count { path_buffer[at] = cast(u8)0 }
    path_buffer_index += 1
    return TextUntilNul(path_buffer[:])
}
FrameCount :: (kind: string, stage: s32) -> s32 {
    if kind == "player" { return 4 }
    return 3
}

AnimationFrame :: (animation: float64, count: s32) -> s32 {
    frame := cast(s32)(animation * 8.0) % count
    if frame < 0 { frame += count }
    return frame
}

PaintOrganism :: (session: Session, kind: string, side: string, stage: s32, frame: s32,
    bounds: Rectangle, key: u64) {
    PaintCell(session, "assets/choano/organisms-hd.png", OrganismSource(kind, stage, frame), side, bounds, key)
}
// One cell of SHEET fitted into BOUNDS, mirrored when it faces left.
PaintCellTinted :: (session: Session, sheet: string, source: Rectangle, side: string, bounds: Rectangle,
    key: u64, tint: u32) {
    fitted := bounds
    if source.width > source.height {
        fitted.height = bounds.height * source.height / source.width
        fitted.y += (bounds.height - fitted.height) * .5
    } else {
        fitted.width = bounds.width * source.width / source.height
        fitted.x += (bounds.width - fitted.width) * .5
    }
    if side == "left" {
        points: [4]Vector2 = .[.{fitted.x + fitted.width, fitted.y}, .{fitted.x, fitted.y},
            .{fitted.x + fitted.width, fitted.y + fitted.height}, .{fitted.x, fitted.y + fitted.height}]
        unused Image(session, ImageProps.{.key = key, .asset_path = sheet,
            .bounds = fitted, .source = source, .smooth = true,
            .tint = tint, .mesh = ImageMesh.{.columns = 2, .rows = 2, .points = points[:]}})
    } else {
        unused Image(session, ImageProps.{.key = key, .asset_path = sheet,
            .bounds = fitted, .source = source, .smooth = true, .tint = tint, .fit = ImageFit.ImageFitStretch})
    }
}
PaintCell :: (session: Session, sheet: string, source: Rectangle, side: string, bounds: Rectangle, key: u64) {
    PaintCellTinted(session, sheet, source, side, bounds, key, 0)
}
// The player floats in its rest pose: a slow bob and breath, and a lean
// into its swim. The swim poses' stretching tails made it lurch about.
DrawPlayer :: (session: Session, side: string, stage: s32, animation: float64,
    velocity_y: float32, x: float32, y: float32, key: u64) {
    accessory := Shell.WearingAccessory()
    fish := game.mode == MODE_FISH
    size := ifx fish then FishVisualSize(stage) else cast(float32)StageSize(stage)
    source := ifx fish then FishSource(0) else OrganismSource("player", stage, 0)
    width := ifx fish then FitWidth(source, size) else size
    speed: float32 = ifx fish then FISH_SPEED else AMOEBA_PLAYER_SPEED
    pose := Presentation.FloatingPose(width, animation, velocity_y / speed, .04, x, y, side)
    FloatLayer(session, ifx fish then FISH_SHEET else "assets/choano/organisms-hd.png",
        source, width, pose, key, 0)
    accessory_pose := Headwear.HeadwearPose(pose, width, width * source.height / source.width, accessory, fish)
    FloatLayer(session, Accessories.PreviewAssetPath(accessory),
        Rectangle.{0.0, 0.0, cast(float32)Accessories.SOURCE_SIZE, cast(float32)Accessories.SOURCE_SIZE},
        Headwear.HeadwearSize(width, accessory), accessory_pose, key + 1, 0)
}

// Bounds enclose the rotated mesh so the image widget cannot clip its corners.
FloatLayer :: (session: Session, sheet: string, source: Rectangle, size: float32,
    pose: Presentation.FloatPose, key: u64, tint: u32) {
    points := Presentation.LayerPoints(pose, size, size * source.height / source.width)
    for index: 0..3 {
        points[index] = Vector2.{view.x + points[index].x * view_scale, view.y + points[index].y * view_scale}
    }
    unused Image(session, ImageProps.{.key = key, .asset_path = sheet,
        .bounds = Presentation.QuadBounds(points), .source = source,
        .smooth = true, .tint = tint, .mesh = ImageMesh.{.columns = 2, .rows = 2, .points = points[:]}})
}

FloatTinted :: (session: Session, sheet: string, source: Rectangle, side: string, size: float32, animation: float64,
    lean: float32, bob: float32, x: float32, y: float32, key: u64, tint: u32) {
    FloatLayer(session, sheet, source, size,
        Presentation.FloatingPose(size, animation, lean, bob, x, y, side), key, tint)
}
Float :: (session: Session, sheet: string, source: Rectangle, side: string, size: float32, animation: float64,
    lean: float32, bob: float32, x: float32, y: float32, key: u64) {
    FloatTinted(session, sheet, source, side, size, animation, lean, bob, x, y, key, 0)
}
DrawSea :: (session: Session) {
    unused Image(session, ImageProps.{.key = cast(u64)1, .asset_path = "assets/choano/fish/sea.png",
        .bounds = view, .fit = ImageFit.ImageFitStretch, .smooth = true})
    for index: cast(s32)0..game.enemy_count - 1 {
        enemy := game.enemies[index]
        key := cast(u64)(2000 + index)
        if enemy.kind == KIND_JELLY {
            source := FishSource(FISH_JELLY)
            Float(session, FISH_SHEET, source, "right", JELLY_SIZE, enemy.animation, 0.0, .08,
                enemy.x, enemy.y, key)
        } else if enemy.kind == KIND_SHARK {
            side := ifx enemy.velocity_x < 0.0 then "left" else "right"
            source := HunterSource(HUNTER_SHARK)
            pose := Presentation.FloatingPose(cast(float32)SHARK_LENGTH, enemy.animation,
                enemy.velocity_y / 60.0, .02, enemy.x, enemy.y, side)
            pose.scale_y *= SharkShape.SHARK_THICKNESS
            FloatLayer(session, HUNTER_SHEET, source, cast(float32)SHARK_LENGTH, pose, key, 0)
            if enemy.fin_flash > 0.0 { DrawSharkFins(session, enemy.fin_parts, pose, key + 10000) }
        } else if enemy.kind == KIND_SARDINE {
            side := ifx enemy.velocity_x < 0.0 then "left" else "right"
            source := HunterSource(HUNTER_SARDINE)
            size := cast(float32)SARDINE_SIZE * FISH_VISUAL_LENGTH * FOOD_VISUAL_SCALE
            Float(session, HUNTER_SHEET, source, side, size,
                enemy.animation, enemy.velocity_y / 40.0, .03, enemy.x, enemy.y, key)
        } else if SeaAnimal(enemy.kind) {
            source := AnimalSource(enemy.kind - KIND_SEAHORSE)
            side := ifx enemy.kind == KIND_STARFISH || enemy.velocity_x >= 0.0 then "right" else "left"
            // The starfish turns slowly about; the others lean into their bob.
            lean := enemy.velocity_y / 60.0
            if enemy.kind == KIND_STARFISH { lean = cast(float32)Trig.Sin(enemy.animation * .8 + cast(float64)enemy.phase) }
            bob: float32 = ifx enemy.kind == KIND_SEAHORSE then .02 else .01
            visual_size := FishVisualSize(enemy.stage) * FoodVisualScale(enemy.stage)
            FloatTinted(session, ANIMAL_SHEET, source, side, FitWidth(source, visual_size), enemy.animation, lean,
                bob, enemy.x, enemy.y, key, 0)
        } else if enemy.kind == KIND_TURTLE {
            side := ifx enemy.velocity_x < 0.0 then "left" else "right"
            Float(session, TURTLE_SHEET, TurtleSource(), side, cast(float32)TURTLE_WIDTH, enemy.animation * .5,
                enemy.velocity_y / 40.0, .01, enemy.x, enemy.y, key)
        } else if enemy.kind == KIND_PEARL {
            Float(session, FISH_SHEET, FishSource(FISH_PEARL), "right", PEARL_SIZE * FOOD_VISUAL_SCALE, enemy.animation * 2.0, 0.0, .1,
                enemy.x, enemy.y, key)
        } else {
            side := ifx enemy.velocity_x < 0.0 then "left" else "right"
            source := FishSource(4 + enemy.species % FISH_SPECIES)
            visual_size := FishVisualSize(enemy.stage) * FoodVisualScale(enemy.stage)
            FloatTinted(session, FISH_SHEET, source, side, FitWidth(source, visual_size),
                enemy.animation, enemy.velocity_y / 40.0, .03, enemy.x, enemy.y, key, 0)
        }
    }
}
DrawSprite :: (session: Session, kind: string, side: string, stage: s32, animation: float64,
    x: float32, y: float32, key: u64) {
    size := cast(float32)StageSize(stage) * FoodVisualScale(stage)
    frame := AnimationFrame(animation, FrameCount(kind, stage))
    bounds := GameBounds(Rectangle.{x - size * .5, y - size * .5, size, size})
    if kind == "enemy" && frame != 0 {
        pulse: float32 = ifx frame == 1 then .96 else 1.04
        bounds.x += bounds.width * (1.0 - pulse) * .5
        bounds.width *= pulse
    }
    PaintOrganism(session, kind, side, stage, frame, bounds, key)
}

DrawBlob :: (session: Session, animation: float64, x: float32, y: float32, key: u64) {
    frame := AnimationFrame(animation * .75, 6)
    if path_buffer_index >= 16 { path_buffer_index = 0 }
    path_buffer := path_buffers[path_buffer_index][:]
    at := CopyText("assets/choano/blob-", path_buffer, 0)
    digits: [12]u8
    at = CopyText(FormatInteger(cast(s64)frame, digits[:]), path_buffer, at)
    at = CopyText(".png", path_buffer, at)
    if at < cast(s32)path_buffer.count { path_buffer[at] = cast(u8)0 }
    path_buffer_index += 1
    unused Image(session, ImageProps.{.key = key, .asset_path = TextUntilNul(path_buffer[:]),
        .bounds = GameBounds(Rectangle.{x - 19.5, y - 19.5, 39.0, 39.0}),
        .fit = ImageFit.ImageFitStretch, .smooth = false})
}

DrawGame :: (session: Session, bounds: Rectangle) {
    world_clip := Scroll(session, ScrollProps.{.key = cast(u64)49100, .bounds = bounds,
        .content_height = cast(s32)bounds.height})
    if !world_clip.opened { return }
    defer { unused End(session) }

    field = FitPlayfield(bounds, game.mode)
    view = field.view
    view_scale = field.scale
    SetDishFrame(field.dish_half_height, field.dish_corner_radius, field.framed)
    if game.mode == MODE_FISH { SetSeaBounds(view.width / view_scale, view.height / view_scale) }
    path_buffer_index = 0
    if game.mode == MODE_FISH {
        DrawSea(session)
    } else {
        DrawDish(session)
    }
    // A bitten fish blinks while it is safe.
    if game.safe_timer > 0.0 && Trig.Sin(game.elapsed * 25.0) < 0.0 { return }
    side := ifx game.player_facing == 0 then "left" else "right"
    DrawPlayer(session, side, game.player_stage, game.player_animation, game.player_velocity_y,
        game.player_x, game.player_y, cast(u64)1000)
}

DrawFishHint :: (session: Session, bounds: Rectangle) {
    topic := cast(s32)((FISH_HINT_SECONDS - game.hint_timer) / 4.0)
    if topic > 2 { topic = 2 }
    if Tutorial.DrawGuide(session, bounds, topic) {
        game.hint_timer = FISH_HINT_SECONDS - cast(float64)(topic + 1) * 4.0
    }
}

DrawSharkFins :: (session: Session, parts: s32, pose: Presentation.FloatPose, key: u64) {
    for index: 0..2 {
        part := 1 << cast(s32)index
        if (parts & part) == 0 { continue }
        vertices := SharkShape.FinPolygon(part)
        points: [6]Vector2
        for at: 0..5 {
            world := Presentation.PosePoint(pose, .{(vertices[at].x - .5) * cast(float32)SHARK_LENGTH,
                (vertices[at].y - .5) * cast(float32)SHARK_LENGTH * SharkShape.SHARK_ASPECT})
            points[at] = .{view.x + world.x * view_scale, view.y + world.y * view_scale}
        }
        color := ColorFromPacked(0xff3b51c8)
        if part == SharkShape.FIN_TAIL {
            for triangle: 0..3 {
                unused Triangle(session, TriangleProps.{.key = key + cast(u64)index * 8 + cast(u64)triangle,
                    .first = points[triangle], .second = points[triangle + 1], .third = points[5], .color = color})
            }
        } else {
            unused Triangle(session, TriangleProps.{.key = key + cast(u64)index * 8,
                .first = points[0], .second = points[1], .third = points[2], .color = color})
            unused Triangle(session, TriangleProps.{.key = key + cast(u64)index * 8 + 1,
                .first = points[0], .second = points[2], .third = points[3], .color = color})
        }
    }
}

DrawDish :: (session: Session) {
    if field.framed {
        // The dish's plain ground covers the whole area, a soft white rim
        // rings the arena and the ground shows again inside it.
        unused Image(session, ImageProps.{.key = cast(u64)1, .asset_path = "assets/choano/background-inside.png",
            .bounds = field.area, .source = DishGround(), .fit = ImageFit.ImageFitCover, .smooth = true})
        unused Box(session, BoxProps.{.key = cast(u64)3, .bounds = field.outer_frame,
            .fill = ColorFromPacked(0xf5ffffe8), .radius = field.outer_radius})
        unused Image(session, ImageProps.{.key = cast(u64)4, .asset_path = "assets/choano/background-inside.png",
            .bounds = field.inner_playable, .source = DishGround(), .fit = ImageFit.ImageFitCover, .smooth = true,
            .radius = field.inner_radius})
    } else {
        unused Image(session, ImageProps.{.key = cast(u64)1, .asset_path = "assets/choano/background-inside.png",
            .bounds = view, .fit = ImageFit.ImageFitStretch, .smooth = false})
    }
    for index: cast(s32)0..game.enemy_count - 1 {
        enemy := game.enemies[index]
        if !enemy.active {
            DrawBlob(session, enemy.animation, enemy.x, enemy.y, cast(u64)(2400 + index))
        } else {
            enemy_side := ifx enemy.velocity_x < 0.0 then "left" else "right"
            DrawSprite(session, "enemy", enemy_side, enemy.stage, enemy.animation,
                enemy.x, enemy.y, cast(u64)(2000 + index))
        }
    }
}

// The score, lives and the next danger sit in the top bar, as in an arcade
// game, leaving the dish clear.
DrawHud :: (session: Session, bar: Rectangle) {
    unused WidgetPaletteUse(session, WidgetPalette.{.text = 0xffffffff})
    defer { unused WidgetPaletteRestore(session) }
    layout := Presentation.FitHud(bar)
    middle := bar.y + 25.0
    fish := game.mode == MODE_FISH
    if fish {
        layout.score_label.width = bar.width - 136.0
        layout.score_value.width = bar.width - 136.0
    }
    life := Rectangle.{bar.x + 12.0, bar.y + 51.0, 22.0, 22.0}
    if fish { PaintCell(session, FISH_SHEET, FishSource(0), "right", life, cast(u64)3020) }
    else { PaintOrganism(session, "player", "right", STAGE_FIRST, 0, life, cast(u64)3020) }
    lives := LivesRemaining()
    lives_digits: [12]u8
    at := CopyText("x", lives_text[:], 0)
    at = CopyText(FormatInteger(cast(s64)lives, lives_digits[:]), lives_text[:], at)
    if at < cast(s32)lives_text.count { lives_text[at] = cast(u8)0 }
    HudText(session, TextUntilNul(lives_text[:]), Rectangle.{bar.x + 38.0, bar.y + 51.0, 48.0, 22.0},
        cast(u64)3021, 20, TextAlign.TextAlignStart)
    if fish {
        size_digits: [12]u8
        at := CopyText("SIZE ", size_text[:], 0)
        at = CopyText(FormatInteger(cast(s64)game.player_stage, size_digits[:]), size_text[:], at)
        at = CopyText("/", size_text[:], at)
        at = CopyText(FormatInteger(cast(s64)PLAYER_STAGE_LAST, size_digits[:]), size_text[:], at)
        if at < cast(s32)size_text.count { size_text[at] = cast(u8)0 }
        HudText(session, TextUntilNul(size_text[:]), Rectangle.{bar.x + 94.0, bar.y + 52.0, bar.width - 106.0, 20.0},
            cast(u64)3022, 12, TextAlign.TextAlignStart)
    }

    label := "SCORE"
    if game.frenzy >= 2 {
        frenzy_digits: [12]u8
        at = CopyText("FRENZY x", frenzy_text[:], 0)
        at = CopyText(FormatInteger(cast(s64)game.frenzy, frenzy_digits[:]), frenzy_text[:], at)
        if at < cast(s32)frenzy_text.count { frenzy_text[at] = cast(u8)0 }
        label = TextUntilNul(frenzy_text[:])
    }
    label_font := Presentation.ScoreFont(layout.score_label.width, cast(s32)label.count)
    if label_font > 11 { label_font = 11 }
    HudText(session, label, layout.score_label, cast(u64)3010, label_font,
        TextAlign.TextAlignCenter)
    score_digits: [16]u8
    at = CopyText(FormatInteger(cast(s64)game.score, score_digits[:]), score_text[:], 0)
    if at < cast(s32)score_text.count { score_text[at] = cast(u8)0 }
    HudText(session, TextUntilNul(score_text[:]), layout.score_value,
        cast(u64)3011, Presentation.ScoreFont(layout.score_value.width, cast(s32)TextUntilNul(score_text[:]).count), TextAlign.TextAlignCenter)

    if fish { return }
    avoid_stage := game.player_stage + 1
    if avoid_stage > STAGE_LAST { avoid_stage = STAGE_LAST }
    right := bar.x + bar.width
    shark := KindCount(KIND_SHARK) > 0
    HudText(session, ifx shark then "SHARK!" else "AVOID", Rectangle.{right - 104.0, bar.y, 56.0, 49.0},
        cast(u64)3000, 12, TextAlign.TextAlignEnd)
    danger := Rectangle.{right - 42.0, middle - 15.0, 30.0, 30.0}
    if shark { PaintCell(session, HUNTER_SHEET, HunterSource(HUNTER_SHARK), "right", danger, cast(u64)3002) }
    else if fish { PaintCell(session, FISH_SHEET, FishSource(FISH_JELLY), "right", danger, cast(u64)3002) }
    else { PaintOrganism(session, "enemy", "right", avoid_stage, AnimationFrame(game.elapsed, 3), danger, cast(u64)3002) }
    if !fish { DrawGrowthMeter(session, bar) }
}

DrawGrowthMeter :: (session: Session, bar: Rectangle) {
    layout := Presentation.FitHud(bar)
    bounds := layout.growth_meter
    unused Box(session, BoxProps.{.key = cast(u64)3030, .bounds = bounds,
        .fill = ColorFromPacked(0x081d29f2), .border = ColorFromPacked(0x50758aff), .radius = 4.0})
    fill := bounds.width * GrowthMeter()
    if fill > 2.0 {
        unused Box(session, BoxProps.{.key = cast(u64)3031,
            .bounds = Rectangle.{bounds.x + 1.0, bounds.y + 1.0, fill - 2.0, bounds.height - 2.0},
            .fill = ColorFromPacked(0xffd080ff), .radius = 3.0})
    }
}

HudText :: (session: Session, text: string, bounds: Rectangle, key: u64, size: s32, align: TextAlign) {
    strong: [1]TextRange = .[.{0, cast(s32)text.count}]
    unused Text(session, TextProps.{.key = key, .bounds = bounds, .text = text, .font = size,
        .strong = strong[:], .align = align, .vertical_align = TextAlign.TextAlignCenter})
}

last_sound: s32;
last_sound_at: float64 = -1.0;
SoundRank :: (event: s32) -> s32 {
    if event == SOUND_GAME_OVER { return 6 }
    if event == SOUND_LOSE_LIFE { return 5 }
    if event == SOUND_EXTRA_LIFE { return 4 }
    if event == SOUND_GROW { return 3 }
    if event == SOUND_START { return 2 }
    if event == SOUND_EAT { return 1 }
    return 0
}
PlayEvents :: (session: Session, now: float64) {
    best: s32;
    for index: cast(s32)0..game.event_count - 1 {
        if SoundRank(game.events[index]) > SoundRank(best) { best = game.events[index] }
    }
    if best != 0 && !(best == last_sound && now - last_sound_at < .16) {
        unused SoundPlayEvent(session, best)
        last_sound = best
        last_sound_at = now
    }
    game.event_count = 0
}
UsePalette :: (session: Session) {
    unused Theme.Use(session, "src/choano.kss")
}
SetProfileAvailable :: (available: bool) { Shell.profile_available = available }
TakeProfileRequest :: () -> bool { return Shell.TakeProfile() }
SetDownloadsAvailable :: (available: bool) { Shell.downloads_available = available }
TakeDownloadsRequest :: () -> bool { return Shell.TakeDownloads() }
ProgressPlaying :: () -> bool { return Shell.HudVisible() }
NavigationPage :: () -> s32 { return Shell.Page() }
// Account progress that already reached full size unlocks Fish mode quietly
// on this device too.
AccountProgress :: (highest_stage: s32) {
    Shell.LoadPreferences()
    Shell.SyncAccessoryGrowth(highest_stage)
    if highest_stage >= PLAYER_STAGE_LAST { unused Shell.Unlock() }
}
// Account growth counts the amoeba dish only.
AmoebaStage :: () -> s32 { return ifx game.mode == MODE_AMOEBA then game.player_stage else 0 }
// The first full-size amoeba earns an achievement and unlocks Fish mode. A
// host with Waozi achievements records and announces it; otherwise Choano
// shows the same top-right toast itself. The run carries on either way.
AwardFullSize :: (now: float64) {
    if game.mode != MODE_AMOEBA || !Shell.Unlock() { return }
    #if #defined(CHOANO_PORTABLE) {
        answer := Clock.Service("entity.achievements",
            "{\"metric\":\"xyz.waozi.choano.full_size\",\"source\":\"full-size\",\"amount\":1}")
        if answer == "{\"status\":\"saved\"}" { return }
    }
    AchievementToastShow(*toast, "Achievement unlocked", "Full size! Fish mode unlocked", Trophy.Shape, now)
}
NavigateBack :: () -> bool {
    PauseClock()
    #if #defined(CHOANO_ACCOUNTS) && !#defined(PLATFORM_WEB) && !#defined(CHOANO_PORTABLE) {
        if Account.ProfileVisible() { Account.Back(); return true }
    }
    return Shell.Back()
}
CloseAccount :: () { Account.Close() }
ProfileHeader :: (session: Session, viewport: Rectangle) -> bool {
    UsePalette(session)
    defer { unused WidgetPaletteRestore(session) }
    return Shell.ProfileBar(session, viewport)
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    Account.Pump()
    #if !#defined(CHOANO_PORTABLE) && !#defined(PLATFORM_WEB) {
        progress_now := cast(float64)Clock.Milliseconds() / 1000.0
        unused Progress.ProgressPump(progress_now, AmoebaStage(), cast(s64)progress_now, !ProgressPlaying())
        if !ProgressPlaying() { AccountProgress(Progress.HighestStage()) }
    }
    #if #defined(ANDROID_BUILD) {
        Audio.AudioOpen()
        Audio.AudioBegin(session)
        defer { Audio.AudioEnd() }
    }
    UsePalette(session)
    defer { unused WidgetPaletteRestore(session) }
    // The sea runs behind the system bars; the game and Profile stay in viewport.
    full := viewport
    #if #defined(ANDROID_BUILD) || #defined(PLATFORM_ANDROID) || #defined(__ANDROID__) {
        full = AndroidWindowBounds()
    }
    unused Box(session, BoxProps.{.key = cast(u64)49000, .bounds = full,
        .fill = ColorFromPacked(0x051120ff)})
    held_input = FrameMovement(CaptureFrameInput(session))
    now := cast(float64)Clock.Milliseconds() / 1000.0
    #if #defined(CHOANO_PORTABLE) {
        key := Clock.PressedKey()
    } else {
        key := KeyboardTake(session)
    }
    #if !#defined(CHOANO_PORTABLE) && !#defined(PLATFORM_WEB) {
        Shell.profile_available = Account.Available()
        if Account.ProfileVisible() {
            PauseClock()
            unused Account.DrawProfile(session, viewport, key)
            return 0
        }
    }
    Shop.Pump(now)
    area := Shell.Begin(session, viewport, key, now, full)
    SoundSetMuted(session, Shell.muted)
    SoundMusic(session, Shell.Playing() && SharkAlert())
    if Shell.WantsBoard() { DrawGame(session, area) }
    if Shell.HudVisible() { DrawHud(session, Shell.bar) }
    Shell.End(session, now, game.over)
    #if !#defined(CHOANO_PORTABLE) && !#defined(PLATFORM_WEB) {
        if Shell.TakeProfile() { Progress.Reset(); Account.OpenProfile(); PauseClock() }
    }
    if Shell.HudVisible() && game.hint_timer > 0.0 { DrawFishHint(session, area) }
    unused AchievementToastDraw(session, *toast, AchievementToastProps.{.key = cast(u64)47000, .viewport = viewport,
        .top = 52.0, .now = now, .fill = ColorFromPacked(0x0a2438f2), .border = ColorFromPacked(0x80cbd8ff),
        .accent = ColorFromPacked(0xe0609aff)})
    if Shell.TakeStart() {
        StartGame(cast(u32)Clock.Milliseconds(), ifx Shell.FishRun() then MODE_FISH else MODE_AMOEBA)
        if Shell.TakeFishHint() { game.hint_timer = FISH_HINT_SECONDS }
        last_tick = now
        held_input = .{}
    }
    if !Shell.Playing() { last_tick = -1.0; return 0 }
    if (game.over && key == 257) || key == 82 || key == 114 {
        StartGame(cast(u32)Clock.Milliseconds(), game.mode)
        held_input = .{}
        Shell.ClearHeading()
    }
    input := held_input
    // Touch steers only while held; keys win in MovePlayer.
    input.steer_x = Shell.heading_x
    input.steer_y = Shell.heading_y
    if last_tick < 0.0 { last_tick = now }
    if now >= last_tick {
        UpdateGame(input, now - last_tick)
        if game.mode == MODE_AMOEBA { Shell.SyncAccessoryGrowth(game.player_stage) }
        if game.full_size { game.full_size = false; AwardFullSize(now) }
        PlayEvents(session, now)
        last_tick = now
    }
    return 0
}
