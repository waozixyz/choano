Nav :: #import "game2d/navigation";
Controls :: #import "game2d/controls";
Prefs :: #import "preferences";
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/button_props"
#import "kryon/button_widget"
#import "kryon/control_props"
#import "kryon/box_props"
#import "kryon/box_widget"
#import "kryon/text_props"
#import "kryon/text_widget"
#import "kryon/text_align"
#import "kryon/drawing_props"
#import "kryon/image_props"
#import "kryon/image_widget"
#import "kryon/direction_pad"
#import "kryon/joystick"

BAR_HEIGHT :: 52.0;

state: Nav.GameNavigation;
stick: Controls.GameStick;
// A held drag sets the heading in any direction, as Shovey and Wurm read
// their touch area; inside the dead zone or after release it is zero.
heading_x: float32;
heading_y: float32;
// The top bar; while playing, the app draws the score and lives in it.
bar: Rectangle;
loaded: bool;
muted: bool;
profile_available: bool;
profile_requested: bool;
// The website offers the release downloads from the title screen.
downloads_available: bool;
downloads_requested: bool;
start_requested: bool;
save_failed: bool;
// Reaching full size unlocks Fish mode, picked on the title screen; a run
// keeps the mode it started in.
fish_unlocked: bool;
fish: bool;
run_fish: bool;
// The Fish Dash button, beside the play area's touch controls.
dash_requested: bool;
area: Rectangle;

Save :: () {
    save_failed = !Prefs.Save(Prefs.Preferences.{.chosen = state.controls_selected,
        .pad = state.controls_mode == Nav.GAME_PAD, .muted = muted, .fish_unlocked = fish_unlocked, .fish = fish})
}
// True the first time; later calls, as from account progress, change nothing.
Unlock :: () -> bool {
    if fish_unlocked { return false }
    fish_unlocked = true
    Save()
    return true
}
Pick :: (value: bool) {
    if value == fish || (value && !fish_unlocked) { return }
    fish = value
    Save()
}
FishRun :: () -> bool { return run_fish }
TakeDash :: () -> bool { result := dash_requested; dash_requested = false; return result }
// This frame's touch heading. A release leaves it zero, letting the game coast.
Touch :: (held: bool, x: float32, y: float32) {
    heading_x = x; heading_y = y
}
Start :: () { if Nav.GameNavigationPlay(*state) { start_requested = true } }
Choose :: (mode: s32) {
    if Nav.GameNavigationChoose(*state, mode) { start_requested = true }
    stick.active = false
    Save()
}
TakeStart :: () -> bool {
    result := start_requested; start_requested = false
    if result { ClearHeading(); stick.active = false; run_fish = fish }
    return result
}
ClearHeading :: () { heading_x = 0.0; heading_y = 0.0 }
TakeProfile :: () -> bool { result := profile_requested; profile_requested = false; return result }
TakeDownloads :: () -> bool { result := downloads_requested; downloads_requested = false; return result }
Page :: () -> s32 { return state.page }
Playing :: () -> bool { return state.page == Nav.GAME_PLAYING }
WantsBoard :: () -> bool { return state.running && state.page != Nav.GAME_TITLE && state.page != Nav.GAME_SETTINGS }
Back :: () -> bool { stick.active = false; return Nav.GameNavigationBack(*state) }

Action :: (session: Session, key: u64, text: string, bounds: Rectangle) -> bool {
    return Button(session, ButtonProps.{.key = key, .id = cast(s32)key,
        .bounds = bounds, .label = text, .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0
}
RoundAction :: (session: Session, key: u64, text: string, bounds: Rectangle) -> bool {
    return Button(session, ButtonProps.{.key = key, .id = cast(s32)key, .bounds = bounds, .label = text,
        .pill = true, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0
}
// A game's top bar: deep water with a glowing edge, a rounded Back or Pause
// button and a bold centred title.
GameBar :: (session: Session, viewport: Rectangle, key: u64, title: string, leading: bool, playing: bool) -> bool {
    bounds := Rectangle.{viewport.x, viewport.y, viewport.width, BAR_HEIGHT}
    unused Box(session, BoxProps.{.key = key, .bounds = bounds, .fill = ColorFromPacked(0x0a2438ff)})
    if leading {
        unused Box(session, BoxProps.{.key = key + 1,
            .bounds = Rectangle.{bounds.x, bounds.y + BAR_HEIGHT - 3.0, bounds.width, 3.0},
            .fill = ColorFromPacked(0x80cbd8ff)})
    }
    if title.count > 0 {
        strong: [1]TextRange = .[.{0, cast(s32)title.count}]
        unused Text(session, TextProps.{.key = key + 2, .text = title, .font = 24, .strong = strong[:],
            .bounds = Rectangle.{bounds.x + 88.0, bounds.y, bounds.width - 176.0, BAR_HEIGHT - 3.0},
            .align = TextAlign.TextAlignCenter, .vertical_align = TextAlign.TextAlignCenter})
    }
    if !leading { return false }
    return RoundAction(session, key + 3, ifx playing then "Pause" else "Back",
        Rectangle.{bounds.x + 8.0, bounds.y + 5.0, 72.0, 40.0})
}
HudVisible :: () -> bool { return state.running && state.page == Nav.GAME_PLAYING }

Begin :: (session: Session, viewport: Rectangle, key: s32, now: float64) -> Rectangle {
    if !loaded {
        loaded = true
        saved := Prefs.Load()
        // Swipe until the player picks the pad in Settings.
        state.controls_selected = true
        state.controls_mode = ifx saved.pad then Nav.GAME_PAD else Nav.GAME_SWIPE
        muted = saved.muted
        fish_unlocked = fish_unlocked || saved.fish_unlocked
        fish = fish_unlocked && saved.fish
    }
    if key == 256 { unused Back() }
    else if key == 32 && state.page == Nav.GAME_PLAYING { Nav.GameNavigationPause(*state) }
    else if key == 257 && state.page == Nav.GAME_TITLE { Start() }
    else if (key == 263 || key == 262) && state.page == Nav.GAME_TITLE { Pick(key == 262) }
    else if state.page == Nav.GAME_CONTROLS && (key == 49 || key == 50) { Choose(key - 49) }
    else if key == 77 || key == 109 { muted = !muted; Save() }
    playing := HudVisible()
    settings_available := state.page != Nav.GAME_SETTINGS && state.page != Nav.GAME_CONTROLS && !playing
    trailing: s32 = ifx profile_available && !playing then 80 else 0
    if settings_available { trailing += 88 }
    // The home artwork carries the title; keep the action bar clear.
    title := ""
    if state.page == Nav.GAME_PAUSED { title = "PAUSED" }
    if state.page == Nav.GAME_SETTINGS { title = "SETTINGS" }
    if state.page == Nav.GAME_CONTROLS { title = "CONTROLS" }
    bar = Rectangle.{viewport.x, viewport.y, viewport.width, BAR_HEIGHT - 3.0}
    if GameBar(session, viewport, cast(u64)50000, title, state.page != Nav.GAME_TITLE, playing) { unused Back() }
    x := viewport.x + viewport.width - cast(float32)trailing
    if downloads_available && state.page == Nav.GAME_TITLE &&
    Action(session, cast(u64)50012, "Downloads", Rectangle.{x - 108.0, viewport.y + 6.0, 104.0, 40.0}) {
        downloads_requested = true
    }
    if profile_available && !playing {
        if Action(session, cast(u64)50010, "Profile", Rectangle.{x, viewport.y + 6.0, 76.0, 40.0}) {
            profile_requested = true
            Nav.GameNavigationPause(*state)
        }
        x += 80.0
    }
    if settings_available && Action(session, cast(u64)50011, "Settings", Rectangle.{x, viewport.y + 6.0, 80.0, 40.0}) {
        Nav.GameNavigationSettings(*state)
    }
    area = Rectangle.{viewport.x, viewport.y + BAR_HEIGHT, viewport.width, viewport.height - BAR_HEIGHT}
    return area
}

// Amoeba or Fish, side by side above Play. Fish stays greyed out, saying how
// to earn it, until a run reaches full size.
ModePicker :: (session: Session, bounds: Rectangle) {
    half := (bounds.width - 8.0) * .5
    if Mode(session, cast(u64)50120, "Amoeba", "", !fish, false, Rectangle.{bounds.x, bounds.y, half, bounds.height}) { Pick(false) }
    if Mode(session, cast(u64)50121, "Fish", ifx fish_unlocked then "" else "Reach full size", fish, !fish_unlocked,
        Rectangle.{bounds.x + half + 8.0, bounds.y, half, bounds.height}) { Pick(true) }
}
Mode :: (session: Session, key: u64, text: string, detail: string, selected: bool, locked: bool, bounds: Rectangle) -> bool {
    return Button(session, ButtonProps.{.key = key, .id = cast(s32)key, .bounds = bounds, .label = text,
        .detail = detail, .selected = selected, .disabled = locked, .pill = true,
        .emphasis = ifx selected then ButtonEmphasis.ButtonEmphasisFilled else ButtonEmphasis.ButtonEmphasisSoft}) != 0
}
Backdrop :: (session: Session) {
    if area.width <= 0.0 || area.height <= 0.0 { return }
    portrait := area.height > area.width
    path := ifx portrait then "assets/choano/title-portrait.jpg" else "assets/choano/title-landscape.jpg"
    if fish { path = ifx portrait then "assets/choano/fish/title-portrait.jpg" else "assets/choano/fish/title-landscape.jpg" }
    source := Rectangle.{0.0, 0.0, ifx portrait then 1024.0 else 1536.0, ifx portrait then 1536.0 else 1024.0}
    // Fill the area without bars, keeping the painted logo at the top.
    if area.width * source.height > area.height * source.width {
        source.height = source.width * area.height / area.width
    } else {
        width := source.height * area.width / area.height
        source.x = (source.width - width) * .5
        source.width = width
    }
    unused Image(session, ImageProps.{.key = cast(u64)50100, .asset_path = path,
        .bounds = area, .source = source, .fit = ImageFit.ImageFitStretch, .smooth = true})
}
MenuBounds :: (count: s32) -> Rectangle {
    width := area.width - 48.0
    if width > 300.0 { width = 300.0 }
    height := cast(float32)count * 54.0 + 32.0
    return Rectangle.{area.x + (area.width - width) * .5,
        area.y + (area.height - height) * .5, width, height}
}
Menu :: (session: Session, bounds: Rectangle) {
    unused Box(session, BoxProps.{.key = cast(u64)50200, .bounds = bounds,
        .fill = ColorFromPacked(0x051922ed), .border = ColorFromPacked(0x80cbd8ff), .radius = 22.0})
}
Row :: (session: Session, bounds: Rectangle, row: s32, text: string) -> bool {
    return Action(session, cast(u64)(50210 + row), text,
        Rectangle.{bounds.x + 16.0, bounds.y + 16.0 + cast(float32)row * 54.0, bounds.width - 32.0, 44.0})
}

End :: (session: Session, now: float64, over: bool) {
    if state.page == Nav.GAME_TITLE {
        Backdrop(session)
        width := area.width - 64.0
        if width > 280.0 { width = 280.0 }
        y := area.y + area.height * .75
        if y + 56.0 > area.y + area.height { y = area.y + area.height - 64.0 }
        x := area.x + (area.width - width) * .5
        resumable := state.running && !over && run_fish == fish
        if Action(session, cast(u64)50110, ifx resumable then "New game" else "Play", Rectangle.{x, y, width, 48.0}) { Start() }
        if resumable {
            y -= 58.0
            if Action(session, cast(u64)50111, "Continue", Rectangle.{x, y, width, 48.0}) { Nav.GameNavigationResume(*state) }
        }
        ModePicker(session, Rectangle.{x, y - 62.0, width, 52.0})
    } else if state.page == Nav.GAME_CONTROLS {
        if !WantsBoard() { Backdrop(session) }
        choice := Controls.GameControlsChoice(session, Controls.GameControlsProps.{.key = cast(u64)51000,
            .bounds = area, .now = now, .title = "Controls", .swipe_label = "Swipe", .pad_label = "Direction pad",
            .selected = ifx state.controls_selected then state.controls_mode else -1})
        if choice >= 0 { Choose(choice) }
    } else if state.page == Nav.GAME_PAUSED {
        bounds := MenuBounds(4)
        Menu(session, bounds)
        if Row(session, bounds, 0, ifx over then "Play again" else "Resume") {
            if over { start_requested = true }
            Nav.GameNavigationResume(*state)
        }
        if Row(session, bounds, 1, "Restart") { start_requested = true; Nav.GameNavigationResume(*state) }
        if Row(session, bounds, 2, "Settings") { Nav.GameNavigationSettings(*state) }
        if Row(session, bounds, 3, "Title screen") { Nav.GameNavigationHome(*state) }
    } else if state.page == Nav.GAME_SETTINGS {
        Backdrop(session)
        bounds := MenuBounds(3)
        Menu(session, bounds)
        if Row(session, bounds, 0, ifx state.controls_mode == Nav.GAME_PAD then "Controls: Direction pad" else "Controls: Swipe") { Nav.GameNavigationControls(*state) }
        if Row(session, bounds, 1, ifx muted then "Sound: Off" else "Sound: On") { muted = !muted; Save() }
        if Row(session, bounds, 2, "Back") { unused Back() }
        if save_failed {
            unused Text(session, TextProps.{.key = cast(u64)50220, .text = "Could not save settings",
                .bounds = Rectangle.{bounds.x, bounds.y + bounds.height + 8.0, bounds.width, 28.0}, .font = 14,
                .align = TextAlign.TextAlignCenter})
        }
    } else if over {
        bounds := MenuBounds(2)
        unused Text(session, TextProps.{.key = cast(u64)50230, .text = "Game over", .font = 26,
            .bounds = Rectangle.{bounds.x, bounds.y - 44.0, bounds.width, 36.0}, .align = TextAlign.TextAlignCenter})
        Menu(session, bounds)
        if Row(session, bounds, 0, "Play again") { start_requested = true }
        if Row(session, bounds, 1, "Title screen") { Nav.GameNavigationHome(*state) }
    } else if state.controls_mode == Nav.GAME_PAD {
        pad := DirectionPad(session, DirectionPadProps.{.key = cast(u64)52000,
            .bounds = DirectionPadBounds(area), .label = "Move", .now = now, .floating = true})
        Touch(pad.direction >= 0, ifx pad.direction == 0 then -1.0 else ifx pad.direction == 2 then 1.0 else 0.0,
            ifx pad.direction == 1 then -1.0 else ifx pad.direction == 3 then 1.0 else 0.0)
        DashButton(session)
        return
    } else {
        // Captured contact only, as Shovey and Wurm read it; the release-only
        // swipe result is unused. A tap never leans, so it does not move.
        gesture := SwipeArea(session, SwipeAreaProps.{.key = cast(u64)52010, .bounds = area,
            .label = "Move", .now = now, .min_distance = 6.0})
        // The heading points from where the press began, the centre that
        // SwipeFeedback draws; a reach of 0 keeps that anchor from following
        // a long drag, so pointing below the pad always swims down.
        steer := Controls.GameStickSteer(*stick, gesture.down, gesture.at_x, gesture.at_y, 8.0, 0.0)
        Touch(gesture.down, steer.x, steer.y)
        if gesture.down && !run_fish {
            // A thin unfilled dark ring, just outside SwipeFeedback's 56-unit
            // base, keeps the light feedback visible on the bright dish.
            ring: float32 = 60.0
            unused Box(session, BoxProps.{.key = cast(u64)52021,
                .bounds = Rectangle.{gesture.start_x - ring * .5, gesture.start_y - ring * .5, ring, ring},
                .border = ColorFromPacked(0x0a243899), .radius = ring * .5})
        }
        SwipeFeedback(session, SwipeFeedbackProps.{.key = cast(u64)52020, .gesture = gesture})
        DashButton(session)
        return
    }
    stick.active = false
    Touch(false, 0.0, 0.0)
}

// Fish mode's touch dash, at the bottom right, clear of the pad. Drawn after
// the touch area, it takes the presses there.
DashButton :: (session: Session) {
    if !run_fish { return }
    if RoundAction(session, cast(u64)52030, "Dash",
        Rectangle.{area.x + area.width - 104.0, area.y + area.height - 72.0, 88.0, 52.0}) { dash_requested = true }
}

ProfileBar :: (session: Session, viewport: Rectangle) -> bool {
    return GameBar(session, viewport, cast(u64)53000, "PROFILE", true, false)
}
