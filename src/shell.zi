Nav :: #import "game2d/navigation";
Controls :: #import "game2d/controls";
Prefs :: #import "preferences";
Accessories :: #import "accessories";
Sprites :: #import "sprites";
Presentation :: #import "presentation";
Math :: #import "std/math";
Words :: #import "ui_strings";
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/button_props"
#import "kryon/button_widget"
#import "kryon/control_props"
#import "kryon/box_props"
#import "kryon/box_widget"
#import "kryon/text_props"
#import "kryon/text_widget"
#import "kryon/text_measure"
#import "kryon/text_align"
#import "kryon/drawing_props"
#import "kryon/image_props"
#import "kryon/image_widget"
#import "kryon/widget_palette"
#import "kryon/direction_pad"
#import "kryon/joystick"
#if !#defined(CHOANO_PORTABLE) {
    #import "kryon/tree"
    #import "kryon/tree_input"
    #import "kryon/widget_kind"
}

BAR_HEIGHT :: 52.0;

ButtonStyle :: struct {
    fill: u32
    text: u32
}

BUTTON_NORMAL :: ButtonStyle.{.fill = 0xf7f2e8ff, .text = 0x10203fff};
BUTTON_SELECTED :: ButtonStyle.{.fill = 0xa82361ff, .text = 0xffffffff};
BUTTON_PRIMARY :: ButtonStyle.{.fill = 0xa82361ff, .text = 0xffffffff};
BUTTON_DISABLED :: ButtonStyle.{.fill = 0xe3e7eaff, .text = 0x243348ff};

TitleLayout :: struct {
    character_safe: Rectangle
    mode: Rectangle
    continue_button: Rectangle
    play: Rectangle
}

SettingsLayout :: struct {
    panel: Rectangle
    controls: Rectangle
    swipe: Rectangle
    pad: Rectangle
    sound: Rectangle
    sound_on: Rectangle
    sound_off: Rectangle
    done: Rectangle
}

state: Nav.GameNavigation;
stick: Controls.GameStick;
// A held drag sets the heading in any direction, as Shovey and Wurm read
// their touch area; inside the dead zone or after release it is zero.
heading_x: float32;
heading_y: float32;
// The top bar; while playing, the app draws the score and lives in it.
bar: Rectangle;
loaded: bool;
muted: bool;
profile_available: bool;
profile_requested: bool;
// The website offers the release downloads from the title screen.
downloads_available: bool;
downloads_requested: bool;
start_requested: bool;
save_failed: bool;
// Reaching full size unlocks Fish mode, picked on the title screen; a run
// keeps the mode it started in.
fish_unlocked: bool;
fish: bool;
run_fish: bool;
fish_hint_pending: bool = true;
accessory: s32;
accessories_owned: s32;
accessories_stage: s32;
wardrobe_unseen: bool;
wardrobe_open: bool;
fish_lock_message: bool;
area: Rectangle;
full_area: Rectangle;

Save :: () {
    save_failed = !Prefs.Save(Prefs.Preferences.{.chosen = state.controls_selected,
        .pad = state.controls_mode == Nav.GAME_PAD, .muted = muted, .fish_unlocked = fish_unlocked, .fish = fish,
        .accessory = accessory, .accessories_owned = accessories_owned, .accessories_stage = accessories_stage})
}
// True the first time; later calls, as from account progress, change nothing.
Unlock :: () -> bool {
    if fish_unlocked { return false }
    fish_unlocked = true
    Save()
    return true
}
Pick :: (value: bool) {
    if value == fish || (value && !fish_unlocked) { return }
    fish = value
    Save()
}
AccessoryAvailable :: (id: s32) -> bool { return Accessories.Available(accessories_stage, id) }
WearingAccessory :: () -> s32 {
    if AccessoryAvailable(accessory) { return accessory }
    return Accessories.ACCESSORY_HALO
}
SelectAccessory :: (id: s32) {
    if !AccessoryAvailable(id) { return }
    accessory = id
    Save()
}
SetAccessoryProgress :: (stage: s32) {
    previous_owned := accessories_owned
    record := Accessories.RecordForStage(stage)
    record.selected = ifx Accessories.Available(record.highest_stage, accessory) then accessory else Accessories.ACCESSORY_HALO
    accessory = record.selected
    accessories_owned = record.owned
    accessories_stage = record.highest_stage
    wardrobe_unseen = wardrobe_unseen || (record.owned & ~previous_owned) != 0
    Save()
}
SyncAccessoryGrowth :: (stage: s32) {
    if stage > accessories_stage { SetAccessoryProgress(stage) }
}
FishRun :: () -> bool { return run_fish }

TakeFishHint :: () -> bool {
    if !run_fish { return false }
    if !fish_hint_pending { return false }
    fish_hint_pending = false
    return true
}
// This frame's touch heading. A release leaves it zero, letting the game coast.
Touch :: (held: bool, x: float32, y: float32) {
    heading_x = x; heading_y = y
}
Start :: () { if Nav.GameNavigationPlay(*state) { start_requested = true } }
Choose :: (mode: s32) {
    if Nav.GameNavigationChoose(*state, mode) { start_requested = true }
    stick.active = false
    Save()
}
TakeStart :: () -> bool {
    result := start_requested; start_requested = false
    if result { ClearHeading(); stick.active = false; run_fish = fish }
    return result
}
ClearHeading :: () { heading_x = 0.0; heading_y = 0.0 }
TakeProfile :: () -> bool { result := profile_requested; profile_requested = false; return result }
TakeDownloads :: () -> bool { result := downloads_requested; downloads_requested = false; return result }
Page :: () -> s32 { return state.page }
Playing :: () -> bool { return state.page == Nav.GAME_PLAYING }
WantsBoard :: () -> bool { return state.running && state.page != Nav.GAME_TITLE && state.page != Nav.GAME_SETTINGS }
Back :: () -> bool { stick.active = false; return Nav.GameNavigationBack(*state) }

LinearChannel :: (value: u32) -> float32 {
    channel := cast(float32)value / 255.0
    if channel <= 0.04045 { return channel / 12.92 }
    return cast(float32)Math.Pow(cast(float64)((channel + 0.055) / 1.055), 2.4)
}

ButtonLuminance :: (color: u32) -> float32 {
    red := LinearChannel((color >> 24) & 0xff)
    green := LinearChannel((color >> 16) & 0xff)
    blue := LinearChannel(color & 0xff)
    return 0.2126 * red + 0.7152 * green + 0.0722 * blue
}

ButtonContrast :: (style: ButtonStyle) -> float32 {
    first := ButtonLuminance(style.fill) + 0.05
    second := ButtonLuminance(style.text) + 0.05
    if first < second { return second / first }
    return first / second
}

ButtonGlyphWidth :: (value: u8) -> float32 {
    if value == #char " " || value == #char "i" || value == #char "I" ||
        value == #char "l" || value == #char "j" || value == #char "t" ||
        value == #char "f" || value == #char "r" || value == #char "." ||
        value == #char "," || value == #char ":" || value == #char "'" { return 5.0 }
    if value == #char "m" || value == #char "w" || value == #char "W" || value == #char "M" { return 16.0 }
    return 10.0
}

ButtonWidth :: (text: string, minimum: float32 = 140.0, maximum: float32 = 320.0) -> float32 {
    width: float32 = 56.0
    for text { width += ButtonGlyphWidth(it) }
    if width < minimum { width = minimum }
    if width > maximum { width = maximum }
    return width
}

ActionButtonWidth :: (text: string) -> float32 {
    width: float32 = 24.0
    for text { width += ButtonGlyphWidth(it) }
    if width < 72.0 { width = 72.0 }
    return width
}

ButtonRadius :: (height: float32) -> float32 { return height * .5 }

TitleBackdropBounds :: (viewport: Rectangle) -> Rectangle { return viewport }

TitleLogoBounds :: (viewport: Rectangle) -> Rectangle {
    portrait := viewport.height > viewport.width
    margin: float32 = ifx portrait then 24.0 else 48.0
    width := viewport.width - margin * 2.0
    if width < 180.0 { width = viewport.width - 16.0 }
    if width < 120.0 { width = viewport.width }
    return Rectangle.{viewport.x + (viewport.width - width) * .5,
        viewport.y + 58.0, width, ifx width * .30 < viewport.height * .26 then width * .30 else viewport.height * .26}
}

WardrobeIconBounds :: (viewport: Rectangle) -> Rectangle {
    return Rectangle.{viewport.x + 8.0, viewport.y, 52.0, 52.0}
}

SettingsIconBounds :: (viewport: Rectangle) -> Rectangle {
    return Rectangle.{viewport.x + viewport.width - 60.0, viewport.y, 52.0, 52.0}
}

PlainButton :: (session: Session, key: u64, text: string, bounds: Rectangle,
    style: ButtonStyle, disabled: bool = false, hug_width: bool = true,
    mark: bool = false, show_text: bool = true, show_lock: bool = false) -> bool {
    if hug_width {
        width := ButtonWidth(text)
        bounds.x += (bounds.width - width) * .5
        bounds.width = width
    }
    fill := ifx disabled || show_lock then BUTTON_DISABLED.fill else style.fill
    textColor := ifx disabled || show_lock then BUTTON_DISABLED.text else style.text
    radius := ButtonRadius(bounds.height)
    shadowColor := (fill & 0xffffff00) | 0x33
    unused Box(session, BoxProps.{.key = key + 20000,
        .bounds = Rectangle.{bounds.x + 2.0, bounds.y + 3.0, bounds.width, bounds.height},
        .fill = ColorFromPacked(shadowColor), .radius = radius})
    unused Box(session, BoxProps.{.key = key + 21000, .bounds = bounds,
        .fill = ColorFromPacked(fill), .border = ColorFromPacked(0x10203f33), .radius = radius})
    font: s32 = 18
    padding: float32 = 14.0
    label_bounds := Rectangle.{bounds.x + padding, bounds.y, bounds.width - padding * 2.0, bounds.height}
    if mark || show_lock {
        label_bounds.x += 16.0
        label_bounds.width -= 16.0
    }
    if mark {
        // Draw the check as geometry; Android's bundled font has no tick glyph.
        for index: 0..8 {
            step := cast(float32)index
            x := bounds.x + 15.0 + step * 1.5
            y := bounds.y + bounds.height * .5 + (ifx index < 3 then step else 6.0 - step) * 1.5
            unused Box(session, BoxProps.{.key = key + 11000 + cast(u64)index,
                .bounds = Rectangle.{x, y, 3.0, 3.0}, .fill = ColorFromPacked(textColor), .radius = 1.5})
        }
    }
    if show_lock {
        unused Image(session, ImageProps.{.key = key + 11000,
            .asset_path = "assets/choano/lock.png", .alt_text = "Locked",
            .bounds = Rectangle.{bounds.x + 8.0, bounds.y + 12.0, 28.0, 28.0},
            .fit = ImageFit.ImageFitContain, .smooth = true})
    }
    if show_text {
        strong: [1]TextRange = .[.{0, cast(s32)text.count}]
        measured := cast(float32)TextWidth(session, TextProps.{.text = text, .font = font, .strong = strong[:]})
        if measured > label_bounds.width && measured > 0.0 {
            font = cast(s32)(cast(float32)font * label_bounds.width / measured)
            if font < 12 { font = 12 }
        }
        unused WidgetPaletteUse(session, WidgetPalette.{.background = fill, .base = fill,
            .text = textColor, .selected = fill, .selected_text = textColor,
            .border = 0x10203f33, .danger = textColor, .warning = textColor, .success = textColor})
        unused Text(session, TextProps.{.key = key + 10000, .text = text,
            .bounds = label_bounds, .font = font, .strong = strong[:], .align = TextAlign.TextAlignCenter,
            .vertical_align = TextAlign.TextAlignCenter})
        unused WidgetPaletteRestore(session)
    }
    return Button(session, ButtonProps.{.key = key, .id = cast(s32)key, .bounds = bounds,
        .label = text, .disabled = disabled, .invisible = true}) != 0
}

Action :: (session: Session, key: u64, text: string, bounds: Rectangle) -> bool {
    return PlainButton(session, key, text, bounds, BUTTON_NORMAL, false, false)
}

PrimaryAction :: (session: Session, key: u64, text: string, bounds: Rectangle) -> bool {
    return PlainButton(session, key, text, bounds, BUTTON_PRIMARY, false, false)
}

TitleLayoutFor :: (bounds: Rectangle, resumable: bool) -> TitleLayout {
    portrait := bounds.height > bounds.width
    safe_top := bounds.height * (ifx portrait then .24 else .22)
    safe_bottom := bounds.height * (ifx portrait then .63 else .58)
    mode_width: float32 = 320.0
    if mode_width > bounds.width - cast(float32)16.0 { mode_width = bounds.width - cast(float32)16.0 }
    bottom := bounds.y + bounds.height - cast(float32)16.0
    play_label := ifx resumable then "New game" else "Play"
    continue_width := ButtonWidth("Continue")
    play_width := ButtonWidth(play_label, 220.0)
    stack_height: float32 = 52.0 + 16.0 + 56.0
    if resumable { stack_height += 52.0 + 12.0 }
    top := bottom - stack_height
    mode := Rectangle.{bounds.x + (bounds.width - mode_width) * cast(float32).5, top, mode_width, cast(float32)52.0}
    mode.y = top
    mode.height = 52.0
    result := TitleLayout.{
        .mode = mode,
        .character_safe = Rectangle.{bounds.x + 8.0, bounds.y + safe_top, bounds.width - 16.0, safe_bottom - safe_top},
    }
    if resumable {
        result.continue_button = Rectangle.{bounds.x + (bounds.width - continue_width) * .5,
            mode.y + mode.height + 12.0, continue_width, 52.0}
        result.play = Rectangle.{bounds.x + (bounds.width - play_width) * .5,
            result.continue_button.y + result.continue_button.height + 16.0, play_width, 56.0}
    } else {
        result.play = Rectangle.{bounds.x + (bounds.width - play_width) * .5,
            mode.y + mode.height + 16.0, play_width, 56.0}
    }
    if result.character_safe.y + result.character_safe.height > result.mode.y {
        result.character_safe.height = result.mode.y - result.character_safe.y - 12.0
    }
    return result
}
RoundAction :: (session: Session, key: u64, text: string, bounds: Rectangle) -> bool {
    return PlainButton(session, key, text, bounds, BUTTON_NORMAL, false, false)
}

IconScale :: (hovered: bool, pressed: bool) -> float32 {
    if pressed { return .92 }
    return ifx hovered then 1.08 else 1.0
}

IconButton :: (session: Session, key: u64, bounds: Rectangle, path: string, label: string) -> bool {
    pressed := false
    hovered := false
    focused := false
    #if !#defined(CHOANO_PORTABLE) {
        previous := TreePrevious(session, TreeCurrentParent(session), key, cast(s32)WidgetKind.WidgetKindButton)
        pressed = TreePressedAt(session, previous)
        hovered = TreeHoveredAt(session, previous)
        focused = TreeFocusVisibleAt(session, previous)
    }
    icon := bounds
    scale := IconScale(hovered, pressed)
    icon.x += bounds.width * (1.0 - scale) * .5
    icon.y += bounds.height * (1.0 - scale) * .5
    icon.width *= scale
    icon.height *= scale
    if focused {
        unused Box(session, BoxProps.{.key = key + 30000, .bounds = bounds,
            .border = ColorFromPacked(0xffd8ee99), .radius = 26.0})
    }
    for layer: 0..2 {
        shadow := icon
        shadow.x += cast(float32)layer - 1.0
        shadow.y += 2.0 + cast(float32)layer
        unused Image(session, ImageProps.{.key = key + 31000 + cast(u64)layer,
            .asset_path = path, .bounds = shadow, .fit = ImageFit.ImageFitContain,
            .tint = 0x00000022, .smooth = true})
    }
    unused Image(session, ImageProps.{.key = key + 40000, .asset_path = path,
        .bounds = icon, .smooth = true, .alt_text = label,
        .tint = ifx pressed then cast(u32)0xd8d8d8ff else ifx hovered then cast(u32)0xffffffff else cast(u32)0xf0f0f0ff,
        .fit = ImageFit.ImageFitContain})
    return Button(session, ButtonProps.{.key = key, .id = cast(s32)key, .bounds = bounds,
        .label = label, .invisible = true}) != 0
}

WardrobeIconButton :: (session: Session, key: u64, bounds: Rectangle) -> bool {
    clicked := IconButton(session, key, bounds, "assets/choano/shop.png", Words.Shop(Words.Language()))
    if wardrobe_unseen {
        unused Box(session, BoxProps.{.key = key + 2,
            .bounds = Rectangle.{bounds.x + bounds.width - 14.0, bounds.y + 4.0, 12.0, 12.0},
            .fill = ColorFromPacked(0xa82361ff), .border = ColorFromPacked(0xffffffff), .radius = 6.0})
    }
    return clicked
}

TitleBackdrop :: (session: Session, viewport: Rectangle) {
    portrait := viewport.height > viewport.width
    path := ifx portrait then "assets/choano/title-portrait.jpg" else "assets/choano/title-landscape.jpg"
    if fish { path = ifx portrait then "assets/choano/fish/title-portrait.jpg" else "assets/choano/fish/title-landscape.jpg" }
    extension: u32 = ifx fish then cast(u32)0x06324dff else cast(u32)0x0d6b83ff
    unused Box(session, BoxProps.{.key = cast(u64)50100, .bounds = TitleBackdropBounds(viewport),
        .fill = ColorFromPacked(extension)})
    TitleArtwork(session, viewport, path, portrait, cast(u64)50101)
    unused Image(session, ImageProps.{.key = cast(u64)50102, .asset_path = "assets/choano/title-logo.png",
        .bounds = TitleLogoBounds(viewport), .fit = ImageFit.ImageFitContain, .smooth = true,
        .alt_text = "Choano"})
}
// Keep original JPEGs intact; the verified helper patches remove only the
// baked lettering. Both layers use the same cover transform, so they cannot
// stretch or drift apart when the surface changes shape.
TitleArtwork :: (session: Session, viewport: Rectangle, path: string, portrait: bool, key: u64) {
    unused Image(session, ImageProps.{.key = key, .asset_path = path,
        .bounds = viewport, .fit = ImageFit.ImageFitCover, .smooth = true,
        .alt_text = "Choano title artwork"})
    width: float32 = ifx portrait then 1024.0 else 1536.0
    height: float32 = ifx portrait then 1536.0 else 1024.0
    scale := viewport.width / width
    if viewport.height / height > scale { scale = viewport.height / height }
    region := ifx portrait then Rectangle.{64.0, 160.0, 896.0, 256.0} else Rectangle.{256.0, 64.0, 1024.0, 272.0}
    patch := ifx portrait then "assets/choano/title-clean-portrait.png" else "assets/choano/title-clean-landscape.png"
    if fish {
        region = ifx portrait then Rectangle.{32.0, 64.0, 960.0, 256.0} else Rectangle.{472.0, 16.0, 568.0, 160.0}
        patch = ifx portrait then "assets/choano/title-clean-fish-portrait.png" else "assets/choano/title-clean-fish-landscape.png"
    }
    unused Image(session, ImageProps.{.key = key + 100, .asset_path = patch,
        .bounds = Rectangle.{viewport.x + (viewport.width - width * scale) * .5 + region.x * scale,
            viewport.y + (viewport.height - height * scale) * .5 + region.y * scale,
            region.width * scale, region.height * scale},
        .fit = ImageFit.ImageFitContain, .smooth = true})
}

// A game's top bar with a compact pause icon during play.
GameBar :: (session: Session, viewport: Rectangle, key: u64, title: string, leading: bool, playing: bool) -> bool {
    height: float32 = ifx playing then 78.0 else BAR_HEIGHT
    bounds := Rectangle.{viewport.x, viewport.y, viewport.width, height}
    if !leading { return false }
    unused Box(session, BoxProps.{.key = key, .bounds = bounds, .fill = ColorFromPacked(0x0a2438ff)})
    if leading {
        unused Box(session, BoxProps.{.key = key + 1,
            .bounds = Rectangle.{bounds.x, bounds.y + height - 3.0, bounds.width, 3.0},
            .fill = ColorFromPacked(0x80cbd8ff)})
    }
    if title.count > 0 {
        strong: [1]TextRange = .[.{0, cast(s32)title.count}]
        unused Text(session, TextProps.{.key = key + 2, .text = title, .font = 24, .strong = strong[:],
            .bounds = Rectangle.{bounds.x + 88.0, bounds.y, bounds.width - 176.0, BAR_HEIGHT - 3.0},
            .align = TextAlign.TextAlignCenter, .vertical_align = TextAlign.TextAlignCenter})
    }
    if !leading { return false }
    if playing {
        pause := Presentation.PauseBounds(bounds)
        unused Box(session, BoxProps.{.key = key + 4, .bounds = pause,
            .fill = ColorFromPacked(0x173e55ff), .border = ColorFromPacked(0x80cbd888), .radius = 24.0})
        for index: 0..1 {
            unused Box(session, BoxProps.{.key = key + 5 + cast(u64)index,
                .bounds = Rectangle.{pause.x + 16.0 + cast(float32)index * 11.0, pause.y + 14.0, 5.0, 20.0},
                .fill = ColorFromPacked(0xffffffff), .radius = 1.5})
        }
        return Button(session, ButtonProps.{.key = key + 3, .id = cast(s32)(key + 3), .bounds = pause,
            .label = Words.Pause(Words.Language()), .invisible = true}) != 0
    }
    return RoundAction(session, key + 3, "Back",
        Rectangle.{bounds.x + 8.0, bounds.y, ActionButtonWidth("Back"), 52.0})
}
HudVisible :: () -> bool { return state.running && state.page == Nav.GAME_PLAYING }

LoadPreferences :: () {
    if !loaded {
        loaded = true
        saved := Prefs.Load()
        // Swipe until the player picks the pad in Settings.
        state.controls_selected = true
        state.controls_mode = ifx saved.pad then Nav.GAME_PAD else Nav.GAME_SWIPE
        muted = saved.muted
        fish_unlocked = fish_unlocked || saved.fish_unlocked
        fish = fish_unlocked && saved.fish
        accessory = saved.accessory
        accessories_owned = saved.accessories_owned
        accessories_stage = saved.accessories_stage
        if fish_unlocked && accessories_stage < 10 { SetAccessoryProgress(10) }
    }
}

Begin :: (session: Session, viewport: Rectangle, key: s32, now: float64, full_viewport: Rectangle = .{}) -> Rectangle {
    LoadPreferences()
    full_area = ifx full_viewport.width > 0.0 then full_viewport else viewport
    if key == 256 && wardrobe_open { wardrobe_open = false }
    else if key == 256 { unused Back() }
    else if key == 32 && state.page == Nav.GAME_PLAYING { Nav.GameNavigationPause(*state) }
    else if key == 257 && state.page == Nav.GAME_TITLE { Start() }
    else if (key == 263 || key == 262) && state.page == Nav.GAME_TITLE { Pick(key == 262) }
    else if state.page == Nav.GAME_CONTROLS && (key == 49 || key == 50) { Choose(key - 49) }
    else if key == 77 || key == 109 { muted = !muted; Save() }
    if state.page == Nav.GAME_SETTINGS { area = viewport; return area }
    playing := HudVisible()
    settings_available := state.page != Nav.GAME_SETTINGS && state.page != Nav.GAME_CONTROLS && !playing
    // The home artwork carries the title; keep the action bar clear.
    title := ""
    if state.page == Nav.GAME_PAUSED { title = "PAUSED" }
    if state.page == Nav.GAME_SETTINGS { title = "SETTINGS" }
    if state.page == Nav.GAME_CONTROLS { title = "CONTROLS" }
    bar_height: float32 = ifx playing then 78.0 else BAR_HEIGHT
    bar = Rectangle.{viewport.x, viewport.y, viewport.width, bar_height - 3.0}
    if state.page == Nav.GAME_TITLE { TitleBackdrop(session, ifx full_viewport.width > 0.0 then full_viewport else viewport) }
    if GameBar(session, viewport, cast(u64)50000, title, state.page != Nav.GAME_TITLE, playing) { unused Back() }
    right := viewport.x + viewport.width - 8.0
    action_y := viewport.y
    if state.page == Nav.GAME_TITLE {
        if WardrobeIconButton(session, cast(u64)50013, WardrobeIconBounds(viewport)) {
            wardrobe_open = true
            wardrobe_unseen = false
        }
    }
    if settings_available {
        settings_width: float32 = 52.0
        if IconButton(session, cast(u64)50011, SettingsIconBounds(viewport), "assets/choano/gear.png", Words.Settings(Words.Language())) {
            Nav.GameNavigationSettings(*state)
        }
        right -= settings_width + 8.0
    }
    downloads_width := ActionButtonWidth("Downloads")
    download_clicked := false
    if downloads_available && state.page == Nav.GAME_TITLE {
        download_clicked = Action(session, cast(u64)50012, "Downloads",
            Rectangle.{right - downloads_width, action_y, downloads_width, 52.0})
        if download_clicked { downloads_requested = true }
    }
    if downloads_available && state.page == Nav.GAME_TITLE { right -= downloads_width + cast(float32)8.0 }
    if profile_available && !playing {
        profile_width := ActionButtonWidth("Profile")
        if Action(session, cast(u64)50010, "Profile", Rectangle.{right - profile_width, action_y, profile_width, 52.0}) {
            profile_requested = true
            Nav.GameNavigationPause(*state)
        }
        right -= profile_width + 8.0
    }
    area = Rectangle.{viewport.x, viewport.y + bar_height, viewport.width, viewport.height - bar_height}
    return area
}

// Amoeba or Fish, side by side above Play. Fish stays greyed out, saying how
// to earn it, until a run reaches full size.
ModePicker :: (session: Session, bounds: Rectangle) {
    half := bounds.width * .5
    if Mode(session, cast(u64)50120, "Amoeba", !fish, false,
        Rectangle.{bounds.x, bounds.y, half, bounds.height}) { Pick(false) }
    if Mode(session, cast(u64)50121, "Fish", fish, !fish_unlocked,
        Rectangle.{bounds.x + half, bounds.y, half, bounds.height}) {
        if fish_unlocked { Pick(true) } else { fish_lock_message = true }
    }
    if !fish_unlocked && fish_lock_message {
        hint := Rectangle.{bounds.x, bounds.y - 44.0, bounds.width, 40.0}
        unused Box(session, BoxProps.{.key = cast(u64)50123, .bounds = hint,
            .fill = ColorFromPacked(0x0a2438ee), .radius = 10.0})
        unused WidgetPaletteUse(session, WidgetPalette.{.text = 0xffffffff})
        unused Text(session, TextProps.{.key = cast(u64)50122, .text = Words.FishUnlock(Words.Language()),
            .bounds = Rectangle.{hint.x + 8.0, hint.y + 4.0, hint.width - 16.0, 32.0},
            .font = 12, .align = TextAlign.TextAlignCenter, .vertical_align = TextAlign.TextAlignCenter})
        unused WidgetPaletteRestore(session)
    }
}

Mode :: (session: Session, key: u64, text: string, selected: bool, locked: bool, bounds: Rectangle) -> bool {
    active := selected && !locked
    return PlainButton(session, key, text, bounds, ifx active then BUTTON_SELECTED else BUTTON_NORMAL,
        false, false, active, true, locked)
}
ArtworkBackdrop :: (session: Session, bounds: Rectangle) {
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return }
    portrait := bounds.height > bounds.width
    path := ifx portrait then "assets/choano/title-portrait.jpg" else "assets/choano/title-landscape.jpg"
    if fish { path = ifx portrait then "assets/choano/fish/title-portrait.jpg" else "assets/choano/fish/title-landscape.jpg" }
    extension: u32 = ifx fish then cast(u32)0x06324dff else cast(u32)0x0d6b83ff
    unused Box(session, BoxProps.{.key = cast(u64)50100, .bounds = bounds,
        .fill = ColorFromPacked(extension)})
    TitleArtwork(session, bounds, path, portrait, cast(u64)50101)
}
Backdrop :: (session: Session) { ArtworkBackdrop(session, area) }

SettingsLayoutFor :: (viewport: Rectangle) -> SettingsLayout {
    width := viewport.width - 32.0
    if width > 480.0 { width = 480.0 }
    height: float32 = 344.0
    if height > viewport.height - 24.0 { height = viewport.height - 24.0 }
    panel := Rectangle.{viewport.x + (viewport.width - width) * .5,
        viewport.y + (viewport.height - height) * .5, width, height}
    compact := height < 328.0
    first: float32 = ifx compact then 78.0 else 108.0
    second: float32 = ifx compact then 156.0 else 200.0
    row_height: float32 = ifx compact then 44.0 else 48.0
    half := (width - 56.0) * .5
    return SettingsLayout.{.panel = panel,
        .controls = Rectangle.{panel.x + 24.0, panel.y + first - 28.0, width - 48.0, 24.0},
        .swipe = Rectangle.{panel.x + 24.0, panel.y + first, half, row_height},
        .pad = Rectangle.{panel.x + 32.0 + half, panel.y + first, half, row_height},
        .sound = Rectangle.{panel.x + 24.0, panel.y + second - 28.0, width - 48.0, 24.0},
        .sound_on = Rectangle.{panel.x + 24.0, panel.y + second, half, row_height},
        .sound_off = Rectangle.{panel.x + 32.0 + half, panel.y + second, half, row_height},
        .done = Rectangle.{panel.x + (width - 140.0) * .5, panel.y + height - 64.0, 140.0, 48.0}}
}

SettingsPage :: (session: Session) {
    ArtworkBackdrop(session, full_area)
    unused Box(session, BoxProps.{.key = cast(u64)50400, .bounds = full_area,
        .fill = ColorFromPacked(0x071b3066)})
    layout := SettingsLayoutFor(area)
    panel := layout.panel
    unused Box(session, BoxProps.{.key = cast(u64)50401,
        .bounds = Rectangle.{panel.x, panel.y + 5.0, panel.width, panel.height},
        .fill = ColorFromPacked(0x071b3055), .radius = 24.0})
    unused Box(session, BoxProps.{.key = cast(u64)50402, .bounds = panel,
        .fill = ColorFromPacked(0xf7f2e8ff), .radius = 24.0})
    unused WidgetPaletteUse(session, WidgetPalette.{.text = 0x10203fff})
    words := Words.SettingsLabels(Words.Language())
    title := Words.Settings(Words.Language())
    strong: [1]TextRange = .[.{0, cast(s32)title.count}]
    unused Image(session, ImageProps.{.key = cast(u64)50403, .asset_path = "assets/choano/gear.png",
        .bounds = Rectangle.{panel.x + 24.0, panel.y + 14.0, 40.0, 40.0},
        .fit = ImageFit.ImageFitContain, .smooth = true})
    unused Text(session, TextProps.{.key = cast(u64)50404, .text = title, .font = 26, .strong = strong[:],
        .bounds = Rectangle.{panel.x + 76.0, panel.y + 14.0, panel.width - 100.0, 40.0},
        .vertical_align = TextAlign.TextAlignCenter})
    unused Text(session, TextProps.{.key = cast(u64)50405, .text = words.controls, .font = 16, .bounds = layout.controls})
    unused Text(session, TextProps.{.key = cast(u64)50406,
        .text = ifx save_failed then words.save_error else words.sound, .font = 16, .bounds = layout.sound})
    if Mode(session, cast(u64)50410, words.swipe, state.controls_mode == Nav.GAME_SWIPE, false, layout.swipe) {
        state.controls_mode = Nav.GAME_SWIPE; state.controls_selected = true; Save()
    }
    if Mode(session, cast(u64)50411, words.pad, state.controls_mode == Nav.GAME_PAD, false, layout.pad) {
        state.controls_mode = Nav.GAME_PAD; state.controls_selected = true; Save()
    }
    if Mode(session, cast(u64)50412, words.sound_on, !muted, false, layout.sound_on) { muted = false; Save() }
    if Mode(session, cast(u64)50413, words.sound_off, muted, false, layout.sound_off) { muted = true; Save() }
    if PrimaryAction(session, cast(u64)50414, words.done, layout.done) { unused Back() }
    unused WidgetPaletteRestore(session)
}
MenuBounds :: (count: s32) -> Rectangle {
    width := area.width - 48.0
    if width > 320.0 { width = 320.0 }
    if width < 220.0 { width = 220.0 }
    height := cast(float32)count * 60.0 + 32.0
    return Rectangle.{area.x + (area.width - width) * .5,
        area.y + (area.height - height) * .5, width, height}
}
Menu :: (session: Session, bounds: Rectangle) {
    unused Box(session, BoxProps.{.key = cast(u64)50200, .bounds = bounds,
        .fill = ColorFromPacked(0x051922ed), .border = ColorFromPacked(0x80cbd8ff), .radius = 22.0})
}
Row :: (session: Session, bounds: Rectangle, row: s32, text: string, primary: bool) -> bool {
    button_bounds := Rectangle.{bounds.x + 16.0, bounds.y + 16.0 + cast(float32)row * 60.0,
        bounds.width - 32.0, 52.0}
    if primary { return PrimaryAction(session, cast(u64)(50210 + row), text, button_bounds) }
    return Action(session, cast(u64)(50210 + row), text, button_bounds)
}

End :: (session: Session, now: float64, over: bool) {
    if wardrobe_open {
        Wardrobe(session)
    } else if state.page == Nav.GAME_TITLE {
        resumable := state.running && !over && run_fish == fish
        layout := TitleLayoutFor(area, resumable)
        ModePicker(session, layout.mode)
        if resumable && Action(session, cast(u64)50111, "Continue", layout.continue_button) {
            Nav.GameNavigationResume(*state)
        }
        if PrimaryAction(session, cast(u64)50110, ifx resumable then "New game" else "Play", layout.play) { Start() }
    } else if state.page == Nav.GAME_CONTROLS {
        if !WantsBoard() { Backdrop(session) }
        choice := Controls.GameControlsChoice(session, Controls.GameControlsProps.{.key = cast(u64)51000,
            .bounds = area, .now = now, .title = "Controls", .swipe_label = "Swipe", .pad_label = "Direction pad",
            .selected = ifx state.controls_selected then state.controls_mode else -1})
        if choice >= 0 { Choose(choice) }
    } else if state.page == Nav.GAME_PAUSED {
        bounds := MenuBounds(4)
        Menu(session, bounds)
        if Row(session, bounds, 0, ifx over then "Play again" else "Resume", over) {
            if over { start_requested = true }
            Nav.GameNavigationResume(*state)
        }
        if Row(session, bounds, 1, "Restart", false) { start_requested = true; Nav.GameNavigationResume(*state) }
        if Row(session, bounds, 2, "Settings", false) { Nav.GameNavigationSettings(*state) }
        if Row(session, bounds, 3, "Title screen", false) { Nav.GameNavigationHome(*state) }
    } else if state.page == Nav.GAME_SETTINGS {
        SettingsPage(session)
    } else if over {
        bounds := MenuBounds(2)
        unused Text(session, TextProps.{.key = cast(u64)50230, .text = "Game over", .font = 26,
            .bounds = Rectangle.{bounds.x, bounds.y - 44.0, bounds.width, 36.0}, .align = TextAlign.TextAlignCenter})
        Menu(session, bounds)
        if Row(session, bounds, 0, "Play again", true) { start_requested = true }
        if Row(session, bounds, 1, "Title screen", false) { Nav.GameNavigationHome(*state) }
    } else if state.controls_mode == Nav.GAME_PAD {
        pad := DirectionPad(session, DirectionPadProps.{.key = cast(u64)52000,
            .bounds = DirectionPadBounds(area), .label = "Move", .now = now, .floating = true})
        Touch(pad.direction >= 0, ifx pad.direction == 0 then -1.0 else ifx pad.direction == 2 then 1.0 else 0.0,
            ifx pad.direction == 1 then -1.0 else ifx pad.direction == 3 then 1.0 else 0.0)
        return
    } else {
        // Captured contact only, as Shovey and Wurm read it; the release-only
        // swipe result is unused. A tap never leans, so it does not move.
        gesture := SwipeArea(session, SwipeAreaProps.{.key = cast(u64)52010, .bounds = area,
            .label = "Move", .now = now, .min_distance = 6.0})
        // The heading points from where the press began, the centre that
        // SwipeFeedback draws; a reach of 0 keeps that anchor from following
        // a long drag, so pointing below the pad always swims down.
        steer := Controls.GameStickSteer(*stick, gesture.down, gesture.at_x, gesture.at_y, 8.0, 0.0)
        Touch(gesture.down, steer.x, steer.y)
        if gesture.down && !run_fish {
            // A thin unfilled dark ring, just outside SwipeFeedback's 56-unit
            // base, keeps the light feedback visible on the bright dish.
            ring: float32 = 60.0
            unused Box(session, BoxProps.{.key = cast(u64)52021,
                .bounds = Rectangle.{gesture.start_x - ring * .5, gesture.start_y - ring * .5, ring, ring},
                .border = ColorFromPacked(0x0a243899), .radius = ring * .5})
        }
        SwipeFeedback(session, SwipeFeedbackProps.{.key = cast(u64)52020, .gesture = gesture})
        return
    }
    stick.active = false
    Touch(false, 0.0, 0.0)
}

Wardrobe :: (session: Session) {
    bounds := Presentation.ShopBounds(area)
    width := bounds.width
    words := Words.ShopLabels(Words.Language())
    unused Box(session, BoxProps.{.key = cast(u64)50300, .bounds = bounds,
        .fill = ColorFromPacked(0x051922fa), .border = ColorFromPacked(0x80cbd8ff), .radius = 26.0})
    unused WidgetPaletteUse(session, WidgetPalette.{.text = 0xe6f3ffff})
    unused Text(session, TextProps.{.key = cast(u64)50301, .text = Words.Shop(Words.Language()), .font = 24,
        .bounds = Rectangle.{bounds.x + 26.0, bounds.y + 14.0, width - 122.0, 32.0}})
    close_width := ActionButtonWidth(words.close)
    if RoundAction(session, cast(u64)50302, words.close, Rectangle.{bounds.x + width - close_width - 16.0,
        bounds.y + 8.0, close_width, 52.0}) {
        wardrobe_open = false
    }
    for id: cast(s32)0..Accessories.ACCESSORY_COUNT - 1 {
        card := Presentation.ShopCard(bounds, id)
        if AccessoryCard(session, id, card, bounds.width < 420.0) { SelectAccessory(id) }
    }
    unused WidgetPaletteRestore(session)
}

AccessoryCard :: (session: Session, id: s32, bounds: Rectangle, stacked: bool) -> bool {
    selected := accessory == id
    words := Words.ShopLabels(Words.Language())
    layout := Presentation.FitAccessory(bounds, stacked)
    unused Box(session, BoxProps.{.key = cast(u64)(50320 + id), .bounds = bounds,
        .fill = ifx selected then ColorFromPacked(0x123b52fa) else ColorFromPacked(0x0a2838fa),
        .border = ifx selected then ColorFromPacked(0xff8bc3ff) else ColorFromPacked(0x80cbd8cc), .radius = 20.0})
    preview := layout.preview
    size := preview.width
    unused Box(session, BoxProps.{.key = cast(u64)(50330 + id), .bounds = preview,
        .fill = ColorFromPacked(0x0d3f57e8), .border = ColorFromPacked(0x54d2ec66), .radius = size * .5})
    tint := ifx locked(id) then cast(u32)0x8ea3adb0 else 0
    player_source := Sprites.OrganismSource("player", 1, 0)
    player_preview := preview
    accessory_preview := preview
    if id == Accessories.ACCESSORY_HALO {
        player_preview = Rectangle.{preview.x + size * .12, preview.y + size * .30, size * .76, size * .76}
        accessory_preview = Rectangle.{preview.x + size * .12, preview.y - size * .24, size * .76, size * .76}
    }
    unused Image(session, ImageProps.{.key = cast(u64)(50340 + id), .asset_path = "assets/choano/organisms-hd.png",
        .bounds = player_preview, .source = player_source, .smooth = true, .tint = tint,
        .fit = ImageFit.ImageFitContain})
    unused Image(session, ImageProps.{.key = cast(u64)(50350 + id), .asset_path = Accessories.PreviewAssetPath(id),
        .bounds = accessory_preview, .source = Rectangle.{0.0, 0.0, cast(float32)Accessories.SOURCE_SIZE,
            cast(float32)Accessories.SOURCE_SIZE}, .smooth = true, .tint = tint,
        .fit = ImageFit.ImageFitStretch})
    locked := !AccessoryAvailable(id)
    name := words.halo
    requirement := words.halo_requirement
    if id == Accessories.ACCESSORY_RIBBON { name = words.ribbon; requirement = words.ribbon_requirement }
    if id == Accessories.ACCESSORY_CROWN { name = words.crown; requirement = words.crown_requirement }
    clicked := PlainButton(session, cast(u64)(50360 + id), name, layout.button,
        ifx selected then BUTTON_SELECTED else BUTTON_NORMAL, locked, false, selected)
    unused Text(session, TextProps.{.key = cast(u64)(50370 + id), .text = requirement,
        .bounds = layout.requirement, .font = 12, .align = TextAlign.TextAlignCenter,
        .vertical_align = TextAlign.TextAlignCenter})
    if clicked { return true }
    return false
}

locked :: (id: s32) -> bool { return !AccessoryAvailable(id) }

ProfileBar :: (session: Session, viewport: Rectangle) -> bool {
    return GameBar(session, viewport, cast(u64)53000, "PROFILE", true, false)
}
