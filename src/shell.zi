Nav :: #import "game2d/navigation";
Controls :: #import "game2d/controls";
Prefs :: #import "preferences";
Accessories :: #import "accessories";
Sprites :: #import "sprites";
Math :: #import "std/math";
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/button_props"
#import "kryon/button_widget"
#import "kryon/control_props"
#import "kryon/box_props"
#import "kryon/box_widget"
#import "kryon/text_props"
#import "kryon/text_widget"
#import "kryon/text_align"
#import "kryon/drawing_props"
#import "kryon/image_props"
#import "kryon/image_widget"
#import "kryon/widget_palette"
#import "kryon/direction_pad"
#import "kryon/joystick"

BAR_HEIGHT :: 52.0;

ButtonStyle :: struct {
    fill: u32
    text: u32
}

BUTTON_NORMAL :: ButtonStyle.{.fill = 0xf7f2e8ff, .text = 0x10203fff};
BUTTON_SELECTED :: ButtonStyle.{.fill = 0xa82361ff, .text = 0xffffffff};
BUTTON_PRIMARY :: ButtonStyle.{.fill = 0xa82361ff, .text = 0xffffffff};
BUTTON_DISABLED :: ButtonStyle.{.fill = 0xe3e7eaff, .text = 0x243348ff};

TitleLayout :: struct {
    character_safe: Rectangle
    mode: Rectangle
    wardrobe: Rectangle
    continue_button: Rectangle
    play: Rectangle
}

state: Nav.GameNavigation;
stick: Controls.GameStick;
// A held drag sets the heading in any direction, as Shovey and Wurm read
// their touch area; inside the dead zone or after release it is zero.
heading_x: float32;
heading_y: float32;
// The top bar; while playing, the app draws the score and lives in it.
bar: Rectangle;
loaded: bool;
muted: bool;
profile_available: bool;
profile_requested: bool;
// The website offers the release downloads from the title screen.
downloads_available: bool;
downloads_requested: bool;
start_requested: bool;
save_failed: bool;
// Reaching full size unlocks Fish mode, picked on the title screen; a run
// keeps the mode it started in.
fish_unlocked: bool;
fish: bool;
run_fish: bool;
accessory: s32;
accessories_owned: s32;
accessories_stage: s32;
wardrobe_open: bool;
// The Fish Dash button, beside the play area's touch controls.
dash_requested: bool;
area: Rectangle;

Save :: () {
    save_failed = !Prefs.Save(Prefs.Preferences.{.chosen = state.controls_selected,
        .pad = state.controls_mode == Nav.GAME_PAD, .muted = muted, .fish_unlocked = fish_unlocked, .fish = fish,
        .accessory = accessory, .accessories_owned = accessories_owned, .accessories_stage = accessories_stage})
}
// True the first time; later calls, as from account progress, change nothing.
Unlock :: () -> bool {
    if fish_unlocked { return false }
    fish_unlocked = true
    Save()
    return true
}
Pick :: (value: bool) {
    if value == fish || (value && !fish_unlocked) { return }
    fish = value
    Save()
}
AccessoryAvailable :: (id: s32) -> bool { return Accessories.Available(accessories_stage, id) }
WearingAccessory :: () -> s32 {
    if AccessoryAvailable(accessory) { return accessory }
    return Accessories.ACCESSORY_HALO
}
SelectAccessory :: (id: s32) {
    if !AccessoryAvailable(id) { return }
    accessory = id
    Save()
}
SetAccessoryProgress :: (stage: s32) {
    record := Accessories.RecordForStage(stage)
    record.selected = ifx Accessories.Available(record.highest_stage, accessory) then accessory else Accessories.ACCESSORY_HALO
    accessory = record.selected
    accessories_owned = record.owned
    accessories_stage = record.highest_stage
    Save()
}
SyncAccessoryGrowth :: (stage: s32) {
    if stage > accessories_stage { SetAccessoryProgress(stage) }
}
FishRun :: () -> bool { return run_fish }

TakeDash :: () -> bool { result := dash_requested; dash_requested = false; return result }
// This frame's touch heading. A release leaves it zero, letting the game coast.
Touch :: (held: bool, x: float32, y: float32) {
    heading_x = x; heading_y = y
}
Start :: () { if Nav.GameNavigationPlay(*state) { start_requested = true } }
Choose :: (mode: s32) {
    if Nav.GameNavigationChoose(*state, mode) { start_requested = true }
    stick.active = false
    Save()
}
TakeStart :: () -> bool {
    result := start_requested; start_requested = false
    if result { ClearHeading(); stick.active = false; run_fish = fish }
    return result
}
ClearHeading :: () { heading_x = 0.0; heading_y = 0.0 }
TakeProfile :: () -> bool { result := profile_requested; profile_requested = false; return result }
TakeDownloads :: () -> bool { result := downloads_requested; downloads_requested = false; return result }
Page :: () -> s32 { return state.page }
Playing :: () -> bool { return state.page == Nav.GAME_PLAYING }
WantsBoard :: () -> bool { return state.running && state.page != Nav.GAME_TITLE && state.page != Nav.GAME_SETTINGS }
Back :: () -> bool { stick.active = false; return Nav.GameNavigationBack(*state) }

LinearChannel :: (value: u32) -> float32 {
    channel := cast(float32)value / 255.0
    if channel <= 0.04045 { return channel / 12.92 }
    return cast(float32)Math.Pow(cast(float64)((channel + 0.055) / 1.055), 2.4)
}

ButtonLuminance :: (color: u32) -> float32 {
    red := LinearChannel((color >> 24) & 0xff)
    green := LinearChannel((color >> 16) & 0xff)
    blue := LinearChannel(color & 0xff)
    return 0.2126 * red + 0.7152 * green + 0.0722 * blue
}

ButtonContrast :: (style: ButtonStyle) -> float32 {
    first := ButtonLuminance(style.fill) + 0.05
    second := ButtonLuminance(style.text) + 0.05
    if first < second { return second / first }
    return first / second
}

ButtonGlyphWidth :: (value: u8) -> float32 {
    if value == #char " " || value == #char "i" || value == #char "I" ||
        value == #char "l" || value == #char "j" || value == #char "t" ||
        value == #char "f" || value == #char "r" || value == #char "." ||
        value == #char "," || value == #char ":" || value == #char "'" { return 5.0 }
    if value == #char "m" || value == #char "w" || value == #char "W" || value == #char "M" { return 16.0 }
    return 10.0
}

ButtonWidth :: (text: string, minimum: float32 = 140.0, maximum: float32 = 320.0) -> float32 {
    width: float32 = 56.0
    for text { width += ButtonGlyphWidth(it) }
    if width < minimum { width = minimum }
    if width > maximum { width = maximum }
    return width
}

ButtonRadius :: (height: float32) -> float32 { return height * .5 }

PlainButton :: (session: Session, key: u64, text: string, bounds: Rectangle,
    style: ButtonStyle, disabled: bool = false, hug_width: bool = true,
    mark: bool = false) -> bool {
    if hug_width {
        width := ButtonWidth(text)
        bounds.x += (bounds.width - width) * .5
        bounds.width = width
    }
    fill := ifx disabled then BUTTON_DISABLED.fill else style.fill
    textColor := ifx disabled then BUTTON_DISABLED.text else style.text
    radius := ButtonRadius(bounds.height)
    shadowColor := (fill & 0xffffff00) | 0x33
    unused Box(session, BoxProps.{.key = key + 20000,
        .bounds = Rectangle.{bounds.x + 2.0, bounds.y + 3.0, bounds.width, bounds.height},
        .fill = ColorFromPacked(shadowColor), .radius = radius})
    unused Box(session, BoxProps.{.key = key, .bounds = bounds,
        .fill = ColorFromPacked(fill), .border = ColorFromPacked(0x10203f33), .radius = radius})
    font: s32 = 18
    padding: float32 = 14.0
    label_bounds := Rectangle.{bounds.x + padding, bounds.y, bounds.width - padding * 2.0, bounds.height}
    if mark {
        label_bounds.x += 12.0
        label_bounds.width -= 12.0
        unused Text(session, TextProps.{.key = key + 11000, .text = "✓",
            .bounds = Rectangle.{bounds.x + 14.0, bounds.y, 20.0, bounds.height},
            .font = font, .align = TextAlign.TextAlignCenter,
            .vertical_align = TextAlign.TextAlignCenter})
    }
    strong: [1]TextRange = .[.{0, cast(s32)text.count}]
    unused WidgetPaletteUse(session, WidgetPalette.{.background = fill, .base = fill,
        .text = textColor, .selected = fill, .selected_text = textColor,
        .border = 0x10203f33, .danger = textColor, .warning = textColor, .success = textColor})
    unused Text(session, TextProps.{.key = key + 10000, .text = text,
        .bounds = label_bounds, .font = font, .strong = strong[:], .align = TextAlign.TextAlignCenter,
        .vertical_align = TextAlign.TextAlignCenter})
    unused WidgetPaletteRestore(session)
    return Button(session, ButtonProps.{.key = key, .id = cast(s32)key, .bounds = bounds,
        .label = text, .disabled = disabled, .invisible = true}) != 0
}

Action :: (session: Session, key: u64, text: string, bounds: Rectangle) -> bool {
    return PlainButton(session, key, text, bounds, BUTTON_NORMAL)
}

PrimaryAction :: (session: Session, key: u64, text: string, bounds: Rectangle) -> bool {
    return PlainButton(session, key, text, bounds, BUTTON_PRIMARY)
}

TitleLayoutFor :: (bounds: Rectangle, resumable: bool) -> TitleLayout {
    portrait := bounds.height > bounds.width
    safe_top := bounds.height * (ifx portrait then .24 else .22)
    safe_bottom := bounds.height * (ifx portrait then .63 else .58)
    mode_width: float32 = 320.0
    if mode_width > bounds.width - cast(float32)16.0 { mode_width = bounds.width - cast(float32)16.0 }
    bottom := bounds.y + bounds.height - cast(float32)16.0
    play_label := ifx resumable then "New game" else "Play"
    wardrobe_width := ButtonWidth("Wardrobe")
    continue_width := ButtonWidth("Continue")
    play_width := ButtonWidth(play_label, 220.0)
    stack_height: float32 = 52.0 + 12.0 + 52.0 + 16.0 + 56.0
    if resumable { stack_height += 52.0 + 12.0 }
    top := bottom - stack_height
    mode := Rectangle.{bounds.x + (bounds.width - mode_width) * cast(float32).5, top, mode_width, cast(float32)52.0}
    mode.y = top
    mode.height = 52.0
    wardrobe := Rectangle.{bounds.x + (bounds.width - wardrobe_width) * cast(float32).5,
        mode.y + mode.height + cast(float32)12.0, wardrobe_width, cast(float32)52.0}
    wardrobe.y = mode.y + mode.height + cast(float32)12.0
    wardrobe.height = cast(float32)52.0
    result := TitleLayout.{
        .mode = mode,
        .wardrobe = wardrobe,
        .character_safe = Rectangle.{bounds.x + 8.0, bounds.y + safe_top, bounds.width - 16.0, safe_bottom - safe_top},
    }
    if resumable {
        result.continue_button = Rectangle.{bounds.x + (bounds.width - continue_width) * .5,
            wardrobe.y + wardrobe.height + 12.0, continue_width, 52.0}
        result.play = Rectangle.{bounds.x + (bounds.width - play_width) * .5,
            result.continue_button.y + result.continue_button.height + 16.0, play_width, 56.0}
    } else {
        result.play = Rectangle.{bounds.x + (bounds.width - play_width) * .5,
            wardrobe.y + wardrobe.height + 16.0, play_width, 56.0}
    }
    if result.character_safe.y + result.character_safe.height > result.mode.y {
        result.character_safe.height = result.mode.y - result.character_safe.y - 12.0
    }
    return result
}
RoundAction :: (session: Session, key: u64, text: string, bounds: Rectangle) -> bool {
    return PlainButton(session, key, text, bounds, BUTTON_NORMAL)
}
// A game's top bar: deep water with a glowing edge, a rounded Back or Pause
// button and a bold centred title.
GameBar :: (session: Session, viewport: Rectangle, key: u64, title: string, leading: bool, playing: bool) -> bool {
    bounds := Rectangle.{viewport.x, viewport.y, viewport.width, BAR_HEIGHT}
    unused Box(session, BoxProps.{.key = key, .bounds = bounds, .fill = ColorFromPacked(0x0a2438ff)})
    if leading {
        unused Box(session, BoxProps.{.key = key + 1,
            .bounds = Rectangle.{bounds.x, bounds.y + BAR_HEIGHT - 3.0, bounds.width, 3.0},
            .fill = ColorFromPacked(0x80cbd8ff)})
    }
    if title.count > 0 {
        strong: [1]TextRange = .[.{0, cast(s32)title.count}]
        unused Text(session, TextProps.{.key = key + 2, .text = title, .font = 24, .strong = strong[:],
            .bounds = Rectangle.{bounds.x + 88.0, bounds.y, bounds.width - 176.0, BAR_HEIGHT - 3.0},
            .align = TextAlign.TextAlignCenter, .vertical_align = TextAlign.TextAlignCenter})
    }
    if !leading { return false }
    label := ifx playing then "Pause" else "Back"
    width := ButtonWidth(label)
    return RoundAction(session, key + 3, ifx playing then "Pause" else "Back",
        Rectangle.{bounds.x + 8.0, bounds.y + 4.0, width, 44.0})
}
HudVisible :: () -> bool { return state.running && state.page == Nav.GAME_PLAYING }

Begin :: (session: Session, viewport: Rectangle, key: s32, now: float64) -> Rectangle {
    if !loaded {
        loaded = true
        saved := Prefs.Load()
        // Swipe until the player picks the pad in Settings.
        state.controls_selected = true
        state.controls_mode = ifx saved.pad then Nav.GAME_PAD else Nav.GAME_SWIPE
        muted = saved.muted
        fish_unlocked = fish_unlocked || saved.fish_unlocked
        fish = fish_unlocked && saved.fish
        accessory = saved.accessory
        accessories_owned = saved.accessories_owned
        accessories_stage = saved.accessories_stage
        if fish_unlocked && accessories_stage < 10 { SetAccessoryProgress(10) }
    }
    if key == 256 && wardrobe_open && state.page == Nav.GAME_TITLE { wardrobe_open = false }
    else if key == 256 { unused Back() }
    else if key == 32 && state.page == Nav.GAME_PLAYING { Nav.GameNavigationPause(*state) }
    else if key == 257 && state.page == Nav.GAME_TITLE { Start() }
    else if (key == 263 || key == 262) && state.page == Nav.GAME_TITLE { Pick(key == 262) }
    else if state.page == Nav.GAME_CONTROLS && (key == 49 || key == 50) { Choose(key - 49) }
    else if key == 77 || key == 109 { muted = !muted; Save() }
    playing := HudVisible()
    settings_available := state.page != Nav.GAME_SETTINGS && state.page != Nav.GAME_CONTROLS && !playing
    // The home artwork carries the title; keep the action bar clear.
    title := ""
    if state.page == Nav.GAME_PAUSED { title = "PAUSED" }
    if state.page == Nav.GAME_SETTINGS { title = "SETTINGS" }
    if state.page == Nav.GAME_CONTROLS { title = "CONTROLS" }
    bar = Rectangle.{viewport.x, viewport.y, viewport.width, BAR_HEIGHT - 3.0}
    if GameBar(session, viewport, cast(u64)50000, title, state.page != Nav.GAME_TITLE, playing) { unused Back() }
    right := viewport.x + viewport.width - 8.0
    action_y := viewport.y + 4.0
    if downloads_available && state.page == Nav.GAME_TITLE &&
    Action(session, cast(u64)50012, "Downloads",
        Rectangle.{right - ButtonWidth("Downloads"), action_y, ButtonWidth("Downloads"), 44.0}) {
        downloads_requested = true
    }
    if downloads_available && state.page == Nav.GAME_TITLE { right -= ButtonWidth("Downloads") + cast(float32)8.0 }
    if profile_available && !playing {
        profile_width := ButtonWidth("Profile")
        if Action(session, cast(u64)50010, "Profile", Rectangle.{right - profile_width, action_y, profile_width, 44.0}) {
            profile_requested = true
            Nav.GameNavigationPause(*state)
        }
        right -= profile_width + 8.0
    }
    if settings_available {
        settings_width := ButtonWidth("Settings")
        if Action(session, cast(u64)50011, "Settings", Rectangle.{right - settings_width, action_y, settings_width, 44.0}) {
            Nav.GameNavigationSettings(*state)
        }
    }
    area = Rectangle.{viewport.x, viewport.y + BAR_HEIGHT, viewport.width, viewport.height - BAR_HEIGHT}
    return area
}

// Amoeba or Fish, side by side above Play. Fish stays greyed out, saying how
// to earn it, until a run reaches full size.
ModePicker :: (session: Session, bounds: Rectangle) {
    half := bounds.width * .5
    if Mode(session, cast(u64)50120, "Amoeba", !fish, false,
        Rectangle.{bounds.x, bounds.y, half, bounds.height}) { Pick(false) }
    if Mode(session, cast(u64)50121, "Fish", fish, !fish_unlocked,
        Rectangle.{bounds.x + half, bounds.y, half, bounds.height}) { Pick(true) }
    if !fish_unlocked {
        unused Text(session, TextProps.{.key = cast(u64)50122, .text = "Reach full size",
            .bounds = Rectangle.{bounds.x, bounds.y + bounds.height, bounds.width, 10.0},
            .font = 10, .align = TextAlign.TextAlignCenter})
    }
}

Mode :: (session: Session, key: u64, text: string, selected: bool, locked: bool, bounds: Rectangle) -> bool {
    active := selected && !locked
    return PlainButton(session, key, text, bounds, ifx active then BUTTON_SELECTED else BUTTON_NORMAL,
        locked, false, active)
}
Backdrop :: (session: Session) {
    if area.width <= 0.0 || area.height <= 0.0 { return }
    portrait := area.height > area.width
    path := ifx portrait then "assets/choano/title-portrait.jpg" else "assets/choano/title-landscape.jpg"
    if fish { path = ifx portrait then "assets/choano/fish/title-portrait.jpg" else "assets/choano/fish/title-landscape.jpg" }
    extension: u32 = ifx fish then cast(u32)0x06324dff else cast(u32)0x0d6b83ff
    unused Box(session, BoxProps.{.key = cast(u64)50100, .bounds = area,
        .fill = ColorFromPacked(extension)})
    unused Image(session, ImageProps.{.key = cast(u64)50100, .asset_path = path,
        .bounds = area, .fit = ImageFit.ImageFitContain, .smooth = true})
}
MenuBounds :: (count: s32) -> Rectangle {
    width := area.width - 48.0
    if width > 320.0 { width = 320.0 }
    if width < 220.0 { width = 220.0 }
    height := cast(float32)count * 60.0 + 32.0
    return Rectangle.{area.x + (area.width - width) * .5,
        area.y + (area.height - height) * .5, width, height}
}
Menu :: (session: Session, bounds: Rectangle) {
    unused Box(session, BoxProps.{.key = cast(u64)50200, .bounds = bounds,
        .fill = ColorFromPacked(0x051922ed), .border = ColorFromPacked(0x80cbd8ff), .radius = 22.0})
}
Row :: (session: Session, bounds: Rectangle, row: s32, text: string, primary: bool) -> bool {
    button_bounds := Rectangle.{bounds.x + 16.0, bounds.y + 16.0 + cast(float32)row * 60.0,
        bounds.width - 32.0, 52.0}
    if primary { return PrimaryAction(session, cast(u64)(50210 + row), text, button_bounds) }
    return Action(session, cast(u64)(50210 + row), text, button_bounds)
}

End :: (session: Session, now: float64, over: bool) {
    if state.page == Nav.GAME_TITLE {
        Backdrop(session)
        resumable := state.running && !over && run_fish == fish
        layout := TitleLayoutFor(area, resumable)
        if wardrobe_open {
            Wardrobe(session)
        } else {
            if Action(session, cast(u64)50112, "Wardrobe", layout.wardrobe) {
                wardrobe_open = true
            }
            ModePicker(session, layout.mode)
            if resumable && Action(session, cast(u64)50111, "Continue", layout.continue_button) {
                Nav.GameNavigationResume(*state)
            }
            if PrimaryAction(session, cast(u64)50110, ifx resumable then "New game" else "Play", layout.play) { Start() }
        }
    } else if state.page == Nav.GAME_CONTROLS {
        if !WantsBoard() { Backdrop(session) }
        choice := Controls.GameControlsChoice(session, Controls.GameControlsProps.{.key = cast(u64)51000,
            .bounds = area, .now = now, .title = "Controls", .swipe_label = "Swipe", .pad_label = "Direction pad",
            .selected = ifx state.controls_selected then state.controls_mode else -1})
        if choice >= 0 { Choose(choice) }
    } else if state.page == Nav.GAME_PAUSED {
        bounds := MenuBounds(4)
        Menu(session, bounds)
        if Row(session, bounds, 0, ifx over then "Play again" else "Resume", over) {
            if over { start_requested = true }
            Nav.GameNavigationResume(*state)
        }
        if Row(session, bounds, 1, "Restart", false) { start_requested = true; Nav.GameNavigationResume(*state) }
        if Row(session, bounds, 2, "Settings", false) { Nav.GameNavigationSettings(*state) }
        if Row(session, bounds, 3, "Title screen", false) { Nav.GameNavigationHome(*state) }
    } else if state.page == Nav.GAME_SETTINGS {
        Backdrop(session)
        bounds := MenuBounds(3)
        Menu(session, bounds)
        if Row(session, bounds, 0, ifx state.controls_mode == Nav.GAME_PAD then "Controls: Direction pad" else "Controls: Swipe", false) { Nav.GameNavigationControls(*state) }
        if Row(session, bounds, 1, ifx muted then "Sound: Off" else "Sound: On", false) { muted = !muted; Save() }
        if Row(session, bounds, 2, "Back", false) { unused Back() }
        if save_failed {
            unused Text(session, TextProps.{.key = cast(u64)50220, .text = "Could not save settings",
                .bounds = Rectangle.{bounds.x, bounds.y + bounds.height + 8.0, bounds.width, 28.0}, .font = 14,
                .align = TextAlign.TextAlignCenter})
        }
    } else if over {
        bounds := MenuBounds(2)
        unused Text(session, TextProps.{.key = cast(u64)50230, .text = "Game over", .font = 26,
            .bounds = Rectangle.{bounds.x, bounds.y - 44.0, bounds.width, 36.0}, .align = TextAlign.TextAlignCenter})
        Menu(session, bounds)
        if Row(session, bounds, 0, "Play again", true) { start_requested = true }
        if Row(session, bounds, 1, "Title screen", false) { Nav.GameNavigationHome(*state) }
    } else if state.controls_mode == Nav.GAME_PAD {
        pad := DirectionPad(session, DirectionPadProps.{.key = cast(u64)52000,
            .bounds = DirectionPadBounds(area), .label = "Move", .now = now, .floating = true})
        Touch(pad.direction >= 0, ifx pad.direction == 0 then -1.0 else ifx pad.direction == 2 then 1.0 else 0.0,
            ifx pad.direction == 1 then -1.0 else ifx pad.direction == 3 then 1.0 else 0.0)
        DashButton(session)
        return
    } else {
        // Captured contact only, as Shovey and Wurm read it; the release-only
        // swipe result is unused. A tap never leans, so it does not move.
        gesture := SwipeArea(session, SwipeAreaProps.{.key = cast(u64)52010, .bounds = area,
            .label = "Move", .now = now, .min_distance = 6.0})
        // The heading points from where the press began, the centre that
        // SwipeFeedback draws; a reach of 0 keeps that anchor from following
        // a long drag, so pointing below the pad always swims down.
        steer := Controls.GameStickSteer(*stick, gesture.down, gesture.at_x, gesture.at_y, 8.0, 0.0)
        Touch(gesture.down, steer.x, steer.y)
        if gesture.down && !run_fish {
            // A thin unfilled dark ring, just outside SwipeFeedback's 56-unit
            // base, keeps the light feedback visible on the bright dish.
            ring: float32 = 60.0
            unused Box(session, BoxProps.{.key = cast(u64)52021,
                .bounds = Rectangle.{gesture.start_x - ring * .5, gesture.start_y - ring * .5, ring, ring},
                .border = ColorFromPacked(0x0a243899), .radius = ring * .5})
        }
        SwipeFeedback(session, SwipeFeedbackProps.{.key = cast(u64)52020, .gesture = gesture})
        DashButton(session)
        return
    }
    stick.active = false
    Touch(false, 0.0, 0.0)
}

Wardrobe :: (session: Session) {
    width := area.width - 32.0
    if width > 560.0 { width = 560.0 }
    if width < 500.0 { width = 500.0 }
    height: float32 = 292.0
    if area.height - 48.0 < height { height = area.height - 48.0 }
    bounds := Rectangle.{area.x + (area.width - width) * .5,
        area.y + (area.height - height) * .5, width, height}
    unused Box(session, BoxProps.{.key = cast(u64)50300, .bounds = bounds,
        .fill = ColorFromPacked(0x051922fa), .border = ColorFromPacked(0x80cbd8ff), .radius = 26.0})
    unused Text(session, TextProps.{.key = cast(u64)50301, .text = "Wardrobe", .font = 24,
        .bounds = Rectangle.{bounds.x + 26.0, bounds.y + 14.0, width - 122.0, 32.0}})
    close_width := ButtonWidth("Close")
    if RoundAction(session, cast(u64)50302, "Close", Rectangle.{bounds.x + width - close_width - 16.0,
        bounds.y + 10.0, close_width, 44.0}) {
        wardrobe_open = false
    }
    card_width := (width - 32.0 - 16.0) / 3.0
    for id: cast(s32)0..Accessories.ACCESSORY_COUNT - 1 {
        card := Rectangle.{bounds.x + 16.0 + cast(float32)id * (card_width + 8.0), bounds.y + 58.0, card_width, 216.0}
        if AccessoryCard(session, id, card) { SelectAccessory(id) }
    }
}

AccessoryCard :: (session: Session, id: s32, bounds: Rectangle) -> bool {
    selected := accessory == id
    unused Box(session, BoxProps.{.key = cast(u64)(50320 + id), .bounds = bounds,
        .fill = ifx selected then ColorFromPacked(0x123b52fa) else ColorFromPacked(0x0a2838fa),
        .border = ifx selected then ColorFromPacked(0xff8bc3ff) else ColorFromPacked(0x80cbd8cc), .radius = 20.0})
    size: float32 = 104.0
    if bounds.width - 20.0 < size { size = bounds.width - 20.0 }
    preview := Rectangle.{bounds.x + (bounds.width - size) * .5, bounds.y + 18.0, size, size}
    unused Box(session, BoxProps.{.key = cast(u64)(50330 + id), .bounds = preview,
        .fill = ColorFromPacked(0x0d3f57e8), .border = ColorFromPacked(0x54d2ec66), .radius = size * .5})
    tint := ifx locked(id) then cast(u32)0x8ea3adb0 else 0
    player_source := Sprites.OrganismSource("player", 1, 0)
    unused Image(session, ImageProps.{.key = cast(u64)(50340 + id), .asset_path = "assets/choano/organisms-hd.png",
        .bounds = preview, .source = player_source, .smooth = true, .tint = tint,
        .fit = ImageFit.ImageFitContain})
    unused Image(session, ImageProps.{.key = cast(u64)(50350 + id), .asset_path = Accessories.PreviewAssetPath(id),
        .bounds = preview, .source = Rectangle.{0.0, 0.0, cast(float32)Accessories.SOURCE_SIZE,
            cast(float32)Accessories.SOURCE_SIZE}, .smooth = true, .tint = tint,
        .fit = ImageFit.ImageFitStretch})
    locked := !AccessoryAvailable(id)
    if PlainButton(session, cast(u64)(50360 + id), Accessories.Name(id),
        Rectangle.{bounds.x + 10.0, bounds.y + 132.0, bounds.width - 20.0, 52.0},
        ifx selected then BUTTON_SELECTED else BUTTON_NORMAL, locked, true, selected) { return true }
    if locked {
        unused Text(session, TextProps.{.key = cast(u64)(50370 + id), .text = Accessories.UnlockHint(id),
            .bounds = Rectangle.{bounds.x + 8.0, bounds.y + 182.0, bounds.width - 16.0, 28.0}, .font = 12,
            .align = TextAlign.TextAlignCenter})
    } else if selected {
        unused Text(session, TextProps.{.key = cast(u64)(50371 + id), .text = "Worn",
            .bounds = Rectangle.{bounds.x + 8.0, bounds.y + 182.0, bounds.width - 16.0, 28.0}, .font = 12,
            .align = TextAlign.TextAlignCenter})
    }
    return false
}

locked :: (id: s32) -> bool { return !AccessoryAvailable(id) }

// Fish mode's touch dash, at the bottom right, clear of the pad. Drawn after
// the touch area, it takes the presses there.
DashButton :: (session: Session) {
    if !run_fish { return }
    if RoundAction(session, cast(u64)52030, "Dash",
        Rectangle.{area.x + area.width - 104.0, area.y + area.height - 72.0, 88.0, 52.0}) { dash_requested = true }
}

ProfileBar :: (session: Session, viewport: Rectangle) -> bool {
    return GameBar(session, viewport, cast(u64)53000, "PROFILE", true, false)
}
