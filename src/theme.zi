// Parse once; every rendering host receives the same palette from the sheet.
using Styles :: #import "css/Css";
Source :: #import "theme_source";
#import "kryon/widget_palette"
#import "kryon/session"

loaded: bool;
palette: WidgetPalette;
sheet: CssSheet;

Load :: (path: string) -> bool {
    if path != Source.PATH { return false }
    if loaded { return true }
    CssSheetReset(*sheet)
    if !CssSheetParse(*sheet, Source.SOURCE, path, CssNoImports) { return false }
    if !CssSheetResolve(*sheet, CssDefaultEnvironment(), null) { return false }
    canvas := CssSheetToken(*sheet, "--canvas")
    surface := CssSheetToken(*sheet, "--surface")
    text := CssSheetToken(*sheet, "--text")
    accent := CssSheetToken(*sheet, "--accent")
    ink := CssSheetToken(*sheet, "--accent-ink")
    border := CssSheetToken(*sheet, "--border")
    danger := CssSheetToken(*sheet, "--danger")
    warning := CssSheetToken(*sheet, "--warning")
    success := CssSheetToken(*sheet, "--success")
    if !canvas.found || !surface.found || !text.found || !accent.found || !ink.found ||
        !border.found || !danger.found || !warning.found || !success.found { return false }
    palette = .{.background = canvas.color, .base = surface.color, .text = text.color,
        .selected = accent.color, .selected_text = ink.color, .border = border.color,
        .danger = danger.color, .warning = warning.color, .success = success.color}
    loaded = true
    return true
}

Use :: (session: Session, path: string) -> bool {
    if !Load(path) { return false }
    return WidgetPaletteUse(session, palette)
}
