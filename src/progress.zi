// Only earned amoeba growth follows an account. Runs remain device-only.
#import "entity/game_progress_client"
#import "entity/game_progress"
#import "std/text_buffer"
#import "std/c_string"
#import "std/json_scan"
#if #defined(CHOANO_PROGRESS_TEST) {
    Account :: #import "progress_fixture";
    Storage :: #import "progress_fixture";
} else {
    Storage :: #import "progress_storage";
    #if #defined(CHOANO_PROGRESS_STORAGE_TEST) {
        Account :: #import "progress_fixture";
    } else #if #defined(CHOANO_PORTABLE) {
        Account :: #import "portable_runtime";
    } else #if #defined(PLATFORM_WEB) {
        Account :: #import "web_account";
    } else {
        Account :: #import "account";
    }
}
client: GameProgressClient;
identity: [129]u8;
bound: bool;
known_owner: bool;
// Call before profile reconfiguration, including a same-identity relogin.
Reset :: () { GameProgressClientReset(*client); Storage.Close(); bound = false }
verified: [129]u8;
Owner :: (context: *void) -> string {
    unused context
    status := Account.Service("entity.records", "{\"operation\":\"status\"}")
    verified = .{}
    if ReadStringText(status, FieldAt(status, 0, "account"), verified[:]) < 0 { return "unavailable" }
    if TextUntilNul(verified[:]) == "local" { return "" }
    return TextUntilNul(verified[:])
}
Service :: (context: *void, name: string, request: string) -> string {
    unused context
    return Account.Service(name, request)
}
Persist :: (context: *void, owner: string, record: *GameProgressRecord, pending: bool) -> bool {
    unused context
    return Storage.Persist(owner, record, pending)
}
ProgressPump :: (now: float64, stage: s32, stamp: s64, allow_read: bool = true) -> bool {
    status := Account.Service("entity.records", "{\"operation\":\"status\"}")
    current: [129]u8
    if ReadStringText(status, FieldAt(status, 0, "account"), current[:]) < 0 { return false }
    if TextUntilNul(current[:]) == "local" { current = .{} }
    changed := known_owner && TextUntilNul(current[:]) != TextUntilNul(identity[:])
    if changed { Reset() }
    known_owner = true
    identity = current
    if !bound {
        record: GameProgressRecord
        pending: bool
        if !Storage.Load(TextUntilNul(identity[:]), *record, *pending) { return changed }
        client.service = Service; client.owner = Owner; client.persist = Persist
        result := GameProgressClientBind(*client, TextUntilNul(identity[:]), *record, pending)
        if result.state == .OwnerChanged { Reset(); return true }
        bound = true
        // Never attribute the previous owner's active run to a new binding.
        stage = 0
    }
    earned: GameProgressRecord
    if stage > 0 && GameProgressClientRead(*client, *earned) && stage > earned.unlocked {
        earned.unlocked = stage; earned.updated_at = stamp
        unused GameProgressClientQueue(*client, *earned)
    }
    unused GameProgressClientPump(*client, cast(s64)(now * 1000.0), allow_read)
    return changed
}
HighestStage :: () -> s32 {
    value: GameProgressRecord
    return ifx client.result.durable && GameProgressClientRead(*client, *value) then value.unlocked else 0
}
Result :: () -> GameProgressClientResult { return client.result }
