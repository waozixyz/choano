// Choano owns cue selection and transitions; Kryon owns playback and devices.
#import "kryon/media_audio"
#import "kryon/session"
#import "std/format"
Paths :: #import "sound_paths";

sound_muted: bool;
playing: s32;
#if #defined(PLATFORM_WEB) {
    EFFECT_GAIN :: .6;
    MUSIC_GAIN :: .45;
} else #if #defined(ANDROID_BUILD) || #defined(CHOANO_RAYLIB) {
    EFFECT_GAIN :: 1.0;
    MUSIC_GAIN :: .7;
} else {
    EFFECT_GAIN :: 1.0;
    MUSIC_GAIN :: .6;
}

// Status is authoritative after host disposal/rebinding; no app-side loaded cache.
SoundReady :: (session: Session, voice: s32, path: string, music: bool, gain: float32) -> bool {
    status := MediaAudio(session, .{.operation = .Status, .voice = voice})
    if status.code == .Ok && status.state != .Unloaded { return true }
    loaded := MediaAudio(session, .{.operation = .Load, .voice = voice,
        .asset = path, .music = music, .gain = gain})
    return loaded.code == .Ok
}
SoundPlayEvent :: (session: Session, event: s32) -> bool {
    if sound_muted || event < 1 || event > 6 { return false }
    path: Vec(u8)
    BuilderPrint(*path, "assets/choano/audio/%.wav", Paths.SoundPath(event))
    if !SoundReady(session, event, BuilderFinish(path), false, EFFECT_GAIN) { return false }
    if playing != 0 && playing != event {
        unused MediaAudio(session, .{.operation = .Stop, .voice = playing})
    }
    result := MediaAudio(session, .{.operation = .Play, .voice = event})
    if result.code != .Ok { return false }
    playing = event
    return true
}
SoundMusic :: (session: Session, on: bool) {
    on = on && !sound_muted
    status := MediaAudio(session, .{.operation = .Status, .voice = 7})
    if !on {
        if status.code == .Ok && status.state == .Playing {
            unused MediaAudio(session, .{.operation = .Stop, .voice = 7})
        }
        return
    }
    if status.code == .Ok && status.state == .Playing { return }
    if !SoundReady(session, 7, Paths.SHARK_MUSIC, true, MUSIC_GAIN) { return }
    // A denied/suspended Play is never remembered as playing. Retry on a later
    // active frame (the browser provider requires an actual user gesture).
    unused MediaAudio(session, .{.operation = .Play, .voice = 7, .looping = true})
}
SoundSetMuted :: (session: Session, value: bool) {
    if value == sound_muted { return }
    sound_muted = value
    for voice: cast(s32)1..7 {
        gain: float32 = ifx value then 0.0 else ifx voice == 7 then MUSIC_GAIN else EFFECT_GAIN
        unused MediaAudio(session, .{.operation = .Gain, .voice = voice, .gain = gain})
    }
}
