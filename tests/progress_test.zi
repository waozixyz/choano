Progress :: #import "progress";
Fixture :: #import "progress_fixture";
Expect :: (value: bool, name: string) -> bool {
    if !value { print("Choano progress local test failed: %\n", name) }
    return value
}
main :: () -> s32 {
    if !Expect(Progress.ProgressPump(0.0, 1, 1), "new account resets its run") { return 1 }
    unused Progress.ProgressPump(2.0, 2, 2)
    if !Expect(Fixture.writes == 0 && Progress.HighestStage() == 4, "download before upload preserves earned stages") { return 1 }
    Fixture.fail = true
    unused Progress.ProgressPump(4.0, 5, 4)
    if !Expect(Fixture.writes == 1 && Progress.dirty, "failed writes remain pending") { return 1 }
    Fixture.fail = false
    unused Progress.ProgressPump(6.0, 5, 6)
    if !Expect(Fixture.writes == 2 && !Progress.dirty && Fixture.written_stage == 5, "retry the same earned progress") { return 1 }
    Fixture.account = "b"
    Fixture.remote_stage = 1
    if !Expect(Progress.ProgressPump(8.0, 5, 8), "account switch resets the run") { return 1 }
    unused Progress.ProgressPump(10.0, 1, 10)
    if !Expect(Fixture.writes == 2 && Progress.HighestStage() == 1, "old account's progress never enters the new account") { return 1 }
    print("Choano local progress tests passed.\n")
    return 0
}
