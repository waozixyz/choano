#import "game"

Expect :: (condition: bool, message: string) -> s32 {
    if condition { return 0 }
    print("choano test failed: %\n", message)
    return 1
}

// One held touch swims right, then points each other way in turn: every leg
// must go where the finger points, with no sideways drift from the last one.
TouchTurns :: (mode: s32) -> s32 {
    StartGame(2468, mode)
    for step: 0..29 { MovePlayer(.{.steer_x = 1.0}, 1.0 / 60.0) }
    // Down, up, left, right, then the four diagonals.
    d: float32 = .70710678
    heading_x: [8]float32 = .[0.0, 0.0, -1.0, 1.0, d, -d, -d, d]
    heading_y: [8]float32 = .[1.0, -1.0, 0.0, 0.0, d, -d, d, -d]
    for index: 0..7 {
        x := heading_x[index]; y := heading_y[index]
        // Keep the leg clear of the dish edge and the open-water bounds.
        game.player_x = cast(float32)DISH_CENTER_X; game.player_y = cast(float32)DISH_CENTER_Y
        for step: 0..14 { MovePlayer(.{.steer_x = x, .steer_y = y}, 1.0 / 60.0) }
        along := (game.player_x - cast(float32)DISH_CENTER_X) * x + (game.player_y - cast(float32)DISH_CENTER_Y) * y
        across := (game.player_x - cast(float32)DISH_CENTER_X) * y - (game.player_y - cast(float32)DISH_CENTER_Y) * x
        if across < 0.0 { across = -across }
        if Expect(along > 8.0 && across < .01, "a held touch turns cleanly where it points") != 0 {
            print("mode % heading % %: along % across %\n", mode, x, y, along, across)
            return 1
        }
    }
    return 0
}

TouchCoast :: (mode: s32) -> s32 {
    StartGame(9753, mode)
    game.player_x = cast(float32)DISH_CENTER_X
    game.player_y = cast(float32)DISH_CENTER_Y
    for step: 0..29 { MovePlayer(.{.steer_x = 1.0, .steer_y = 1.0}, 1.0 / 60.0) }
    before_x := game.player_x; before_y := game.player_y
    MovePlayer(.{}, 1.0 / 60.0)
    first := (game.player_x - before_x) * (game.player_x - before_x) +
        (game.player_y - before_y) * (game.player_y - before_y)
    before_x = game.player_x; before_y = game.player_y
    MovePlayer(.{}, 1.0 / 60.0)
    second := (game.player_x - before_x) * (game.player_x - before_x) +
        (game.player_y - before_y) * (game.player_y - before_y)
    before_x = game.player_x; before_y = game.player_y
    MovePlayer(.{}, 1.0 / 60.0)
    third := (game.player_x - before_x) * (game.player_x - before_x) +
        (game.player_y - before_y) * (game.player_y - before_y)
    for step: 0..19 { MovePlayer(.{}, 1.0 / 60.0) }
    if Expect(first > .5 && second < first && third < second, "a released touch glides to a finite stop") != 0 { return 1 }
    if Expect(game.player_velocity_x == 0.0 && game.player_velocity_y == 0.0,
        "a released touch reaches exact rest") != 0 { return 1 }
    release_x := game.player_x; release_y := game.player_y
    for step: 0..29 { MovePlayer(.{}, 1.0 / 60.0) }
    moved_x := game.player_x - release_x; moved_y := game.player_y - release_y
    return Expect(moved_x == 0.0 && moved_y == 0.0 && game.coast_deceleration == 0.0,
        "a released touch stays at rest without new input")
}

Near :: (value: float32, expected: float32) -> bool {
    difference := value - expected
    if difference < 0.0 { difference = -difference }
    return difference <= .01
}

DishFrameTests :: () -> s32 {
    StartGame(8642)
    if Expect(!game.dish_frame_enabled && game.dish_half_height == cast(float32)DISH_RADIUS &&
        game.dish_corner_radius == 0.0, "the default dish is the original circle") != 0 { return 1 }

    SetDishFrame(300.0, 32.0, true)
    game.player_x = cast(float32)DISH_CENTER_X + 194.0
    game.player_y = cast(float32)DISH_CENTER_Y - 282.0
    corner_x := game.player_x; corner_y := game.player_y
    if Expect(!ClampPoint(*corner_x, *corner_y, cast(float32)StageSize(game.player_stage)),
        "the full rounded rectangle reaches outside the old circle") != 0 { return 1 }
    if Expect(DistanceSquared(corner_x, corner_y, cast(float32)DISH_CENTER_X, cast(float32)DISH_CENTER_Y) >
        cast(float32)(DISH_RADIUS * DISH_RADIUS), "upper corners are not ellipse corners") != 0 { return 1 }

    game.player_x = cast(float32)DISH_CENTER_X
    game.player_y = -100.0
    if Expect(ClampPoint(*game.player_x, *game.player_y, cast(float32)StageSize(game.player_stage)),
        "the tall straight edge clamps") != 0 { return 1 }
    if Expect(game.player_x == cast(float32)DISH_CENTER_X &&
        Near(game.player_y, cast(float32)DISH_CENTER_Y - 292.85), "the rectangle keeps its straight height") != 0 { return 1 }

    game.player_x = 450.0
    game.player_y = -100.0
    if Expect(ClampPoint(*game.player_x, *game.player_y, cast(float32)StageSize(game.player_stage)),
        "a point outside a rounded corner clamps") != 0 { return 1 }
    if Expect(Near(game.player_x, 435.35) && Near(game.player_y, -79.288),
        "rounded collision projects to the corner arc") != 0 { return 1 }

    game.enemy_count = 0
    spawned: s32 = 0
    for index: 0..39 {
        if !SpawnEnemy(STAGE_FIRST) { break }
        spawned += 1
    }
    if Expect(spawned > 12, "the taller dish samples many safe spawns") != 0 { return 1 }
    for index: cast(s32)0..spawned - 1 {
        test_x := game.enemies[index].x; test_y := game.enemies[index].y
        if Expect(!ClampPoint(*test_x, *test_y, cast(float32)StageSize(game.enemies[index].stage)),
            "sampled enemies fit the rounded dish") != 0 { return 1 }
    }

    StartGame(8643)
    SetDishFrame(300.0, 24.0, true)
    game.score = 123
    game.lives = 7
    game.elapsed = 12.5
    game.next_spawn_timer = 3.25
    game.player_velocity_x = 11.0
    game.player_velocity_y = -6.0
    game.coast_deceleration = 13.0
    game.player_x = cast(float32)DISH_CENTER_X
    game.player_y = cast(float32)DISH_CENTER_Y - 289.0
    game.enemy_count = 1
    game.enemies[0] = .{.x = cast(float32)DISH_CENTER_X, .y = cast(float32)DISH_CENTER_Y + 289.0,
        .stage = STAGE_FIRST, .active = true}
    SetDishFrame(260.0, 20.0, true)
    if Expect(Near(game.player_y, cast(float32)DISH_CENTER_Y - 250.467) &&
        Near(game.enemies[0].y, cast(float32)DISH_CENTER_Y + 250.467),
        "shrinking reflows player and enemies about the center") != 0 { return 1 }
    if Expect(game.score == 123 && game.lives == 7 && Near(cast(float32)game.elapsed, 12.5) &&
        Near(cast(float32)game.next_spawn_timer, 3.25) && game.player_velocity_x == 11.0 &&
        game.player_velocity_y == -6.0 && game.coast_deceleration == 13.0 && game.started && !game.over,
        "resizing preserves play state and motion") != 0 { return 1 }

    player_y := game.player_y
    enemy_y := game.enemies[0].y
    random := game.random
    SetDishFrame(260.0, 20.0, true)
    if Expect(game.player_y == player_y && game.enemies[0].y == enemy_y && game.random == random,
        "an unchanged frame is a no-op") != 0 { return 1 }

    SetDishFrame(340.0, 28.0, true)
    if Expect(game.dish_half_height == 340.0 && game.dish_corner_radius == 28.0 &&
        Near(game.player_y, cast(float32)DISH_CENTER_Y - 327.533), "expanding reflows the visible scene") != 0 { return 1 }

    SetDishFrame(999.0, 999.0, false)
    if Expect(!game.dish_frame_enabled && game.dish_half_height == cast(float32)DISH_RADIUS &&
        game.dish_corner_radius == 0.0 && Near(game.player_y, cast(float32)DISH_CENTER_Y - 200.373),
        "disabling ignores inactive dimensions and restores the circle") != 0 { return 1 }

    for phase: 0..2 {
        StartGame(cast(u32)(8644 + phase), MODE_AMOEBA)
        if phase == 0 { game.started = false } else { game.over = true }
        game.player_y = -1000.0
        game.enemy_count = 1
        game.enemies[0] = .{.x = cast(float32)DISH_CENTER_X, .y = -1000.0, .stage = STAGE_FIRST}
        SetDishFrame(300.0 + cast(float32)(phase * 20), 24.0, true)
        player_inside_x := game.player_x; player_inside_y := game.player_y
        enemy_inside_x := game.enemies[0].x; enemy_inside_y := game.enemies[0].y
        if Expect(!ClampPoint(*player_inside_x, *player_inside_y, cast(float32)StageSize(game.player_stage)) &&
            !ClampPoint(*enemy_inside_x, *enemy_inside_y, cast(float32)StageSize(game.enemies[0].stage)) &&
            game.player_y > -1000.0 && game.enemies[0].y > -1000.0,
            "unstarted and finished scenes still use the configured frame") != 0 { return 1 }
    }

    SetDishFrame(320.0, 18.0, true)
    StartGame(8645, MODE_FISH)
    fish_x: float32 = 77.0; fish_y: float32 = 88.0
    game.player_x = fish_x; game.player_y = fish_y
    game.enemy_count = 1
    game.enemies[0] = .{.x = 200.0, .y = 250.0, .kind = KIND_FISH, .active = true}
    SetDishFrame(300.0, 24.0, true)
    if Expect(game.player_x == fish_x && game.player_y == fish_y && game.enemies[0].x == 200.0 &&
        game.enemies[0].y == 250.0 && game.dish_half_height == 300.0,
        "Fish mode accepts frame configuration without moving fish") != 0 { return 1 }
    return 0
}

main :: () -> s32 {
    StartGame(12345)
    if Expect(game.started, "game starts immediately") != 0 { return 1 }
    if Expect(!SharkAlert(), "Amoeba mode has no shark music cue") != 0 { return 1 }
    if Expect(game.enemy_count == INITIAL_ENEMIES, "retuned initial enemy count") != 0 { return 1 }
    if Expect(game.lives == 2 && game.player_stage == 1 && game.score == 0 &&
        game.next_growth_threshold == 14, "original initial state") != 0 { return 1 }
    for index: cast(s32)0..game.enemy_count - 1 {
        if Expect(!game.enemies[index].active && game.enemies[index].stage == 1,
            "initial enemies are delayed larger amoebas") != 0 { return 1 }
    }

    if Expect(StageSize(1) == 22 && StageSize(10) == 94 &&
        FishSize(1) == 11 && FishSize(10) == 47, "one-based stage sizes") != 0 { return 1 }
    game.player_x = 500.0
    game.player_y = 209.0
    unused ClampPoint(*game.player_x, *game.player_y, cast(float32)StageSize(game.player_stage))
    maximum := cast(float32)DISH_RADIUS - cast(float32)StageSize(game.player_stage) * .325
    if Expect(DistanceSquared(game.player_x, game.player_y, cast(float32)DISH_CENTER_X, cast(float32)DISH_CENTER_Y) <= maximum * maximum,
        "player remains inside the petri dish") != 0 { return 1 }

    StartGame(12345)
    game.enemy_count = 1
    game.enemies[0] = .{.x = game.player_x - 8.0, .y = game.player_y, .stage = 1,
        .velocity_x = 1.0, .velocity_y = 0.0, .active = true, .warning_timer = 0.0}
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.score == 10 && game.growth_progress == 1 && game.enemy_count == 1,
        "equal enemy is eaten, scored, and replaced") != 0 { return 1 }

    StartGame(12345)
    game.enemy_count = 1
    game.growth_progress = 13
    game.enemies[0] = .{.x = game.player_x, .y = game.player_y, .stage = 1,
        .velocity_x = 1.0, .velocity_y = 0.0, .active = true, .warning_timer = 0.0}
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.player_stage == 2 && game.growth_stages == 1 &&
        game.next_growth_threshold == 34, "gentler cumulative growth threshold") != 0 { return 1 }

    StartGame(12345)
    game.growth_stages = 2
    game.growth_progress = 43
    game.player_stage = 2
    game.next_growth_threshold = 34
    game.enemy_count = 1
    game.enemies[0] = .{.x = game.player_x, .y = game.player_y, .stage = 1,
        .velocity_x = 1.0, .velocity_y = 0.0, .active = true, .warning_timer = 0.0}
    game.lives = 2
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.player_stage == 3 && game.lives == 3,
        "third growth stage grants an extra life") != 0 { return 1 }

    StartGame(12345)
    game.enemy_count = 1
    game.enemies[0] = .{.x = game.player_x, .y = game.player_y, .stage = 2,
        .velocity_x = 1.0, .velocity_y = 0.0, .active = true, .warning_timer = 0.0}
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(!game.over && game.lives == 1, "larger enemy costs a life without invented immunity") != 0 { return 1 }
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(!game.over && game.lives == 0, "second dangerous contact reaches the final life state") != 0 { return 1 }
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.over, "third dangerous contact ends the game") != 0 { return 1 }

    StartGame(1357)
    game.enemy_count = 0
    for step: 0..59 { UpdateGame(.{.steer_x = .6, .steer_y = -.8}, 1.0 / 60.0) }
    moved_x := game.player_x - cast(float32)DISH_CENTER_X
    moved_y := game.player_y - cast(float32)DISH_CENTER_Y
    if Expect(moved_x > 30.0 && moved_y < -40.0 && moved_y * .6 + moved_x * .8 > -1.0 && moved_y * .6 + moved_x * .8 < 1.0,
        "a touch heading swims in any direction") != 0 { return 1 }
    if Expect(game.player_facing == 1 && game.player_moving, "the player faces its swim") != 0 { return 1 }
    UpdateGame(.{.left = true, .steer_x = 1.0}, 1.0 / 60.0)
    if Expect(game.player_velocity_x < 100.0 && game.player_velocity_x > 40.0,
        "keys win over the touch heading and its release") != 0 { return 1 }
    for step: 0..119 { UpdateGame(.{}, 1.0 / 60.0) }
    if Expect(!game.player_moving, "the player glides to rest") != 0 { return 1 }
    for step: 0..29 { UpdateGame(.{.steer_x = 1.0}, 1.0 / 60.0) }
    if Expect(game.player_moving, "a held touch swims") != 0 { return 1 }
    for mode: cast(s32)MODE_AMOEBA..MODE_FISH {
        if TouchTurns(mode) != 0 { return 1 }
        if TouchCoast(mode) != 0 { return 1 }
    }
    if DishFrameTests() != 0 { return 1 }

    StartGame(97531)
    game.player_stage = PLAYER_STAGE_LAST - 1
    game.next_growth_threshold = GrowthThreshold(game.player_stage)
    game.growth_progress = game.next_growth_threshold
    GrowPlayer()
    if Expect(game.player_stage == PLAYER_STAGE_LAST && game.full_size, "reaching full size is flagged for the award") != 0 { return 1 }
    expected_thresholds: [10]s32 = .[0, 14, 34, 60, 94, 138, 195, 269, 365, 490]
    thresholds_match := true
    for stage: 1..9 {
        thresholds_match = thresholds_match && GrowthThreshold(cast(s32)stage) == expected_thresholds[stage]
    }
    if Expect(thresholds_match, "growth asks about 1.3 times more each level") != 0 { return 1 }
    game.full_size = false
    game.growth_progress = game.next_growth_threshold
    GrowPlayer()
    if Expect(!game.full_size && game.next_growth_threshold == 612,
        "growing past full size awards nothing again and slows to 1.25 times") != 0 { return 1 }

    StartGame(4242, MODE_FISH)
    if Expect(game.mode == MODE_FISH && game.enemy_count == FISH_START, "Fish mode starts with a few fish") != 0 { return 1 }
    for index: cast(s32)0..game.enemy_count - 1 {
        fish := game.enemies[index]
        if Expect(fish.kind == KIND_FISH && fish.active && fish.stage == 1 && fish.velocity_x != 0.0 &&
            DistanceSquared(fish.x, fish.y, game.player_x, game.player_y) >= 89.0 * 89.0, "starting fish swim away from the player") != 0 { return 1 }
        if Expect(fish.species >= 0 && fish.species < FISH_SPECIES &&
            (index == 0 || fish.species != game.enemies[index - 1].species), "starting fish look different from each other") != 0 { return 1 }
    }
    game.enemy_count = 1
    game.enemies[0] = .{.x = game.player_x, .y = game.player_y, .stage = 1, .velocity_x = 20.0, .active = true, .kind = KIND_FISH}
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.score == 10 && game.enemy_count == 0, "a small fish is eaten") != 0 { return 1 }
    game.enemies[0] = .{.x = game.player_x, .y = game.player_y, .stage = 3, .velocity_x = 20.0, .active = true, .kind = KIND_FISH}
    game.enemy_count = 1
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.lives == 1 && game.safe_timer > 0.0, "a bigger fish bites once") != 0 { return 1 }
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.lives == 1, "a bite leaves a moment of safety") != 0 { return 1 }
    game.enemy_count = 1
    game.enemies[0] = .{.x = game.player_x, .y = game.player_y, .stage = 0, .velocity_y = 20.0, .active = true, .kind = KIND_PEARL}
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.score == 10 + PEARL_SCORE && game.enemy_count == 0, "a golden pearl scores") != 0 { return 1 }
    game.enemies[0] = .{.x = -60.0, .y = 200.0, .stage = 1, .velocity_x = -30.0, .active = true, .kind = KIND_FISH}
    game.enemy_count = 1
    game.next_spawn_timer = 99.0
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.enemy_count == 0, "a fish that swims out leaves") != 0 { return 1 }

    StartGame(4243, MODE_FISH)
    game.enemy_count = 0
    UpdateGame(.{.right = true, .dash = true}, 1.0 / 60.0)
    if Expect(game.player_velocity_x > cast(float32)FISH_SPEED * 1.5, "a dash darts ahead") != 0 { return 1 }
    for step: 0..29 { UpdateGame(.{.right = true}, 1.0 / 60.0) }
    cruising := game.player_velocity_x
    UpdateGame(.{.right = true, .dash = true}, 1.0 / 60.0)
    if Expect(game.player_velocity_x < cruising * 1.2, "a dash needs its cooldown") != 0 { return 1 }
    game.player_y = 500.0
    unused SeaClamp(*game.player_x, *game.player_y, cast(float32)FishSize(game.player_stage))
    if Expect(game.player_y <= cast(float32)SEA_BOTTOM, "the fish stays above the sand") != 0 { return 1 }

    StartGame(4244, MODE_FISH)
    game.enemy_count = 0
    game.school_timer = 99.0
    game.animal_timer = 99.0
    game.shark_timer = .001
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(SharkAlert() && game.shark_warning > 0.0 && KindCount(KIND_SHARK) == 0,
        "shark music leads without a shark") != 0 { return 1 }
    shark_wait_frames := 0
    no_shark_during_lead_in := true
    for step: 0..159 {
        shark_wait_frames += 1
        UpdateGame(.{}, 1.0 / 60.0)
        if game.shark_warning > 0.0 && KindCount(KIND_SHARK) > 0 { no_shark_during_lead_in = false }
        if KindCount(KIND_SHARK) > 0 { break }
    }
    if Expect(no_shark_during_lead_in && shark_wait_frames >= 150 && game.shark_warning == 0.0 &&
        KindCount(KIND_SHARK) == 1 && SharkAlert(),
        "the shark hunts when its lead-in expires") != 0 { return 1 }
    shark := 0
    while game.enemies[shark].kind != KIND_SHARK { shark += 1 }
    game.enemies[shark].x = game.player_x + 300.0
    game.enemies[game.enemy_count] = .{.x = game.enemies[shark].x, .y = game.enemies[shark].y, .stage = 1, .velocity_x = 20.0,
        .active = true, .kind = KIND_FISH}
    game.enemy_count += 1
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(FishCount() == 0, "the shark swallows fish in its way") != 0 { return 1 }
    game.enemies[0].x = game.player_x
    game.enemies[0].y = game.player_y
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.lives == 1 && game.shark_bit, "even a big fish loses a life to the shark") != 0 { return 1 }
    score := game.score
    game.enemies[0].x = cast(float32)FIELD_WIDTH + cast(float32)SHARK_LENGTH
    game.enemies[0].velocity_x = cast(float32)SHARK_SPEED
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.shark_warning == 0.0 && KindCount(KIND_SHARK) == 0 && game.score == score && !SharkAlert(),
        "shark music stops when the shark departs") != 0 { return 1 }
    game.shark_timer = 99.0
    game.enemy_count = 0
    unused SpawnShark()
    game.enemies[0].x = -cast(float32)SHARK_LENGTH
    game.enemies[0].velocity_x = -cast(float32)SHARK_SPEED
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.score == score + SHARK_SCORE, "outlasting a shark scores") != 0 { return 1 }

    StartGame(4245, MODE_FISH)
    game.enemy_count = 0
    SpawnSchool()
    if Expect(KindCount(KIND_SARDINE) == SCHOOL_SIZE, "a whole school of sardines arrives") != 0 { return 1 }
    game.enemy_count = 0
    for bite: 0..2 {
        game.enemies[0] = .{.x = game.player_x, .y = game.player_y, .velocity_x = 70.0, .active = true, .kind = KIND_SARDINE}
        game.enemy_count = 1
        UpdateGame(.{}, 1.0 / 60.0)
    }
    if Expect(game.frenzy == 3 && game.score == SARDINE_SCORE * (1 + 2 + 3), "quick bites build a frenzy") != 0 { return 1 }
    for step: 0..119 { UpdateGame(.{}, 1.0 / 60.0) }
    if Expect(game.frenzy == 0, "a frenzy cools down") != 0 { return 1 }

    // Seahorse, lobster and starfish arrive in turn without waiting for growth.
    StartGame(4246, MODE_FISH)
    game.enemy_count = 0
    game.lives = 99
    game.next_spawn_timer = 999.0
    game.school_timer = 999.0
    game.shark_timer = 999.0
    game.pearl_timer = 999.0
    game.jelly_timer = 999.0
    arrivals: [3]s32
    arrival_times: [3]float64
    arrived: s32 = 0
    most: s32 = 0
    for step: 0..1799 {
        next := game.animal_next
        UpdateGame(.{}, 1.0 / 60.0)
        if game.animal_next != next && arrived < 3 {
            arrivals[arrived] = next
            arrival_times[arrived] = game.elapsed
            arrived += 1
        }
        if SeaAnimalCount() > most { most = SeaAnimalCount() }
    }
    if Expect(arrived == 3 && arrival_times[0] <= 3.0, "a first sea animal arrives within three seconds") != 0 { return 1 }
    if Expect(arrivals[0] == KIND_SEAHORSE && arrivals[1] == KIND_LOBSTER && arrivals[2] == KIND_STARFISH,
        "seahorse, lobster and starfish take turns") != 0 { return 1 }
    if Expect(arrival_times[1] - arrival_times[0] >= 5.9 && arrival_times[2] - arrival_times[1] <= 9.1,
        "sea animals arrive every six to nine seconds") != 0 { return 1 }
    if Expect(most >= 1 && most <= ANIMAL_MOST, "only a few sea animals swim at once") != 0 { return 1 }

    StartGame(4247, MODE_FISH)
    game.enemy_count = 0
    game.player_x = 480.0
    game.player_y = cast(float32)SEA_TOP + 10.0
    game.animal_timer = 999.0
    game.next_spawn_timer = 999.0
    for kind: cast(s32)KIND_SEAHORSE..KIND_STARFISH {
        if Expect(SpawnSeaAnimal(kind), "a sea animal spawns") != 0 { return 1 }
        game.enemies[game.enemy_count - 1].x = 100.0
        game.enemies[game.enemy_count - 1].y = 200.0
    }
    if Expect(game.enemy_count == 3 && game.enemies[0].kind == KIND_SEAHORSE && game.enemies[1].kind == KIND_LOBSTER &&
        game.enemies[2].kind == KIND_STARFISH, "each sea animal keeps its kind") != 0 { return 1 }
    highest: [3]float32 = .[0.0, 0.0, 0.0]
    lowest: [3]float32 = .[999.0, 999.0, 999.0]
    for step: 0..119 {
        UpdateGame(.{}, 1.0 / 60.0)
        for index: 0..2 {
            y := game.enemies[index].y
            if y > highest[index] { highest[index] = y }
            if y < lowest[index] { lowest[index] = y }
        }
    }
    seahorse := game.enemies[0]
    lobster := game.enemies[1]
    starfish := game.enemies[2]
    sand := cast(float32)SEA_BOTTOM
    if Expect(highest[0] - lowest[0] > 10.0 && highest[0] < sand - 20.0, "a seahorse bobs in open water") != 0 { return 1 }
    if Expect(lobster.y == sand - cast(float32)FishSize(lobster.stage) * .5 && highest[1] - lowest[1] < .01 &&
        (lobster.x - 100.0) * lobster.velocity_x > 0.0, "a lobster crawls along the sand") != 0 { return 1 }
    starfish_moved := starfish.x - 100.0
    if starfish_moved < 0.0 { starfish_moved = -starfish_moved }
    if Expect(highest[2] <= sand && lowest[2] > sand - cast(float32)FishSize(starfish.stage) * .5 - 16.0 &&
        starfish_moved > 10.0 && starfish_moved < 40.0, "a starfish drifts slowly near the sand") != 0 { return 1 }
    game.enemy_count = 1
    game.enemies[0] = .{.x = -60.0, .y = 200.0, .stage = 1, .velocity_x = -22.0, .active = true, .kind = KIND_SEAHORSE}
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.enemy_count == 0, "a sea animal that swims out leaves") != 0 { return 1 }

    StartGame(4248, MODE_FISH)
    game.animal_timer = 999.0
    game.next_spawn_timer = 999.0
    game.player_stage = SEAHORSE_STAGE
    game.next_growth_threshold = GrowthThreshold(game.player_stage)
    game.enemy_count = 1
    game.enemies[0] = .{.x = game.player_x, .y = game.player_y, .stage = SEAHORSE_STAGE, .velocity_x = 20.0, .active = true,
        .kind = KIND_SEAHORSE}
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.score == SEAHORSE_STAGE * 10 && game.growth_progress == SEAHORSE_STAGE && game.frenzy == 1 &&
        game.enemy_count == 0, "a seahorse no bigger than the player is eaten like a fish") != 0 { return 1 }
    game.player_stage = 1
    game.enemy_count = 1
    game.player_y = cast(float32)SEA_BOTTOM - cast(float32)FishSize(game.player_stage) * .5
    game.enemies[0] = .{.x = game.player_x, .y = SandY(KIND_LOBSTER, cast(float32)FishSize(3)), .stage = 3,
        .velocity_x = 30.0, .active = true, .kind = KIND_LOBSTER}
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.lives == 1 && game.safe_timer > 0.0 && game.enemy_count == 1, "a bigger lobster bites") != 0 { return 1 }
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.lives == 1, "a lobster bite leaves a moment of safety") != 0 { return 1 }
    game.enemy_count = 0
    for kind: cast(s32)KIND_SEAHORSE..KIND_STARFISH { unused SpawnSeaAnimal(kind) }
    game.animal_timer = 0.0
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(SeaAnimalCount() == ANIMAL_MOST, "no sea animal joins a full roster") != 0 { return 1 }
    game.enemy_count = ENEMY_LIMIT
    if Expect(!SpawnSeaAnimal(KIND_STARFISH) && game.enemy_count == ENEMY_LIMIT, "sea animals respect the enemy limit") != 0 { return 1 }
    game.enemy_count = 0
    if Expect(!SpawnSeaAnimal(KIND_FISH) && !SpawnSeaAnimal(KIND_SHARK), "only sea animal kinds spawn as sea animals") != 0 { return 1 }

    StartGame(4249)
    game.lives = 99
    if Expect(!SpawnSeaAnimal(KIND_LOBSTER), "Amoeba mode has no sea animals") != 0 { return 1 }
    for step: 0..1199 { UpdateGame(.{}, 1.0 / 60.0) }
    amoebas_only := true
    for index: cast(s32)0..game.enemy_count - 1 {
        if game.enemies[index].kind != KIND_FISH || game.enemies[index].species != 0 { amoebas_only = false }
    }
    if Expect(amoebas_only && game.enemy_count > 0, "Amoeba mode keeps only amoebas") != 0 { return 1 }

    // Seahorses are never tiny: stage five at the least, up to two above the player.
    StartGame(4250, MODE_FISH)
    game.animal_timer = 999.0
    game.next_spawn_timer = 999.0
    for grown: 0..2 {
        game.player_stage = ifx grown == 0 then 1 else ifx grown == 1 then 6 else PLAYER_STAGE_LAST
        smallest: s32 = 99
        largest: s32 = 0
        for spawn: 0..79 {
            game.enemy_count = 0
            if Expect(SpawnSeaAnimal(KIND_SEAHORSE), "a seahorse spawns") != 0 { return 1 }
            horse := game.enemies[0]
            if horse.stage < smallest { smallest = horse.stage }
            if horse.stage > largest { largest = horse.stage }
            body_width: float32
            body_height: float32
            BodyHalf(KIND_SEAHORSE, horse.stage, *body_width, *body_height)
            if Expect(horse.y >= cast(float32)SEA_TOP + body_height && horse.y <= cast(float32)SEA_BOTTOM - body_height,
                "a seahorse spawns wholly in the water") != 0 { return 1 }
        }
        top_stage := game.player_stage + 2
        if top_stage > STAGE_LAST { top_stage = STAGE_LAST }
        if top_stage < SEAHORSE_STAGE { top_stage = SEAHORSE_STAGE }
        if Expect(smallest == SEAHORSE_STAGE && largest == top_stage, "seahorses range from stage five to two above the player") != 0 { return 1 }
    }
    horse_half_width: float32
    horse_half_height: float32
    BodyHalf(KIND_SEAHORSE, SEAHORSE_STAGE, *horse_half_width, *horse_half_height)
    if Expect(horse_half_height * 2.0 > cast(float32)FishSize(1) * 3.0 && horse_half_width < horse_half_height,
        "the smallest seahorse stands over three times a new fish's size, upright") != 0 { return 1 }
    // Its body is tall and narrow, as drawn.
    game.player_stage = 1
    game.lives = 9
    game.player_x = 250.0
    game.player_y = 200.0
    player_half := cast(float32)FishSize(1) * .5
    game.enemy_count = 1
    game.enemies[0] = .{.x = game.player_x + player_half + horse_half_width - 1.0, .y = game.player_y, .stage = SEAHORSE_STAGE,
        .velocity_x = 0.0, .active = true, .kind = KIND_SEAHORSE}
    SeaCollisions()
    if Expect(game.lives == 9, "brushing a seahorse's narrow side is harmless") != 0 { return 1 }
    game.enemies[0].x = game.player_x
    game.enemies[0].y = game.player_y + player_half + horse_half_height - COLLISION_INSET - 1.0
    SeaCollisions()
    if Expect(game.lives == 8 && game.enemy_count == 1, "a big seahorse's tall body bites a small fish") != 0 { return 1 }
    game.safe_timer = 0.0
    game.player_stage = SEAHORSE_STAGE - 1
    game.enemies[0].y = game.player_y
    SeaCollisions()
    if Expect(game.lives == 7 && game.enemy_count == 1, "a seahorse still bites until the player reaches its size") != 0 { return 1 }
    game.enemies[0].x = 100.0
    game.enemies[0].y = cast(float32)SEA_TOP
    game.enemies[0].velocity_x = 22.0
    game.player_x = 450.0
    for step: 0..239 {
        UpdateGame(.{}, 1.0 / 60.0)
        if game.enemy_count == 0 || game.enemies[0].kind != KIND_SEAHORSE { break }
        if Expect(game.enemies[0].y >= cast(float32)SEA_TOP + horse_half_height - .01 &&
            game.enemies[0].y <= cast(float32)SEA_BOTTOM - horse_half_height + .01, "a bobbing seahorse stays in the water") != 0 { return 1 }
    }

    // A big gentle sea turtle visits after about 35 seconds.
    StartGame(4251, MODE_FISH)
    game.enemy_count = 0
    game.lives = 99
    game.next_spawn_timer = 9999.0
    game.school_timer = 9999.0
    game.shark_timer = 9999.0
    game.pearl_timer = 9999.0
    game.jelly_timer = 9999.0
    game.animal_timer = 9999.0
    if Expect(game.turtle_timer == TURTLE_FIRST, "the turtle's first visit is scheduled") != 0 { return 1 }
    turtle_arrival := 0.0
    for step: 0..2399 {
        UpdateGame(.{}, 1.0 / 60.0)
        if KindCount(KIND_TURTLE) > 0 { turtle_arrival = game.elapsed; break }
    }
    if Expect(turtle_arrival > 34.9 && turtle_arrival < 35.1, "the first turtle arrives at about 35 seconds") != 0 { return 1 }
    if Expect(game.turtle_timer >= 45.0 && game.turtle_timer <= 65.0, "the next turtle is a rare 45 to 65 seconds away") != 0 { return 1 }
    if Expect(!SpawnTurtle() && KindCount(KIND_TURTLE) == 1, "only one turtle swims at once") != 0 { return 1 }
    game.turtle_timer = 0.0
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(KindCount(KIND_TURTLE) == 1, "no second turtle joins while one visits") != 0 { return 1 }
    turtle := 0
    while game.enemies[turtle].kind != KIND_TURTLE { turtle += 1 }
    visitor := game.enemies[turtle]
    if Expect(visitor.velocity_x == cast(float32)TURTLE_SPEED || visitor.velocity_x == -cast(float32)TURTLE_SPEED,
        "the turtle swims slowly across") != 0 { return 1 }
    if Expect(visitor.y >= cast(float32)SEA_TOP + cast(float32)TURTLE_HEIGHT * .5 &&
        visitor.y <= cast(float32)SEA_BOTTOM - cast(float32)TURTLE_HEIGHT * .5, "the turtle swims in open water") != 0 { return 1 }
    // Directions vary from visit to visit.
    leftward := 0
    rightward := 0
    for visit: 0..39 {
        game.enemy_count = 0
        unused SpawnTurtle()
        if game.enemies[0].velocity_x < 0.0 { leftward += 1 } else { rightward += 1 }
        if Expect(game.enemies[0].x < 0.0 || game.enemies[0].x > cast(float32)FIELD_WIDTH, "the turtle enters from an edge") != 0 { return 1 }
    }
    if Expect(leftward > 0 && rightward > 0, "turtles arrive from either edge") != 0 { return 1 }

    // It crosses with a mild bob, never bites, is never eaten, and leaves at
    // most five pearls behind it.
    game.enemy_count = 0
    unused SpawnTurtle()
    game.enemies[0].x = 60.0
    game.enemies[0].velocity_x = cast(float32)TURTLE_SPEED
    game.enemies[0].y = 200.0
    game.turtle_timer = 9999.0
    game.player_x = 30.0
    game.player_y = cast(float32)SEA_TOP + 10.0
    turtle_low: float32 = 999.0
    turtle_high: float32 = 0.0
    first_pearl := 0.0
    most_pearls := 0
    for step: 0..119 {
        UpdateGame(.{}, 1.0 / 60.0)
        if first_pearl == 0.0 && KindCount(KIND_PEARL) > 0 { first_pearl = cast(float64)(step + 1) / 60.0 }
        if game.enemies[0].y < turtle_low { turtle_low = game.enemies[0].y }
        if game.enemies[0].y > turtle_high { turtle_high = game.enemies[0].y }
    }
    moved := game.enemies[0].x - 60.0
    if Expect(moved > 45.0 && moved < 60.0, "the turtle glides slowly") != 0 { return 1 }
    if Expect(turtle_high - turtle_low > .5 && turtle_high - turtle_low < 12.0, "the turtle bobs gently") != 0 { return 1 }
    if Expect(first_pearl > 1.4 && first_pearl < 1.6, "the turtle drops a pearl after about 1.5 seconds") != 0 { return 1 }
    for step: 0..899 {
        UpdateGame(.{}, 1.0 / 60.0)
        if KindCount(KIND_PEARL) > most_pearls { most_pearls = KindCount(KIND_PEARL) }
        if KindCount(KIND_TURTLE) == 0 { break }
        if Expect(game.turtle_pearls <= TURTLE_PEARLS, "a turtle's trail is short") != 0 { return 1 }
    }
    if Expect(game.turtle_pearls == TURTLE_PEARLS && most_pearls <= TURTLE_PEARLS && most_pearls >= 2,
        "a visit leaves a trail of five pearls") != 0 { return 1 }
    game.enemy_count = 0
    unused SpawnTurtle()
    if Expect(game.turtle_pearls == 0 && game.turtle_drop == TURTLE_DROP, "each visit starts a fresh trail") != 0 { return 1 }
    game.enemies[0].x = game.player_x
    game.enemies[0].y = game.player_y
    for grown: 0..1 {
        game.player_stage = ifx grown == 0 then 1 else PLAYER_STAGE_LAST
        game.safe_timer = 0.0
        lives_before := game.lives
        score_before := game.score
        SeaCollisions()
        if Expect(game.lives == lives_before && game.score == score_before && KindCount(KIND_TURTLE) == 1,
            "the turtle neither bites nor is eaten, whatever the player's size") != 0 { return 1 }
    }
    unused SpawnShark()
    game.enemies[1].x = game.enemies[0].x
    game.enemies[1].y = game.enemies[0].y
    SharkFeeds()
    if Expect(KindCount(KIND_TURTLE) == 1, "the shark leaves the turtle alone") != 0 { return 1 }
    // A dropped pearl is collected like any other.
    game.enemy_count = 1
    if Expect(!SharkAlert(), "the turtle brings no shark music") != 0 { return 1 }
    game.enemies[0].x = 200.0
    game.turtle_drop = 0.0
    TurtleTrail(1.0 / 60.0)
    if Expect(game.enemy_count == 2 && game.enemies[1].kind == KIND_PEARL, "the turtle drops a pearl behind it") != 0 { return 1 }
    behind: bool = ifx game.enemies[0].velocity_x > 0.0 then game.enemies[1].x < game.enemies[0].x else game.enemies[1].x > game.enemies[0].x
    if Expect(behind, "the pearl falls behind the turtle") != 0 { return 1 }
    game.player_x = game.enemies[1].x
    game.player_y = game.enemies[1].y
    pearl_score := game.score
    growth := game.growth_progress
    game.player_stage = 1
    SeaCollisions()
    if Expect(game.score == pearl_score + PEARL_SCORE && game.growth_progress == growth + 2 && KindCount(KIND_PEARL) == 0,
        "a turtle's pearl is collected for score and growth") != 0 { return 1 }
    // No pearl drops when the water is full.
    game.turtle_drop = 0.0
    dropped := game.turtle_pearls
    game.enemy_count = ENEMY_LIMIT
    TurtleTrail(1.0 / 60.0)
    if Expect(game.enemy_count == ENEMY_LIMIT && game.turtle_pearls == dropped, "turtle pearls respect the enemy limit") != 0 { return 1 }
    if Expect(!SpawnTurtle(), "a turtle needs room to visit") != 0 { return 1 }
    // A turtle past the edge leaves.
    game.enemy_count = 1
    game.enemies[0].x = cast(float32)FIELD_WIDTH + cast(float32)TURTLE_WIDTH
    game.enemies[0].velocity_x = cast(float32)TURTLE_SPEED
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(KindCount(KIND_TURTLE) == 0, "a turtle that swims out leaves") != 0 { return 1 }

    StartGame(4252)
    game.lives = 99
    if Expect(!SpawnTurtle() && game.turtle_timer == 0.0, "Amoeba mode has no turtle") != 0 { return 1 }
    for step: 0..2699 { UpdateGame(.{}, 1.0 / 60.0) }
    if Expect(KindCount(KIND_TURTLE) == 0 && KindCount(KIND_PEARL) == 0, "no turtle visits the amoeba dish") != 0 { return 1 }

    StartGame(54321)
    game.enemies[0].warning_timer = 0.0
    game.enemies[0].active = false
    UpdateGame(.{}, 1.0 / 60.0)
    if Expect(game.enemies[0].active, "warning timer activates an enemy") != 0 { return 1 }

    StartGame(2468)
    game.enemy_count = 0
    game.event_count = 0
    game.next_spawn_timer = 0.0
    UpdateGame(.{}, .01)
    if Expect(game.event_count == 0, "spawning has no repeated background beat") != 0 { return 1 }
    print("Choano local tests passed.\n")
    return 0
}
