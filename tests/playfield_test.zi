#import "kryon/geometry"
#import "game"
#import "playfield"
#import "sprites"

Near :: (first: float32, second: float32) -> bool {
    delta := first - second
    return delta < .01 && delta > -.01
}

Expect :: (condition: bool, message: string) -> s32 {
    if condition { return 0 }
    print("choano playfield test failed: %\n", message)
    return 1
}

Inside :: (inner: Rectangle, outer: Rectangle) -> bool {
    return inner.x >= outer.x - .01 && inner.y >= outer.y - .01 &&
        inner.x + inner.width <= outer.x + outer.width + .01 &&
        inner.y + inner.height <= outer.y + outer.height + .01
}

WholeDish :: (bounds: Rectangle) -> s32 {
    field := FitPlayfield(bounds, MODE_AMOEBA)
    failures := Expect(bounds.height > bounds.width && field.framed,
        "portrait keeps its framed dish")
    failures += Expect(Inside(field.outer_frame, bounds) && Inside(field.inner_playable, bounds),
        "the whole dish stays inside the container")
    failures += Expect(Near(field.inner_playable.width, bounds.width - 24.0) &&
        Near(field.inner_playable.height, bounds.height - 24.0), "portrait uses the full safe dish")
    return failures
}

EdgesStayInside :: (bounds: Rectangle, stage: s32) -> bool {
    field := FitPlayfield(bounds, MODE_AMOEBA)
    SetDishFrame(field.dish_half_height, field.dish_corner_radius, field.framed)
    directions_x: [8]float32 = .[-5000.0, 5000.0, 0.0, 0.0, -5000.0, 5000.0, -5000.0, 5000.0]
    directions_y: [8]float32 = .[0.0, 0.0, -5000.0, 5000.0, -5000.0, -5000.0, 5000.0, 5000.0]
    size := cast(float32)StageSize(stage)
    for direction: 0..7 {
        x := directions_x[direction]
        y := directions_y[direction]
        unused ClampPoint(*x, *y, size)
        left := field.origin.x + (x - size * .325) * field.scale
        right := field.origin.x + (x + size * .325) * field.scale
        top := field.origin.y + (y - size * .325) * field.scale
        bottom := field.origin.y + (y + size * .325) * field.scale
        if left < bounds.x - .01 || right > bounds.x + bounds.width + .01 ||
            top < bounds.y - .01 || bottom > bounds.y + bounds.height + .01 { return false }
    }
    SetDishFrame(cast(float32)DISH_RADIUS, 0.0, false)
    return true
}

SpawnsDoNotOverlap :: () -> s32 {
    StartGame(918273645, MODE_AMOEBA)
    bounds := Rectangle.{0.0, 52.0, 720.0, 1508.0}
    field := FitPlayfield(bounds, MODE_AMOEBA)
    SetDishFrame(field.dish_half_height, field.dish_corner_radius, field.framed)
    game.player_stage = 9
    game.player_x = cast(float32)DISH_CENTER_X
    game.player_y = cast(float32)DISH_CENTER_Y
    game.enemy_count = 0
    placed := true
    for spawn: 0..11 {
        placed = placed && SpawnEnemy(9)
    }
    for first: cast(s32)0..game.enemy_count - 2 {
        for second: first + 1..game.enemy_count - 1 {
            one := game.enemies[first]
            two := game.enemies[second]
            clear := cast(float32)StageSize(9) * .65 + 6.0
            placed = placed && DistanceSquared(one.x, one.y, two.x, two.y) >= clear * clear - .01
        }
    }
    SetDishFrame(cast(float32)DISH_RADIUS, 0.0, false)
    return Expect(placed, "stage-nine spawns fit without overlapping")
}

FishSeaFills :: (bounds: Rectangle) -> s32 {
    field := FitPlayfield(bounds, MODE_FISH)
    failures := Expect(Near(field.view.x, bounds.x) && Near(field.view.y, bounds.y) &&
        Near(field.view.width, bounds.width) && Near(field.view.height, bounds.height),
        "Fish mode fills the complete play container")
    failures += Expect(Inside(field.view, bounds) && Inside(field.inner_playable, bounds),
        "Fish mode never maps art outside its container")
    SetSeaBounds(field.view.width / field.scale, field.view.height / field.scale)
    left: float32 = -5000.0
    right: float32 = 5000.0
    top: float32 = -5000.0
    bottom: float32 = 5000.0
    probe: float32 = 0.0
    unused SeaClamp(*left, *probe, 0.0)
    unused SeaClamp(*right, *probe, 0.0)
    unused SeaClamp(*probe, *top, 0.0)
    unused SeaClamp(*probe, *bottom, 0.0)
    failures += Expect(Near(left, 0.0) && Near(right, game.sea_width) &&
        Near(top, cast(float32)SEA_TOP) && Near(bottom, SeaBottom()),
        "the fitted Fish sea is playable from edge to edge")
    return failures
}

FishEdgesStayInside :: (bounds: Rectangle, stage: s32) -> bool {
    field := FitPlayfield(bounds, MODE_FISH)
    SetSeaBounds(field.view.width / field.scale, field.view.height / field.scale)
    directions_x: [8]float32 = .[-5000.0, 5000.0, 0.0, 0.0, -5000.0, 5000.0, -5000.0, 5000.0]
    directions_y: [8]float32 = .[0.0, 0.0, -5000.0, 5000.0, -5000.0, -5000.0, 5000.0, 5000.0]
    size := FishContainmentSize(stage)
    for direction: 0..7 {
        x := directions_x[direction]
        y := directions_y[direction]
        unused SeaClamp(*x, *y, size)
        left := field.view.x + (x - size * .5) * field.scale
        right := field.view.x + (x + size * .5) * field.scale
        top := field.view.y + (y - size * .5) * field.scale
        bottom := field.view.y + (y + size * .5) * field.scale
        if left < bounds.x - .01 || right > bounds.x + bounds.width + .01 ||
            top < bounds.y - .01 || bottom > bounds.y + bounds.height + .01 { return false }
    }
    return true
}

FishCuesAndColors :: () -> s32 {
    StartGame(918273645, MODE_FISH)
    failures := Expect(game.hint_timer == 0.0, "Fish starts without bypassing the one-time hint gate")
    for player_stage: STAGE_FIRST..PLAYER_STAGE_LAST {
        player := cast(s32)player_stage
        game.player_stage = player
        for stage: STAGE_FIRST..STAGE_LAST {
            enemy_stage := cast(s32)stage
            enemy := Enemy.{.kind = KIND_FISH, .stage = enemy_stage}
            expected := ifx enemy_stage <= player then CUE_FOOD else CUE_DANGER
            failures += Expect(CreatureCue(enemy) == expected, "fish cues follow the eating rule at every stage")
            for animal: KIND_SEAHORSE..KIND_STARFISH {
                enemy = Enemy.{.kind = cast(s32)animal, .stage = enemy_stage}
                failures += Expect(CreatureCue(enemy) == expected, "sea animal cues follow the eating rule")
            }
        }
    }
    game.player_stage = STAGE_FIRST
    failures += Expect(CreatureCue(Enemy.{.kind = KIND_SARDINE}) == CUE_FOOD, "sardines are edible")
    failures += Expect(CreatureCue(Enemy.{.kind = KIND_JELLY}) == CUE_DANGER, "jellyfish are dangerous")
    failures += Expect(CreatureCue(Enemy.{.kind = KIND_SHARK}) == CUE_DANGER, "sharks are dangerous")
    failures += Expect(CreatureCue(Enemy.{.kind = KIND_TURTLE}) == CUE_NONE, "turtles are neutral")
    failures += Expect(CreatureCue(Enemy.{.kind = KIND_PEARL}) == CUE_NONE, "pearls have no danger cue")

    return failures
}

FishSizesNormalize :: () -> s32 {
    failures: s32 = 0
    for shape: 0..FISH_SPECIES - 1 {
        source := FishSource(4 + cast(s32)shape)
        for stage: STAGE_FIRST..STAGE_LAST {
            visual_stage := cast(s32)stage
            width := FitWidth(source, FishVisualSize(visual_stage))
            height := width * source.height / source.width
            longest := ifx height > width then height else width
            failures += Expect(Near(longest, FishVisualSize(visual_stage)), "every fish shape normalizes to its stage size")
        }
    }
    for animal: 0..2 {
        source := AnimalSource(cast(s32)animal)
        for stage: STAGE_FIRST..STAGE_LAST {
            visual_stage := cast(s32)stage
            width := FitWidth(source, FishVisualSize(visual_stage))
            height := width * source.height / source.width
            longest := ifx height > width then height else width
            failures += Expect(Near(longest, FishVisualSize(visual_stage)), "every sea animal normalizes to its stage size")
        }
    }
    failures += Expect(FishSize(1) == 22 && FishSize(10) == 94, "fish sizes are about twice as large")
    return failures
}

main :: () -> s32 {
    failures: s32 = 0
    moto_portrait := Rectangle.{0.0, 52.0, 720.0, 1508.0}
    moto_landscape := Rectangle.{0.0, 52.0, 1560.0, 668.0}
    desktop := Rectangle.{0.0, 52.0, 900.0, 628.0}
    failures += WholeDish(moto_portrait)
    failures += WholeDish(Rectangle.{0.0, 104.0, 360.0, 1456.0})
    failures += WholeDish(Rectangle.{10.0, 52.0, 400.0, 500.0})

    all_bounds: [3]Rectangle = .[moto_portrait, moto_landscape, desktop]
    for bounds_index: 0..2 {
        bounds := all_bounds[bounds_index]
        field := FitPlayfield(bounds, MODE_AMOEBA)
        failures += Expect(Inside(field.inner_playable, bounds) && Inside(field.outer_frame, bounds),
            "every orientation keeps the complete dish visible")
        failures += Expect(EdgesStayInside(bounds, 1) && EdgesStayInside(bounds, 9),
            "stage one and stage nine sprites stay inside at every edge and corner")
    }

    moto := FitPlayfield(moto_portrait, MODE_AMOEBA)
    first_size := cast(float32)StageSize(1) * moto.scale
    failures += Expect(first_size > 35.0 && first_size < 45.0,
        "the Moto portrait player is comfortably larger without zooming")
    failures += SpawnsDoNotOverlap()

    for bounds_index: 0..2 {
        fish_bounds := all_bounds[bounds_index]
        failures += FishSeaFills(fish_bounds)
        failures += Expect(FishEdgesStayInside(fish_bounds, 1) && FishEdgesStayInside(fish_bounds, 9),
            "Fish sprites stay inside at every edge and corner")
    }
    failures += FishCuesAndColors()
    failures += FishSizesNormalize()
    fish_portrait := FitPlayfield(moto_portrait, MODE_FISH)
    fish_landscape := FitPlayfield(moto_landscape, MODE_FISH)
    failures += Expect(cast(float32)FishSize(1) * fish_portrait.scale > 28.0 &&
        cast(float32)FishSize(1) * fish_portrait.scale < 36.0,
        "the Moto portrait fish is visibly larger")
    failures += Expect(cast(float32)FishSize(1) * fish_landscape.scale > 32.0 &&
        cast(float32)FishSize(1) * fish_landscape.scale < 42.0,
        "the Moto landscape fish is visibly larger")

    fish_bounds := Rectangle.{0.0, 52.0, 900.0, 628.0}
    fish := FitPlayfield(fish_bounds, MODE_FISH)
    scale := fish_bounds.width / cast(float32)FIELD_WIDTH
    if fish_bounds.height / cast(float32)FIELD_HEIGHT < scale { scale = fish_bounds.height / cast(float32)FIELD_HEIGHT }
    failures += Expect(Near(fish.scale, scale) && !fish.framed, "Fish mode keeps its fitted sea")

    tiny: [5]Rectangle = .[.{0.0, 0.0, 0.0, 0.0}, .{5.0, 5.0, 10.0, 40.0}, .{0.0, 0.0, 24.0, 200.0},
        .{0.0, 0.0, -20.0, -40.0}, .{0.0, 0.0, 41.0, 400.0}]
    for index: 0..4 {
        field := FitPlayfield(tiny[index], MODE_AMOEBA)
        failures += Expect(field.scale >= 0.0 && field.scale == field.scale &&
            field.view.width >= 0.0 && field.view.height >= 0.0, "tiny areas stay finite")
    }

    if failures != 0 { return 1 }
    print("Choano local playfield tests passed.\n")
    return 0
}
