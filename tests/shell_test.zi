Shell :: #import "shell";
#import "kryon/geometry"

Expect :: (value: bool, name: string) -> bool {
    if !value { print("Choano shell local test failed: %\n", name) }
    return value
}

Inside :: (inner: Rectangle, outer: Rectangle) -> bool {
    return inner.x >= outer.x && inner.y >= outer.y &&
        inner.x + inner.width <= outer.x + outer.width &&
        inner.y + inner.height <= outer.y + outer.height
}

Clear :: (first: Rectangle, second: Rectangle) -> bool {
    return first.x + first.width <= second.x || second.x + second.width <= first.x ||
        first.y + first.height <= second.y || second.y + second.height <= first.y
}

Near :: (first: float32, second: float32, tolerance: float32 = 1.0) -> bool {
    return first >= second - tolerance && first <= second + tolerance
}

main :: () -> s32 {
    layouts: [4]Rectangle = .[.{0.0, 0.0, 720.0, 1560.0}, .{0.0, 0.0, 1560.0, 720.0},
        .{0.0, 0.0, 900.0, 628.0}, .{18.0, 28.0, 376.0, 800.0}]
    for bounds: layouts {
        settings := Shell.SettingsLayoutFor(bounds)
        if !Expect(Inside(settings.panel, bounds) && Inside(settings.swipe, settings.panel) &&
            Inside(settings.pad, settings.panel) && Inside(settings.sound_on, settings.panel) &&
            Inside(settings.sound_off, settings.panel) && Inside(settings.done, settings.panel) &&
            Clear(settings.swipe, settings.pad) && Clear(settings.pad, settings.sound_off) &&
            Clear(settings.sound_on, settings.done), "Settings choices fit without overlap") { return 1 }
        for resumable: 0..1 {
            layout := Shell.TitleLayoutFor(bounds, resumable == 1)
            backdrop := Shell.TitleBackdropBounds(bounds)
            logo := Shell.TitleLogoBounds(bounds)
            icon := Shell.WardrobeIconBounds(bounds)
            settings := Shell.SettingsIconBounds(bounds)
            if !Expect(Inside(settings, bounds) && settings.width >= 48.0 &&
                Clear(icon, settings) && icon.x < settings.x, "corner icons stay inside safe insets") { return 1 }
            if !Expect(backdrop.x == bounds.x && backdrop.y == bounds.y &&
                backdrop.width == bounds.width && backdrop.height == bounds.height,
                "title art covers the whole window") { return 1 }
            if !Expect(Inside(logo, bounds) && logo.y >= 52.0 &&
                logo.width <= bounds.width - 16.0,
                "the separate title logo scales without cropping") { return 1 }
            if !Expect(icon.width >= 48.0 && icon.height >= 48.0 && Inside(icon, bounds),
                "the wardrobe icon is a safe tappable target") { return 1 }
            if !Expect(layout.mode.y >= layout.character_safe.y + layout.character_safe.height,
                "title buttons do not cover the character safe zone") { return 1 }
            if !Expect(Inside(layout.mode, bounds) &&
                Inside(layout.play, bounds), "title buttons stay on screen") { return 1 }
            if resumable == 1 && !Inside(layout.continue_button, bounds) { return 2 }
            if !Expect(Clear(layout.mode, layout.character_safe) &&
                Clear(layout.play, layout.character_safe), "title controls avoid painted characters") { return 1 }
            if !Expect(layout.mode.width == 320.0 && layout.mode.height == 52.0 &&
                layout.play.height == 56.0,
                "title controls use fixed logical sizes and a taller Play button") { return 1 }
            if !Expect(layout.mode.x + layout.mode.width * .5 == bounds.x + bounds.width * .5,
                "the segmented control is centered") { return 1 }
            if !Expect(layout.play.width >= 220.0 && layout.play.width <= 320.0 &&
                Near(layout.play.y - layout.mode.y, ifx resumable == 1 then 132.0 else 68.0),
                "hugging title buttons clamp their widths and keep their gaps") { return 1 }
            if resumable == 1 {
                if !Expect(layout.continue_button.y == layout.mode.y + 64.0 &&
                    Near(layout.play.y - layout.continue_button.y, 68.0),
                    "resumable buttons keep fixed gaps") { return 1 }
            } else if !Expect(Near(layout.play.y - layout.mode.y, 68.0),
                "Play keeps its gap") { return 1 }
        }
    }
    compact := Shell.SettingsLayoutFor(Rectangle.{20.0, 16.0, 760.0, 320.0})
    if !Expect(Inside(compact.done, compact.panel) && Clear(compact.sound_off, compact.done) &&
        compact.swipe.height >= 44.0, "Settings fits a short landscape viewport") { return 1 }
    if !Expect(Shell.ButtonWidth("i") == 140.0 && Shell.ButtonWidth("Continue") >= 140.0 &&
        Shell.ButtonWidth("A very long button label that must stop stretching") == 320.0,
        "buttons hug labels and clamp between 140 and 320") { return 1 }
    if !Expect(Shell.ButtonRadius(44.0) == 22.0 && Shell.ButtonRadius(52.0) == 26.0 &&
        Shell.ButtonRadius(56.0) == 28.0, "buttons use true pill radii") { return 1 }
    if !Expect(Shell.ButtonContrast(Shell.BUTTON_NORMAL) >= 4.5 &&
        Shell.ButtonContrast(Shell.BUTTON_SELECTED) >= 4.5 &&
        Shell.ButtonContrast(Shell.BUTTON_PRIMARY) >= 4.5 &&
        Shell.ButtonContrast(Shell.BUTTON_DISABLED) >= 4.5,
        "all button states meet WCAG AA contrast") { return 1 }
    if !Expect(Near(Shell.IconScale(false, true), .92, .001) &&
        Near(Shell.IconScale(true, false), 1.08, .001) && Shell.IconScale(false, false) == 1.0,
        "image buttons shrink on press and grow on hover") { return 1 }
    Shell.fish_hint_pending = true
    Shell.run_fish = false
    if !Expect(!Shell.TakeFishHint() && Shell.fish_hint_pending,
        "the Fish hint waits through an Amoeba run") { return 1 }
    Shell.run_fish = true
    if !Expect(Shell.TakeFishHint() && !Shell.TakeFishHint(),
        "the Fish hint appears only on its first Fish run") { return 1 }
    Shell.fish_hint_pending = false
    Shell.run_fish = false
    print("Choano local shell layout tests passed.\n")
    return 0
}
